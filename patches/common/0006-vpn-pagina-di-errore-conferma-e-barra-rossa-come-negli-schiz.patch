+bool VpnTabHelper::OfferDirectReserve() {
+  const VpnStatus::Route route = VpnStatus::Get()->route();
+  if (!on_proxy_error_page_ || (route != VpnStatus::Route::kVpn &&
+                                route != VpnStatus::Route::kVpnDown)) {
+    return false;
+  }
+  ShowReserveDialog(web_contents());
+  return true;
+}

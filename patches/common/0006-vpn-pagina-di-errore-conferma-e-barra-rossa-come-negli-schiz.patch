     int32_t error_code) {
   const GURL& url = navigation_handle.GetURL();
+  // Our own proxy doesn't answer: the page of the sketches. A proxy of the system
+  // keeps the normal one.
+  if (error_code == net::ERR_PROXY_CONNECTION_FAILED &&
+      navigation_handle.IsInPrimaryMainFrame()) {
+    using Route = browser_fork::VpnStatus::Route;
+    const Route route = browser_fork::VpnStatus::Get()->route();
+    if (route == Route::kVpn || route == Route::kVpnDown) {
+      auto info = content::mojom::AlternativeErrorPageOverrideInfo::New();
+      info->resource_id = IDR_NET_ERROR_HTML;
+      base::DictValue& params = info->alternative_error_page_params;
+      params.Set(error_page::kOverrideErrorPage, base::Value(true));
+      params.Set("iconClass", "icon-vpn");
+      params.Set("errorCode", "");
+      params.SetByDottedPath("heading.msg", "Il server VPN non risponde");
+      params.SetByDottedPath(
+          "summary.msg",
+          "Per non mostrare l'IP di casa ai siti, il browser non passa da solo "
+          "alla connessione diretta.");
+      if (!navigation_handle.IsPost()) {
+        params.SetByDottedPath("reloadButton.msg", "Riprova");
+        params.SetByDottedPath("reloadButton.reloadUrl", url.spec());
+      }
+      params.SetByDottedPath("vpnDirectButton.msg",
+                             "Naviga diretto (riserva)");
+      return info;
+    }
+  }
   Profile* profile = Profile::FromBrowserContext(browser_context);
   if (enterprise_net::IsEnterpriseProxyErrorHandlingEnabled() && profile) {
     auto* error_service =

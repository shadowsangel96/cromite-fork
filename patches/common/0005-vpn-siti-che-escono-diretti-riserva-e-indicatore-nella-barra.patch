diff --git a/chrome/browser/fork/vpn_status.cc b/chrome/browser/fork/vpn_status.cc
new file mode 100644
index 0000000000000000000000000000000000000000..17bb3daf5dfd943a14a909a18c567f31e156b703
--- /dev/null
+++ b/chrome/browser/fork/vpn_status.cc
@@ -0,0 +1,189 @@
+#include "chrome/browser/fork/vpn_status.h"
+
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/time/time.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/net/system_network_context_manager.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+#include "components/proxy_config/pref_proxy_config_tracker_impl.h"
+#include "components/proxy_config/proxy_config_dictionary.h"
+#include "components/proxy_config/proxy_config_pref_names.h"
+#include "net/base/load_flags.h"
+#include "net/http/http_response_headers.h"
+#include "net/proxy_resolution/proxy_config.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/fetch_api.mojom-shared.h"
+#include "url/gurl.h"
+
+namespace browser_fork {
+
+namespace {
+
+constexpr base::TimeDelta kReserveLimit = base::Hours(24);
+constexpr base::TimeDelta kServerCheckInterval = base::Minutes(5);
+constexpr base::TimeDelta kServerCheckTimeout = base::Seconds(10);
+
+// The internal firewall of Cromite drops without a word any request whose tag
+// isn't in services/firewall/tools/rules.xml. This one asks the proxy about itself,
+// so it uses the tag that file allows for the proxy.
+constexpr net::NetworkTrafficAnnotationTag kServerCheckAnnotation =
+    net::DefineNetworkTrafficAnnotation("proxy_config_settings", R"(
+      semantics {
+        sender: "VPN reserve"
+        description: "Asks the user's own proxy whether it is up again."
+        trigger: "Every few minutes during the direct reserve."
+        data: "None."
+        destination: OTHER
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "It stops when the reserve ends."
+        policy_exception_justification: "Not implemented."
+      })");
+
+// The proxy the user set, whatever the reserve is doing: an empty string if
+// there is none.
+std::string ProxyServerFromPrefs() {
+  ProxyConfigDictionary dict(
+      g_browser_process->local_state()
+          ->GetDict(proxy_config::prefs::kProxy)
+          .Clone());
+  ProxyPrefs::ProxyMode mode;
+  std::string server;
+  if (!dict.GetMode(&mode) || mode != ProxyPrefs::MODE_FIXED_SERVERS ||
+      !dict.GetProxyServer(&server)) {
+    return std::string();
+  }
+  return server;
+}
+
+}  // namespace
+
+// static
+VpnStatus* VpnStatus::Get() {
+  static base::NoDestructor<VpnStatus> instance;
+  return instance.get();
+}
+
+// static
+void VpnStatus::RegisterProfilePrefs(
+    user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterStringPref(kVpnAddressPref, std::string());
+  registry->RegisterListPref(kVpnDirectSitesPref);
+  registry->RegisterStringPref(kVpnExitCityPref, std::string());
+}
+
+VpnStatus::VpnStatus() = default;
+VpnStatus::~VpnStatus() = default;
+
+VpnStatus::Route VpnStatus::route() const {
+  if (direct_reserve_) {
+    return Route::kDirectReserve;
+  }
+  if (ProxyServerFromPrefs().empty()) {
+    return Route::kNormal;
+  }
+  return proxy_down_ ? Route::kVpnDown : Route::kVpn;
+}
+
+void VpnStatus::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void VpnStatus::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void VpnStatus::ReportProxyDown() {
+  if (!proxy_down_) {
+    proxy_down_ = true;
+    NotifyRouteChanged();
+  }
+}
+
+void VpnStatus::ReportPageLoaded() {
+  if (proxy_down_) {
+    proxy_down_ = false;
+    NotifyRouteChanged();
+  }
+}
+
+void VpnStatus::SettingsChanged() {
+  proxy_down_ = false;
+  NotifyRouteChanged();
+}
+
+void VpnStatus::StartDirectReserve() {
+  if (direct_reserve_) {
+    return;
+  }
+  direct_reserve_ = true;
+  proxy_down_ = false;
+  PrefProxyConfigTrackerImpl::SetDirectReserve(true);
+  reserve_expiry_.Start(FROM_HERE, kReserveLimit,
+                        base::BindOnce(&VpnStatus::EndDirectReserve,
+                                       base::Unretained(this)));
+  server_check_.Start(FROM_HERE, kServerCheckInterval,
+                      base::BindRepeating(&VpnStatus::CheckServer,
+                                          base::Unretained(this)));
+  NotifyRouteChanged();
+}
+
+void VpnStatus::EndDirectReserve() {
+  if (!direct_reserve_) {
+    return;
+  }
+  direct_reserve_ = false;
+  reserve_expiry_.Stop();
+  server_check_.Stop();
+  check_loader_.reset();
+  PrefProxyConfigTrackerImpl::SetDirectReserve(false);
+  NotifyRouteChanged();
+}
+
+void VpnStatus::NotifyRouteChanged() {
+  observers_.Notify(&Observer::OnRouteChanged);
+}
+
+void VpnStatus::CheckServer() {
+  net::ProxyConfig::ProxyRules rules;
+  rules.ParseFromString(ProxyServerFromPrefs());
+  if (rules.single_proxies.IsEmpty() ||
+      rules.single_proxies.First().is_direct()) {
+    EndDirectReserve();
+    return;
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(
+      "http://" +
+      rules.single_proxies.First().First().host_port_pair().ToString() + "/");
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE | net::LOAD_BYPASS_CACHE;
+  check_loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                                   kServerCheckAnnotation);
+  check_loader_->SetAllowHttpErrorResults(true);
+  check_loader_->SetTimeoutDuration(kServerCheckTimeout);
+  // During the reserve this goes out directly, so it reaches the proxy itself:
+  // whatever it answers, it's up.
+  check_loader_->DownloadHeadersOnly(
+      g_browser_process->system_network_context_manager()
+          ->GetURLLoaderFactory(),
+      base::BindOnce(&VpnStatus::OnServerChecked, base::Unretained(this)));
+}
+
+void VpnStatus::OnServerChecked(
+    scoped_refptr<net::HttpResponseHeaders> headers) {
+  check_loader_.reset();
+  if (headers && direct_reserve_) {
+    EndDirectReserve();
+    observers_.Notify(&Observer::OnBackToVpn);
+  }
+}
+
+}  // namespace browser_fork
diff --git a/chrome/browser/fork/vpn_status.h b/chrome/browser/fork/vpn_status.h
new file mode 100644
index 0000000000000000000000000000000000000000..6a6d7d65aad7cd30e21d940966a51e4cc1517aa4
--- /dev/null
+++ b/chrome/browser/fork/vpn_status.h
@@ -0,0 +1,93 @@
+#ifndef CHROME_BROWSER_FORK_VPN_STATUS_H_
+#define CHROME_BROWSER_FORK_VPN_STATUS_H_
+
+#include <memory>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/no_destructor.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/timer/timer.h"
+
+namespace net {
+class HttpResponseHeaders;
+}  // namespace net
+
+namespace network {
+class SimpleURLLoader;
+}  // namespace network
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}  // namespace user_prefs
+
+namespace browser_fork {
+
+// What the page chrome://proxy remembers when the VPN is off.
+inline constexpr char kVpnAddressPref[] = "fork.vpn_address";
+inline constexpr char kVpnDirectSitesPref[] = "fork.vpn_direct_sites";
+// The name of the place the VPN goes out from, shown next to it: only the user
+// knows it, the browser doesn't ask anyone.
+inline constexpr char kVpnExitCityPref[] = "fork.vpn_exit_city";
+
+// Where the browser goes out from, and the reserve for when the server of the
+// VPN is down: a direct connection the user asks for, which ends by itself. It
+// lives in memory, so it also ends with the browser, even after a crash.
+class VpnStatus {
+ public:
+  enum class Route {
+    kNormal,         // No VPN set.
+    kVpn,            // Through the VPN.
+    kVpnDown,        // The VPN is set, the last page found it down.
+    kDirectReserve,  // Without the VPN, for now.
+  };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnRouteChanged() {}
+    // The server answers again and the reserve ended without the user.
+    virtual void OnBackToVpn() {}
+  };
+
+  static VpnStatus* Get();
+  static void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+  VpnStatus(const VpnStatus&) = delete;
+  VpnStatus& operator=(const VpnStatus&) = delete;
+
+  Route route() const;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // What the tabs see: a page that found the proxy down, a page that loaded.
+  void ReportProxyDown();
+  void ReportPageLoaded();
+
+  // The address of the proxy may have changed.
+  void SettingsChanged();
+
+  void StartDirectReserve();
+  void EndDirectReserve();
+
+ private:
+  friend class base::NoDestructor<VpnStatus>;
+
+  VpnStatus();
+  ~VpnStatus();
+
+  void NotifyRouteChanged();
+  void CheckServer();
+  void OnServerChecked(scoped_refptr<net::HttpResponseHeaders> headers);
+
+  bool proxy_down_ = false;
+  bool direct_reserve_ = false;
+  base::OneShotTimer reserve_expiry_;
+  base::RepeatingTimer server_check_;
+  std::unique_ptr<network::SimpleURLLoader> check_loader_;
+  base::ObserverList<Observer> observers_;
+};
+
+}  // namespace browser_fork
+
+#endif  // CHROME_BROWSER_FORK_VPN_STATUS_H_
diff --git a/chrome/browser/fork/vpn_tab_helper.cc b/chrome/browser/fork/vpn_tab_helper.cc
new file mode 100644
index 0000000000000000000000000000000000000000..a489db2a35c3ec8362039d86510853eb4490df51
--- /dev/null
+++ b/chrome/browser/fork/vpn_tab_helper.cc
@@ -0,0 +1,232 @@
+#include "chrome/browser/fork/vpn_tab_helper.h"
+
+#include <memory>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "chrome/browser/infobars/confirm_infobar_creator.h"
+#include "components/infobars/content/content_infobar_manager.h"
+#include "components/infobars/core/confirm_infobar_delegate.h"
+#include "components/infobars/core/infobar.h"
+#include "components/infobars/core/simple_alert_infobar_delegate.h"
+#include "components/vector_icons/vector_icons.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/net_errors.h"
+#include "ui/gfx/vector_icon_types.h"
+#include "url/gurl.h"
+
+namespace browser_fork {
+
+namespace {
+
+// The infobar identifiers only serve metrics, which we don't have.
+constexpr infobars::InfoBarDelegate::InfoBarIdentifier kInfoBarId =
+    infobars::InfoBarDelegate::TEST_INFOBAR;
+
+// The network service gets the new route on its own pipe: without a moment the
+// reload could still go the old way.
+constexpr base::TimeDelta kReloadDelay = base::Milliseconds(500);
+
+void ReloadSoon(content::WebContents* web_contents) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<content::WebContents> contents) {
+            if (contents) {
+              contents->GetController().Reload(content::ReloadType::NORMAL,
+                                               /*check_for_repost=*/true);
+            }
+          },
+          web_contents->GetWeakPtr()),
+      kReloadDelay);
+}
+
+// Asks before the reserve starts: this is the only way into it.
+class ConfirmReserveInfoBarDelegate : public ConfirmInfoBarDelegate {
+ public:
+  ConfirmReserveInfoBarDelegate() = default;
+
+ private:
+  // ConfirmInfoBarDelegate:
+  infobars::InfoBarDelegate::InfoBarIdentifier GetIdentifier() const override {
+    return kInfoBarId;
+  }
+  const gfx::VectorIcon& GetVectorIcon() const override {
+    return vector_icons::kWarningIcon;
+  }
+  std::u16string GetMessageText() const override {
+    return u"Navigare senza VPN? I siti vedranno l'IP di casa. La modalità "
+           u"diretta scade alla chiusura del browser o dopo 24 ore.";
+  }
+  std::u16string GetButtonLabel(InfoBarButton button) const override {
+    return button == BUTTON_OK ? u"Naviga diretto" : u"Annulla";
+  }
+  bool Accept() override {
+    content::WebContents* contents =
+        infobars::ContentInfoBarManager::WebContentsFromInfoBar(infobar());
+    // Not from here: the bars of the tabs change, this one included.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce([] {
+          VpnStatus::Get()->StartDirectReserve();
+        }));
+    ReloadSoon(contents);
+    return true;
+  }
+};
+
+// Shows up when a page finds the proxy down, and only then.
+class ProxyDownInfoBarDelegate : public ConfirmInfoBarDelegate {
+ public:
+  ProxyDownInfoBarDelegate() = default;
+
+ private:
+  // ConfirmInfoBarDelegate:
+  infobars::InfoBarDelegate::InfoBarIdentifier GetIdentifier() const override {
+    return kInfoBarId;
+  }
+  const gfx::VectorIcon& GetVectorIcon() const override {
+    return vector_icons::kWarningIcon;
+  }
+  std::u16string GetMessageText() const override {
+    return u"Il server VPN non risponde. Per non mostrare l'IP di casa ai "
+           u"siti, il browser non passa da solo alla connessione diretta.";
+  }
+  std::u16string GetButtonLabel(InfoBarButton button) const override {
+    return button == BUTTON_OK ? u"Riprova" : u"Naviga diretto (riserva)";
+  }
+  bool Accept() override {
+    infobars::ContentInfoBarManager::WebContentsFromInfoBar(infobar())
+        ->GetController()
+        .Reload(content::ReloadType::NORMAL, /*check_for_repost=*/true);
+    return true;
+  }
+  bool Cancel() override {
+    infobar()->owner()->AddInfoBar(
+        CreateConfirmInfoBar(std::make_unique<ConfirmReserveInfoBarDelegate>()));
+    return true;
+  }
+};
+
+}  // namespace
+
+// Stays on the tab for as long as the reserve is on.
+class DirectReserveInfoBarDelegate : public ConfirmInfoBarDelegate {
+ public:
+  DirectReserveInfoBarDelegate() = default;
+
+  base::WeakPtr<DirectReserveInfoBarDelegate> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+  void Remove() { infobar()->RemoveSelf(); }
+
+ private:
+  // ConfirmInfoBarDelegate:
+  infobars::InfoBarDelegate::InfoBarIdentifier GetIdentifier() const override {
+    return kInfoBarId;
+  }
+  const gfx::VectorIcon& GetVectorIcon() const override {
+    return vector_icons::kWarningIcon;
+  }
+  bool ShouldExpire(const NavigationDetails& details) const override {
+    return false;
+  }
+  bool IsCloseable() const override { return false; }
+  std::u16string GetMessageText() const override {
+    return u"Connessione diretta. I siti vedono l'IP di casa.";
+  }
+  int GetButtons() const override { return BUTTON_OK; }
+  std::u16string GetButtonLabel(InfoBarButton button) const override {
+    return u"Torna alla VPN";
+  }
+  bool Accept() override {
+    content::WebContents* contents =
+        infobars::ContentInfoBarManager::WebContentsFromInfoBar(infobar());
+    // Not from here: VpnTabHelper removes this bar when the reserve ends.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce([] { VpnStatus::Get()->EndDirectReserve(); }));
+    ReloadSoon(contents);
+    return false;
+  }
+
+  base::WeakPtrFactory<DirectReserveInfoBarDelegate> weak_factory_{this};
+};
+
+VpnTabHelper::VpnTabHelper(content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<VpnTabHelper>(*web_contents) {
+  VpnStatus::Get()->AddObserver(this);
+}
+
+VpnTabHelper::~VpnTabHelper() {
+  VpnStatus::Get()->RemoveObserver(this);
+}
+
+void VpnTabHelper::DidFinishNavigation(content::NavigationHandle* handle) {
+  if (!handle->IsInPrimaryMainFrame() || handle->IsSameDocument() ||
+      !handle->HasCommitted()) {
+    return;
+  }
+  UpdateReserveBar();
+  if (handle->GetNetErrorCode() == net::ERR_PROXY_CONNECTION_FAILED) {
+    VpnStatus::Get()->ReportProxyDown();
+    auto* manager =
+        infobars::ContentInfoBarManager::FromWebContents(web_contents());
+    if (manager && VpnStatus::Get()->route() == VpnStatus::Route::kVpnDown) {
+      manager->AddInfoBar(
+          CreateConfirmInfoBar(std::make_unique<ProxyDownInfoBarDelegate>()));
+    }
+  } else if (handle->GetNetErrorCode() == net::OK &&
+             handle->GetURL().SchemeIsHTTPOrHTTPS()) {
+    VpnStatus::Get()->ReportPageLoaded();
+  }
+}
+
+void VpnTabHelper::OnRouteChanged() {
+  UpdateReserveBar();
+}
+
+void VpnTabHelper::OnBackToVpn() {
+  auto* manager =
+      infobars::ContentInfoBarManager::FromWebContents(web_contents());
+  if (manager &&
+      web_contents()->GetVisibility() == content::Visibility::VISIBLE) {
+    manager->AddInfoBar(
+        CreateConfirmInfoBar(std::make_unique<SimpleAlertInfoBarDelegate>(
+            kInfoBarId, &vector_icons::kInfoIcon,
+            u"Il server VPN risponde di nuovo: il browser è tornato a uscire "
+            u"dalla VPN.",
+            /*auto_expire=*/true, /*should_animate=*/true)));
+  }
+}
+
+void VpnTabHelper::UpdateReserveBar() {
+  const bool on =
+      VpnStatus::Get()->route() == VpnStatus::Route::kDirectReserve;
+  if (!on) {
+    if (reserve_bar_) {
+      reserve_bar_->Remove();
+    }
+    return;
+  }
+  auto* manager =
+      infobars::ContentInfoBarManager::FromWebContents(web_contents());
+  if (reserve_bar_ || !manager) {
+    return;
+  }
+  auto delegate = std::make_unique<DirectReserveInfoBarDelegate>();
+  base::WeakPtr<DirectReserveInfoBarDelegate> weak = delegate->GetWeakPtr();
+  if (manager->AddInfoBar(CreateConfirmInfoBar(std::move(delegate)))) {
+    reserve_bar_ = weak;
+  }
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(VpnTabHelper);
+
+}  // namespace browser_fork

+#ifndef CHROME_BROWSER_FORK_VPN_TAB_HELPER_H_
+#define CHROME_BROWSER_FORK_VPN_TAB_HELPER_H_
+
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/fork/vpn_status.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace browser_fork {
+
+class DirectReserveInfoBarDelegate;
+
+// The bars about the VPN in a tab: the offer of the reserve when a page finds the
+// server down, the warning while the reserve is on.
+class VpnTabHelper : public content::WebContentsObserver,
+                     public content::WebContentsUserData<VpnTabHelper>,
+                     public VpnStatus::Observer {
+ public:
+  ~VpnTabHelper() override;
+
+ private:
+  friend class content::WebContentsUserData<VpnTabHelper>;
+
+  explicit VpnTabHelper(content::WebContents* web_contents);
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override;
+
+  // VpnStatus::Observer:
+  void OnRouteChanged() override;
+  void OnBackToVpn() override;
+
+  void UpdateReserveBar();
+
+  base::WeakPtr<DirectReserveInfoBarDelegate> reserve_bar_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace browser_fork
+
+#endif  // CHROME_BROWSER_FORK_VPN_TAB_HELPER_H_

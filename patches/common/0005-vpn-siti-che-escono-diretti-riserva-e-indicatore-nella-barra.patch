+#include "ui/gfx/font.h"
+#include "ui/gfx/font_list.h"
+#include "ui/views/controls/label.h"
+#include "url/gurl.h"
+
+namespace {
+
+using Route = browser_fork::VpnStatus::Route;
+
+// The colors of the sketches, on a light and on a dark toolbar.
+SkColor PillColor(Route route, bool dark) {
+  switch (route) {
+    case Route::kNormal:
+      return dark ? SkColorSetRGB(0xAE, 0xAE, 0xB2)
+                  : SkColorSetRGB(0x6E, 0x6E, 0x73);
+    case Route::kVpn:
+      return dark ? SkColorSetRGB(0x4C, 0xD2, 0x7F)
+                  : SkColorSetRGB(0x15, 0x70, 0x38);
+    case Route::kVpnDown:
+      return dark ? SkColorSetRGB(0xFF, 0xAD, 0x33)
+                  : SkColorSetRGB(0x9A, 0x4F, 0x00);
+    case Route::kDirectReserve:
+      return SkColorSetRGB(0xC4, 0x00, 0x1A);
+  }
+}
+
+}  // namespace
+
+VpnStatusButton::VpnStatusButton(BrowserWindowInterface* browser)
+    : browser_(browser) {
+  SetCallback(base::BindRepeating(&VpnStatusButton::OnPressed,
+                                  base::Unretained(this)));
+  label()->SetFontList(
+      label()->font_list().DeriveWithWeight(gfx::Font::Weight::SEMIBOLD));
+  browser_fork::VpnStatus::Get()->AddObserver(this);
+  proxy_pref_.Init(g_browser_process->local_state());
+  proxy_pref_.Add(proxy_config::prefs::kProxy,
+                  base::BindRepeating(&VpnStatusButton::OnRouteChanged,
+                                      base::Unretained(this)));
+}
+
+VpnStatusButton::~VpnStatusButton() {
+  browser_fork::VpnStatus::Get()->RemoveObserver(this);
+}
+
+void VpnStatusButton::OnThemeChanged() {
+  ToolbarButton::OnThemeChanged();
+  OnRouteChanged();
+}
+
+bool VpnStatusButton::ShouldBlendHighlightColor() const {
+  return browser_fork::VpnStatus::Get()->route() != Route::kDirectReserve;
+}
+
+std::optional<SkColor> VpnStatusButton::GetHighlightTextColor() const {
+  if (browser_fork::VpnStatus::Get()->route() == Route::kDirectReserve) {
+    return SK_ColorWHITE;
+  }
+  return std::nullopt;
+}
+
+std::optional<SkColor> VpnStatusButton::GetHighlightBorderColor() const {
+  // The pill of the sketches has no border.
+  return GetBackgroundColor();
+}
+
+void VpnStatusButton::OnRouteChanged() {
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  const Route route = browser_fork::VpnStatus::Get()->route();
+  std::u16string label;
+  switch (route) {
+    case Route::kNormal:
+      label = u"● VPN spenta";
+      SetTooltipText(u"VPN spenta: esci dalla connessione normale.");
+      break;
+    case Route::kVpn: {
+      label = u"● VPN";
+      const std::string city = browser_->GetProfile()->GetPrefs()->GetString(
+          browser_fork::kVpnExitCityPref);
+      if (!city.empty()) {
+        label += u" · " + base::UTF8ToUTF16(city);
+      }
+      SetTooltipText(u"Esci dalla VPN del tuo server.");
+      break;
+    }
+    case Route::kVpnDown:
+      label = u"● VPN non raggiungibile";
+      SetTooltipText(
+          u"Il server VPN non risponde: nessuna pagina esce diretta.");
+      break;
+    case Route::kDirectReserve:
+      label = u"● Diretto · IP visibile";
+      SetTooltipText(u"Connessione diretta: i siti vedono l'IP di casa.");
+      break;
+  }
+  SetHighlight(label, PillColor(route, color_utils::IsDark(colors->GetColor(
+                                           kColorToolbar))));
+}
+
+void VpnStatusButton::OnPressed() {
+  ShowSingletonTab(browser_, GURL("chrome://proxy"));
+}
+
+BEGIN_METADATA(VpnStatusButton)
+END_METADATA

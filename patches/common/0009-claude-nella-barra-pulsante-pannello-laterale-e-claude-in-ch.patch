+// Without this the login would not survive the temporary cookies.
+void RememberClaudeSite(Profile* profile) {
+  ScopedListPrefUpdate update(profile->GetPrefs(), kRememberedSitesPref);
+  for (const base::Value& entry : *update) {
+    if (entry.is_string() && entry.GetString() == kClaudeSite) {
+      return;
+    }
+  }
+  update->Append(kClaudeSite);
+}
+
+const extensions::Extension* GetClaudeExtension(Profile* profile) {
+  return extensions::ExtensionRegistry::Get(profile)
+      ->enabled_extensions()
+      .GetByID(kClaudeExtensionId);
+}
+
+// "Questa pagina": the extension opens its own panel as if its icon was clicked.
+bool ShowPageView(BrowserWindowInterface* browser) {
+  const extensions::Extension* extension =
+      GetClaudeExtension(browser->GetProfile());
+  tabs::TabInterface* tab = browser->GetActiveTabInterface();
+  auto* runner = tab ? extensions::ExtensionActionRunner::GetForWebContents(
+                           tab->GetContents())
+                     : nullptr;
+  if (!extension || !runner) {
+    return false;
+  }
+  runner->RunAction(extension, /*grant_tab_permissions=*/true);
+  return true;
+}
+
+void ShowChatsView(BrowserWindowInterface* browser) {
+  browser->GetFeatures().side_panel_ui()->Show(ChatsKey());
+}

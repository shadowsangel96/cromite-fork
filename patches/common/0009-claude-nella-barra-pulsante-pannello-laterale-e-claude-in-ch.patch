diff --git a/chrome/browser/resources/profilo_panel.js b/chrome/browser/resources/profilo_panel.js
new file mode 100644
index 0000000000000000000000000000000000000000..6e35df5ac307559403d546247f7c5e8d75e0b883
--- /dev/null
+++ b/chrome/browser/resources/profilo_panel.js
@@ -0,0 +1,29 @@
+window.ProfiloPanel = (function() {
+  'use strict';
+
+  const $ = (id) => document.getElementById(id);
+
+  function loaded(signedIn) {
+    $('out').hidden = signedIn;
+    $('in').hidden = !signedIn;
+    $('actions').hidden = !signedIn;
+  }
+
+  document.addEventListener('DOMContentLoaded', () => {
+    $('login').onclick = () => chrome.send('openChats');
+    $('chats').onclick = () => chrome.send('openChats');
+    $('logout').onclick = () => chrome.send('logout');
+    $('others').onclick = () => chrome.send('otherProfiles');
+    chrome.send('ready');
+  });
+
+  // Il pannello resta in memoria per qualche secondo: riaprendolo la pagina non si
+  // ricarica, e nel frattempo l'accesso può essere cambiato.
+  document.addEventListener('visibilitychange', () => {
+    if (document.visibilityState === 'visible') {
+      chrome.send('ready');
+    }
+  });
+
+  return {loaded};
+})();

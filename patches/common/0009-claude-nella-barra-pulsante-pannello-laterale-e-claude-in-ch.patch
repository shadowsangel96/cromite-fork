+
+void ToggleClaudePanel(BrowserWindowInterface* browser) {
+  SidePanelUI* side_panel = browser->GetFeatures().side_panel_ui();
+  if (side_panel->IsSidePanelEntryShowing(ChatsKey()) ||
+      side_panel->IsSidePanelEntryShowing(PageKey())) {
+    side_panel->Close();
+    return;
+  }
+  RememberClaudeSite(browser->GetProfile());
+  if (!ShowPageView(browser)) {
+    ShowChatsView(browser);
+  }
+}

+class SegmentButton : public views::Button {
+  METADATA_HEADER(SegmentButton, views::Button)
+
+ public:
+  SegmentButton(const std::u16string& text,
+                bool selected,
+                PressedCallback callback)
+      : views::Button(std::move(callback)), text_(text), selected_(selected) {
+    GetViewAccessibility().SetName(text_);
+  }
+
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(100, 30);
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const bool dark = IsDark(this);
+    if (selected_) {
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setColor(dark ? SkColorSetA(SK_ColorWHITE, 41) : SK_ColorWHITE);
+      canvas->DrawRoundRect(GetLocalBounds(), 9, flags);
+    }
+    gfx::FontList font = gfx::FontList().DeriveWithSizeDelta(
+        13 - gfx::FontList().GetFontSize());
+    if (selected_) {
+      font = font.DeriveWithWeight(gfx::Font::Weight::SEMIBOLD);
+    }
+    canvas->DrawStringRectWithFlags(
+        text_, font, dark ? SkColorSetRGB(245, 245, 247) : SkColorSetRGB(29, 29, 31),
+        GetLocalBounds(), gfx::Canvas::TEXT_ALIGN_CENTER);
+  }
+
+ private:
+  const std::u16string text_;
+  const bool selected_;
+};

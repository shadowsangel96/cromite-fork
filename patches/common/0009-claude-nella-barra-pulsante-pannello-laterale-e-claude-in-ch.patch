+ProfiloPanelController::ProfiloPanelController(BrowserWindowInterface* browser)
+    : browser_(browser) {}
+
+ProfiloPanelController::~ProfiloPanelController() = default;
+
+void ProfiloPanelController::Toggle(views::View* anchor) {
+  // The click that lands here has already closed the open panel.
+  if (base::TimeTicks::Now() - closed_at_ < base::Milliseconds(400)) {
+    return;
+  }
+  if (!manager_) {
+    manager_ = WebUIBubbleManager::Create<ProfiloPanelUI>(
+        browser_.get(), GURL(chrome::kChromeUIProfiloPanelURL),
+        IDS_TOOLTIP_LOCATION_ICON);
+  }
+  if (manager_->GetBubbleWidget()) {
+    manager_->CloseBubble();
+    return;
+  }
+  // Where the boards put it: 40 dp below the top of the button, 70 dp past its
+  // right edge, over the buttons that follow.
+  const gfx::Rect button = anchor->GetBoundsInScreen();
+  manager_->ShowBubble(gfx::Rect(button.right() + 69, button.y(), 1, 40),
+                       views::BubbleBorder::TOP_RIGHT);
+  if (views::Widget* widget = manager_->GetBubbleWidget()) {
+    observation_.Observe(widget);
+  }
+}
+
+void ProfiloPanelController::OnWidgetDestroying(views::Widget* widget) {
+  observation_.Reset();
+  closed_at_ = base::TimeTicks::Now();
+}

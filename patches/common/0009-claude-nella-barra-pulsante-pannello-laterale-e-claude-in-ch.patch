+class AsteriskSource : public gfx::CanvasImageSource {
+ public:
+  AsteriskSource(int size, SkColor color)
+      : gfx::CanvasImageSource(gfx::Size(size, size)),
+        size_(size),
+        color_(color) {}
+
+  void Draw(gfx::Canvas* canvas) override {
+    const float unit = size_ / 16.f;
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(color_);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+    flags.setStrokeWidth(1.9f * unit);
+    const auto line = [&](float x1, float y1, float x2, float y2) {
+      canvas->sk_canvas()->drawLine(x1 * unit, y1 * unit, x2 * unit, y2 * unit,
+                                    flags);
+    };
+    line(8, 1.6, 8, 14.4);
+    line(1.6, 8, 14.4, 8);
+    line(3.5, 3.5, 12.5, 12.5);
+    line(12.5, 3.5, 3.5, 12.5);
+  }
+
+ private:
+  const int size_;
+  const SkColor color_;
+};

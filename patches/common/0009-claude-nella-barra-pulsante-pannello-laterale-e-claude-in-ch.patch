+#include "url/gurl.h"
+
+namespace {
+
+class ProfiloPanelHandler : public content::WebUIMessageHandler {
+ public:
+  ProfiloPanelHandler() = default;
+  ProfiloPanelHandler(const ProfiloPanelHandler&) = delete;
+  ProfiloPanelHandler& operator=(const ProfiloPanelHandler&) = delete;
+  ~ProfiloPanelHandler() override = default;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    const auto add = [this](const char* name,
+                            void (ProfiloPanelHandler::*method)(
+                                const base::ListValue&)) {
+      web_ui()->RegisterMessageCallback(
+          name, base::BindRepeating(method, base::Unretained(this)));
+    };
+    add("ready", &ProfiloPanelHandler::OnReady);
+    add("close", &ProfiloPanelHandler::OnClose);
+    add("openChats", &ProfiloPanelHandler::OnOpenChats);
+    add("logout", &ProfiloPanelHandler::OnLogout);
+    add("otherProfiles", &ProfiloPanelHandler::OnOtherProfiles);
+  }
+
+ private:
+  BrowserWindowInterface* GetBrowser() {
+    return webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  }
+
+  void Close() {
+    if (auto embedder =
+            web_ui()->GetController()->GetAs<ProfiloPanelUI>()->embedder()) {
+      embedder->CloseUI();
+    }
+  }
+
+  // Looks only at the local cookie of claude.ai: nothing goes out.
+  void OnReady(const base::ListValue& args) {
+    AllowJavascript();
+    Profile::FromWebUI(web_ui())
+        ->GetDefaultStoragePartition()
+        ->GetCookieManagerForBrowserProcess()
+        ->GetAllCookies(base::BindOnce(&ProfiloPanelHandler::OnCookies,
+                                       weak_factory_.GetWeakPtr()));
+  }
+
+  void OnCookies(const net::CookieList& cookies) {
+    bool signed_in = false;
+    for (const net::CanonicalCookie& cookie : cookies) {
+      if (cookie.Name() == "sessionKey" &&
+          base::EndsWith(cookie.Domain(), "claude.ai")) {
+        signed_in = true;
+        break;
+      }
+    }
+    web_ui()->CallJavascriptFunctionUnsafe("ProfiloPanel.loaded",
+                                           base::Value(signed_in));
+    if (auto embedder =
+            web_ui()->GetController()->GetAs<ProfiloPanelUI>()->embedder()) {
+      embedder->ShowUI();
+    }
+  }
+
+  void OnClose(const base::ListValue& args) { Close(); }
+
+  void OnOpenChats(const base::ListValue& args) {
+    BrowserWindowInterface* browser = GetBrowser();
+    Close();
+    if (browser) {
+      browser_fork::ShowClaudeChats(browser);
+    }
+  }
+
+  void OnLogout(const base::ListValue& args) {
+    BrowserWindowInterface* browser = GetBrowser();
+    Close();
+    if (browser) {
+      ShowSingletonTab(browser, GURL("https://claude.ai/logout"));
+    }
+  }
+
+  void OnOtherProfiles(const base::ListValue& args) {
+    BrowserWindowInterface* browser = GetBrowser();
+    Close();
+    if (browser) {
+      static_cast<AvatarToolbarButton*>(ToolbarButtonProvider::From(browser)
+                                            ->GetAvatarToolbarButtonInterface())
+          ->ShowChromiumProfileMenu();
+    }
+  }
+
+  base::WeakPtrFactory<ProfiloPanelHandler> weak_factory_{this};
+};
+
+}  // namespace
+
+ProfiloPanelUI::ProfiloPanelUI(content::WebUI* web_ui)
+    : TopChromeWebUIController(web_ui, /*enable_chrome_send=*/true) {
+  web_ui->AddMessageHandler(std::make_unique<ProfiloPanelHandler>());
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      Profile::FromWebUI(web_ui), chrome::kChromeUIProfiloPanelHost);
+  source->AddResourcePath("profilo_panel.js", IDR_PROFILO_PANEL_JS);
+  source->SetDefaultResource(IDR_PROFILO_PANEL_HTML);
+}
+
+ProfiloPanelUI::~ProfiloPanelUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(ProfiloPanelUI)

 namespace {
 
+#if BUILDFLAG(IS_MAC)
+constexpr int kPersonIconSize = 17;
+#else
+constexpr int kPersonIconSize = 18;
+#endif
+
+// The person of the boards: a head and shoulders, without a circle around.
+class PersonIconSource : public gfx::CanvasImageSource {
+ public:
+  PersonIconSource(int size, SkColor color)
+      : gfx::CanvasImageSource(gfx::Size(size, size)),
+        size_(size),
+        color_(color) {}
+
+  void Draw(gfx::Canvas* canvas) override {
+    const float unit = size_ / 16.f;
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(color_);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+    flags.setStrokeWidth(1.4f * unit);
+    canvas->DrawCircle(gfx::PointF(8 * unit, 5.5f * unit), 2.8f * unit, flags);
+    SkPathBuilder shoulders;
+    shoulders.moveTo(2.8f * unit, 14 * unit);
+    shoulders.cubicTo(3.4f * unit, 11.3f * unit, 5.5f * unit, 9.7f * unit,
+                      8 * unit, 9.7f * unit);
+    shoulders.cubicTo(10.5f * unit, 9.7f * unit, 12.6f * unit, 11.3f * unit,
+                      13.2f * unit, 14 * unit);
+    canvas->DrawPath(shoulders.detach(), flags);
+  }
+
+ private:
+  const int size_;
+  const SkColor color_;
+};

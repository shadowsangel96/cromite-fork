+  auto entry = std::make_unique<SidePanelEntry>(
+      ChatsKey(), base::BindRepeating(&CreateChatsView, browser),
+      /*default_content_width_callback=*/base::BindRepeating([] { return 360; }));
+  entry->set_should_show_ephemerally_in_toolbar(false);
+  window_registry->Register(std::move(entry));
+}
+
+bool IsClaudeEntry(const SidePanelEntryKey& key) {
+  return key == ChatsKey() || key == PageKey();
+}
+
+std::unique_ptr<views::View> CreateClaudePanelHeader(
+    BrowserWindowInterface* browser,
+    const SidePanelEntryKey& key) {
+  return std::make_unique<ClaudePanelHeader>(browser, key == PageKey());
+}
+
+}  // namespace browser_fork

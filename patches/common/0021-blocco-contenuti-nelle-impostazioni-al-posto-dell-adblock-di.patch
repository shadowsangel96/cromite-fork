@@ -0,0 +1,664 @@
+// "Blocco contenuti": the settings of uBlock Origin, built into the browser,
+// where Cromite's adblock used to be. The page talks to uBlock through a page
+// of uBlock in a hidden frame (ponte.html), with the same messages as the
+// dashboard of uBlock.
+
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_checkbox/cr_checkbox.js';
+import 'chrome://resources/cr_elements/cr_collapse/cr_collapse.js';
+import 'chrome://resources/cr_elements/cr_expand_button/cr_expand_button.js';
+import 'chrome://resources/cr_elements/cr_icon_button/cr_icon_button.js';
+import 'chrome://resources/cr_elements/cr_icons.css.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/cr_link_row/cr_link_row.js';
+import 'chrome://resources/cr_elements/cr_shared_style.css.js';
+import 'chrome://resources/cr_elements/cr_toggle/cr_toggle.js';
+import '../settings_page/settings_section.js';
+import '../settings_shared.css.js';
+
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {getSearchManager} from '../search_settings.js';
+import type {SettingsPlugin} from '../settings_main/settings_plugin.js';
+
+import {getTemplate} from './ublock_page.html.js';
+
+// The id comes from the key in overlay/chrome/browser/resources/ublock/
+// fork-ublock.json, as in chrome/browser/fork/ublock_extension.h.
+const UBLOCK_ORIGIN = 'chrome-extension://kkmdaeadfdjhhlfdpadhpjjommebkohi';
+
+// The groups of the lists, in the order of the dashboard of uBlock.
+const GROUPS: Array<[string, string]> = [
+  ['default', 'Integrate'],
+  ['ads', 'Pubblicità'],
+  ['privacy', 'Privacy'],
+  ['malware', 'Malware e siti pericolosi'],
+  ['multipurpose', 'Multiuso'],
+  ['cookies', 'Avvisi sui cookie'],
+  ['social', 'Pulsanti dei social'],
+  ['annoyances', 'Elementi fastidiosi'],
+  ['regions', 'Regioni e lingue'],
+  ['unknown', 'Altre'],
+  ['custom', 'Aggiunte da te'],
+];
+
+interface UblockList {
+  title?: string;
+  group?: string;
+  group2?: string;
+  off?: boolean;
+  external?: boolean;
+  entryCount?: number;
+  entryUsedCount?: number;
+}
+
+// A list is cached once uBlock has downloaded it; before that it filters with
+// the copy that comes with uBlock.
+interface UblockCacheEntry {
+  cached?: boolean;
+  writeTime?: number;
+}
+
+interface UblockLists {
+  autoUpdate: boolean;
+  available: Record<string, UblockList>;
+  cache: Record<string, UblockCacheEntry>;
+  isUpdating: boolean;
+  netFilterCount: number;
+  cosmeticFilterCount: number;
+  userFiltersPath: string;
+}
+
+interface FilterList {
+  key: string;
+  title: string;
+  on: boolean;
+  detail: string;
+  custom: boolean;
+}
+
+interface ListGroup {
+  key: string;
+  title: string;
+  summary: string;
+  lists: FilterList[];
+}
+
+interface BridgeReply {
+  ready?: boolean;
+  id?: number;
+  response?: unknown;
+}
+
+interface AppData {
+  name?: string;
+  version?: string;
+}
+
+interface UserFilters {
+  content?: string;
+  enabled?: boolean;
+  trusted?: boolean;
+}
+
+interface Rules {
+  permanentRules?: string[];
+}
+
+interface TrustedSites {
+  whitelist?: string[];
+  whitelistDefault?: string[];
+}
+
+function formatNumber(n: number): string {
+  return n.toLocaleString();
+}
+
+function ago(time: number|undefined): string {
+  if (!time) {
+    return '';
+  }
+  const minutes = Math.floor((Date.now() - time) / 60000);
+  if (minutes < 1) {
+    return 'adesso';
+  }
+  if (minutes < 60) {
+    return minutes === 1 ? '1 minuto fa' : `${minutes} minuti fa`;
+  }
+  const hours = Math.floor(minutes / 60);
+  if (hours < 24) {
+    return hours === 1 ? '1 ora fa' : `${hours} ore fa`;
+  }
+  const days = Math.floor(hours / 24);
+  return days === 1 ? 'ieri' : `${days} giorni fa`;
+}
+
+function lines(text: string): string[] {
+  return text.split(/\s*[\n\r]+\s*/).filter(line => line !== '');
+}
+
+export class SettingsUblockPageElement extends PolymerElement implements
+    SettingsPlugin {
+  static get is() {
+    return 'settings-ublock-page';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      appName_: {type: String, value: 'uBlock Origin'},
+      problem_: {type: String, value: ''},
+      filterCountText_: {type: String, value: ''},
+
+      listsOpened_: {type: Boolean, value: false},
+      listsSummary_: {type: String, value: ''},
+      autoUpdate_: {type: Boolean, value: true},
+      updating_: {type: Boolean, value: false},
+      updateText_: {type: String, value: ''},
+      groups_: {type: Array, value: () => []},
+      newList_: {type: String, value: ''},
+      listsStatus_: {type: String, value: ''},
+
+      filtersOpened_: {type: Boolean, value: false},
+      filtersSummary_: {type: String, value: ''},
+      filtersEnabled_: {type: Boolean, value: true},
+      filtersText_: {type: String, value: '', observer: 'onFiltersEdited_'},
+      filtersDirty_: {type: Boolean, value: false},
+      filtersStatus_: {type: String, value: ''},
+
+      rulesOpened_: {type: Boolean, value: false},
+      rulesSummary_: {type: String, value: ''},
+      rulesText_: {type: String, value: '', observer: 'onRulesEdited_'},
+      rulesDirty_: {type: Boolean, value: false},
+      rulesStatus_: {type: String, value: ''},
+
+      sitesOpened_: {type: Boolean, value: false},
+      sitesSummary_: {type: String, value: ''},
+      sites_: {type: Array, value: () => []},
+      newSite_: {type: String, value: ''},
+    };
+  }
+
+  declare private appName_: string;
+  declare private problem_: string;
+  declare private filterCountText_: string;
+  declare private listsOpened_: boolean;
+  declare private listsSummary_: string;
+  declare private autoUpdate_: boolean;
+  declare private updating_: boolean;
+  declare private updateText_: string;
+  declare private groups_: ListGroup[];
+  declare private newList_: string;
+  declare private listsStatus_: string;
+  declare private filtersOpened_: boolean;
+  declare private filtersSummary_: string;
+  declare private filtersEnabled_: boolean;
+  declare private filtersText_: string;
+  declare private filtersDirty_: boolean;
+  declare private filtersStatus_: string;
+  declare private rulesOpened_: boolean;
+  declare private rulesSummary_: string;
+  declare private rulesText_: string;
+  declare private rulesDirty_: boolean;
+  declare private rulesStatus_: string;
+  declare private sitesOpened_: boolean;
+  declare private sitesSummary_: string;
+  declare private sites_: string[];
+  declare private newSite_: string;
+
+  private frame_: HTMLIFrameElement|null = null;
+  private bridgeReady_: Promise<void>|null = null;
+  private onBridgeReady_: (() => void)|null = null;
+  private nextId_: number = 1;
+  private pending_: Map<number, (response: unknown) => void> = new Map();
+  private lists_: UblockLists|null = null;
+  private selection_: Set<string> = new Set();
+  private applyTimer_: number = 0;
+  private savedFilters_: string = '';
+  private filtersTrusted_: boolean = false;
+  private savedRules_: string[] = [];
+  private savedRulesText_: string = '';
+  private trusted_: string[] = [];
+  private trustedDefault_: string[] = [];
+
+  private onMessage_ = (event: MessageEvent) => {
+    if (!this.frame_ || event.origin !== UBLOCK_ORIGIN ||
+        event.source !== this.frame_.contentWindow) {
+      return;
+    }
+    const reply = event.data as BridgeReply;
+    if (reply.ready) {
+      this.onBridgeReady_?.();
+      return;
+    }
+    if (typeof reply.id !== 'number') {
+      return;
+    }
+    const resolve = this.pending_.get(reply.id);
+    if (resolve) {
+      this.pending_.delete(reply.id);
+      resolve(reply.response);
+    }
+  };
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.startBridge_();
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    window.removeEventListener('message', this.onMessage_);
+    this.frame_?.remove();
+    this.frame_ = null;
+    this.bridgeReady_ = null;
+    for (const resolve of this.pending_.values()) {
+      resolve(undefined);
+    }
+    this.pending_.clear();
+  }
+
+  private startBridge_() {
+    if (this.frame_) {
+      return;
+    }
+    this.bridgeReady_ = new Promise(resolve => {
+      this.onBridgeReady_ = resolve;
+    });
+    window.addEventListener('message', this.onMessage_);
+    const frame = document.createElement('iframe');
+    frame.hidden = true;
+    frame.src = `${UBLOCK_ORIGIN}/ponte.html`;
+    this.frame_ = frame;
+    this.shadowRoot!.appendChild(frame);
+    const timeout = setTimeout(() => {
+      this.problem_ = 'uBlock Origin non risponde. Riprova tra poco ' +
+          'o riavvia il browser.';
+    }, 10000);
+    this.bridgeReady_.then(() => {
+      clearTimeout(timeout);
+      this.problem_ = '';
+      this.loadAll_();
+    });
+  }
+
+  private async send_(message: object): Promise<unknown> {
+    if (!this.bridgeReady_) {
+      return undefined;
+    }
+    await this.bridgeReady_;
+    const frame = this.frame_;
+    if (!frame || !frame.contentWindow) {
+      return undefined;
+    }
+    const id = this.nextId_++;
+    return new Promise(resolve => {
+      this.pending_.set(id, resolve);
+      frame.contentWindow!.postMessage({id, message}, UBLOCK_ORIGIN);
+    });
+  }
+
+  private async loadAll_() {
+    const app = await this.send_({what: 'getAppData'}) as AppData|undefined;
+    if (app && app.name) {
+      this.appName_ = `${app.name} ${app.version}`;
+    }
+    await Promise.all([
+      this.loadLists_(),
+      this.loadFilters_(),
+      this.loadRules_(),
+      this.loadSites_(),
+    ]);
+  }
+
+  // Lists of filters.
+
+  private async loadLists_() {
+    const lists = await this.send_({what: 'getLists'}) as UblockLists|undefined;
+    if (!lists || !lists.available) {
+      return;
+    }
+    this.lists_ = lists;
+    this.autoUpdate_ = lists.autoUpdate === true;
+    this.updating_ = lists.isUpdating === true;
+    this.filterCountText_ = `${formatNumber(lists.netFilterCount)} filtri di ` +
+        `rete e ${formatNumber(lists.cosmeticFilterCount)} filtri cosmetici ` +
+        'in uso.';
+
+    const known = new Set(GROUPS.map(([key]) => key));
+    const byGroup = new Map<string, FilterList[]>();
+    this.selection_ = new Set();
+    let newest = 0;
+    let on = 0;
+    let total = 0;
+    for (const [key, list] of Object.entries(lists.available)) {
+      const selected = list.off !== true;
+      if (selected) {
+        this.selection_.add(key);
+      }
+      if (key === lists.userFiltersPath) {
+        continue;
+      }
+      let group = list.group2 || list.group || 'unknown';
+      if (!known.has(group)) {
+        group = 'unknown';
+      }
+      const cache = lists.cache[key];
+      const writeTime = cache?.cached ? cache.writeTime || 0 : 0;
+      let detail = '';
+      if (selected) {
+        const parts = [];
+        if (typeof list.entryCount === 'number') {
+          parts.push(`${formatNumber(list.entryUsedCount || 0)} filtri usati` +
+              ` su ${formatNumber(list.entryCount)}`);
+        }
+        parts.push(
+            writeTime ? `aggiornata ${ago(writeTime)}` :
+                        'copia inclusa in uBlock Origin, da aggiornare');
+        detail = parts.join(' · ');
+        newest = Math.max(newest, writeTime);
+        on++;
+      }
+      total++;
+      const entry = {
+        key,
+        title: list.title || key,
+        on: selected,
+        detail,
+        custom: list.external === true || group === 'custom',
+      };
+      if (!byGroup.has(group)) {
+        byGroup.set(group, []);
+      }
+      byGroup.get(group)!.push(entry);
+    }
+    this.groups_ = GROUPS.filter(([key]) => byGroup.has(key))
+                       .map(([key, title]) => {
+                         const items = byGroup.get(key)!;
+                         const active = items.filter(item => item.on).length;
+                         return {
+                           key,
+                           title,
+                           summary: `${active} attive su ${items.length}`,
+                           lists: items,
+                         };
+                       });
+    this.listsSummary_ = `${on} attive su ${total}`;
+    this.updateText_ = this.updating_ ?
+        'Aggiornamento in corso…' :
+        (newest ? `Ultimo aggiornamento ${ago(newest)}` : '');
+    if (this.updating_) {
+      setTimeout(() => this.loadLists_(), 2000);
+    }
+  }
+
+  private onListChange_(e: Event) {
+    const box = e.currentTarget as HTMLElement & {checked: boolean};
+    const key = box.dataset['key'];
+    if (!key) {
+      return;
+    }
+    if (box.checked) {
+      this.selection_.add(key);
+    } else {
+      this.selection_.delete(key);
+    }
+    this.listsStatus_ = 'Applico le liste…';
+    clearTimeout(this.applyTimer_);
+    this.applyTimer_ = setTimeout(() => this.applyLists_({}), 600);
+  }
+
+  private async applyLists_(extra: {toImport?: string, toRemove?: string[]}) {
+    this.listsStatus_ = 'Applico le liste…';
+    await this.send_({
+      what: 'applyFilterListSelection',
+      toSelect: [...this.selection_],
+      toImport: extra.toImport || '',
+      toRemove: extra.toRemove || [],
+    });
+    await this.send_({what: 'reloadAllFilters'});
+    await this.loadLists_();
+    this.listsStatus_ = 'Liste applicate.';
+  }
+
+  private onRemoveListClick_(e: Event) {
+    const key = (e.currentTarget as HTMLElement).dataset['key'];
+    if (!key) {
+      return;
+    }
+    this.selection_.delete(key);
+    this.applyLists_({toRemove: [key]});
+  }
+
+  private onAddListClick_() {
+    const url = this.newList_.trim();
+    if (!/^https?:\/\/\S+$/.test(url)) {
+      this.listsStatus_ = 'Scrivi l\'indirizzo completo della lista, con ' +
+          'https://.';
+      return;
+    }
+    this.newList_ = '';
+    this.applyLists_({toImport: url});
+  }
+
+  private onNewListKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Enter') {
+      this.onAddListClick_();
+    }
+  }
+
+  private async onAutoUpdateChange_(e: CustomEvent<boolean>) {
+    this.autoUpdate_ = e.detail;
+    await this.send_(
+        {what: 'userSettings', name: 'autoUpdate', value: e.detail});
+  }
+
+  private async onUpdateNowClick_() {
+    this.updating_ = true;
+    this.updateText_ = 'Aggiornamento in corso…';
+    await this.send_({what: 'updateNow'});
+    setTimeout(() => this.loadLists_(), 2000);
+  }
+
+  // Personal filters.
+
+  private async loadFilters_() {
+    const filters =
+        await this.send_({what: 'readUserFilters'}) as UserFilters|undefined;
+    if (!filters) {
+      return;
+    }
+    this.savedFilters_ = filters.content || '';
+    this.filtersEnabled_ = filters.enabled === true;
+    this.filtersTrusted_ = filters.trusted === true;
+    this.filtersText_ = this.savedFilters_;
+    this.onFiltersEdited_();
+    this.updateFiltersSummary_();
+  }
+
+  private updateFiltersSummary_() {
+    const count = lines(this.savedFilters_)
+                      .filter(line => !line.startsWith('!'))
+                      .length;
+    const what = count === 1 ? '1 filtro' : `${count} filtri`;
+    this.filtersSummary_ =
+        this.filtersEnabled_ ? what : `${what}, non in uso`;
+  }
+
+  private onFiltersEdited_() {
+    this.filtersDirty_ = this.filtersText_ !== this.savedFilters_;
+    if (this.filtersDirty_) {
+      this.filtersStatus_ = '';
+    }
+  }
+
+  private async writeFilters_(content: string) {
+    await this.send_({
+      what: 'writeUserFilters',
+      content,
+      enabled: this.filtersEnabled_,
+      trusted: this.filtersTrusted_,
+    });
+    this.savedFilters_ = content;
+    await this.send_({what: 'reloadAllFilters'});
+    this.updateFiltersSummary_();
+    this.onFiltersEdited_();
+  }
+
+  private async onFiltersSaveClick_() {
+    this.filtersStatus_ = 'Salvo…';
+    await this.writeFilters_(this.filtersText_);
+    this.filtersStatus_ = 'Salvati.';
+    this.loadLists_();
+  }
+
+  private onFiltersRevertClick_() {
+    this.filtersText_ = this.savedFilters_;
+    this.filtersStatus_ = '';
+  }
+
+  private async onFiltersEnabledChange_(e: CustomEvent<boolean>) {
+    this.filtersEnabled_ = e.detail;
+    if (e.detail) {
+      this.selection_.add(this.lists_?.userFiltersPath || 'user-filters');
+    } else {
+      this.selection_.delete(this.lists_?.userFiltersPath || 'user-filters');
+    }
+    await this.writeFilters_(this.savedFilters_);
+    this.loadLists_();
+  }
+
+  // Rules of dynamic filtering.
+
+  private async loadRules_() {
+    const rules = await this.send_({what: 'getRules'}) as Rules|undefined;
+    if (!rules) {
+      return;
+    }
+    this.showRules_(rules.permanentRules || []);
+  }
+
+  private showRules_(rules: string[]) {
+    this.savedRules_ = [...rules].sort();
+    this.savedRulesText_ = this.savedRules_.join('\n');
+    this.rulesText_ = this.savedRulesText_;
+    // The observer doesn't run when the text was already the same.
+    this.onRulesEdited_();
+    const count = this.savedRules_.length;
+    this.rulesSummary_ = count === 1 ? '1 regola' : `${count} regole`;
+  }
+
+  private onRulesEdited_() {
+    this.rulesDirty_ = this.rulesText_ !== this.savedRulesText_;
+    if (this.rulesDirty_) {
+      this.rulesStatus_ = '';
+    }
+  }
+
+  private async onRulesSaveClick_() {
+    const before = new Set(this.savedRules_);
+    const after = new Set(lines(this.rulesText_));
+    const toAdd = [...after].filter(rule => !before.has(rule)).join('\n');
+    const toRemove = [...before].filter(rule => !after.has(rule)).join('\n');
+    this.rulesStatus_ = 'Salvo…';
+    // The rules in use now, then the ones saved for the next start.
+    await this.send_(
+        {what: 'modifyRuleset', permanent: false, toAdd, toRemove});
+    const rules = await this.send_(
+        {what: 'modifyRuleset', permanent: true, toAdd, toRemove}) as
+        Rules|undefined;
+    if (rules) {
+      this.showRules_(rules.permanentRules || []);
+    }
+    const rejected = [...after].filter(
+        rule => !this.savedRules_.includes(rule.split(/\s+/).join(' ')));
+    this.rulesStatus_ = rejected.length ?
+        `Salvate. Non valide, quindi tolte: ${rejected.join(', ')}` :
+        'Salvate.';
+  }
+
+  private onRulesRevertClick_() {
+    this.rulesText_ = this.savedRulesText_;
+    this.rulesStatus_ = '';
+  }
+
+  // Sites where uBlock blocks nothing.
+
+  private async loadSites_() {
+    const sites =
+        await this.send_({what: 'getWhitelist'}) as TrustedSites|undefined;
+    if (!sites) {
+      return;
+    }
+    this.trustedDefault_ = sites.whitelistDefault || [];
+    this.trusted_ = sites.whitelist || [];
+    const hidden = new Set(this.trustedDefault_);
+    this.sites_ = this.trusted_.filter(
+        line => !hidden.has(line) && !line.startsWith('#'));
+    const count = this.sites_.length;
+    this.sitesSummary_ = count === 0 ? 'Nessuno' :
+        (count === 1 ? '1 sito' : `${count} siti`);
+  }
+
+  private async saveSites_(sites: string[]) {
+    await this.send_({what: 'setWhitelist', whitelist: sites.join('\n')});
+    await this.loadSites_();
+  }
+
+  private onRemoveSiteClick_(e: Event) {
+    const site = (e.currentTarget as HTMLElement).dataset['site'];
+    if (!site) {
+      return;
+    }
+    this.saveSites_(this.trusted_.filter(line => line !== site));
+  }
+
+  private onAddSiteClick_() {
+    let site = this.newSite_.trim();
+    if (site === '') {
+      return;
+    }
+    if (/^https?:\/\//.test(site)) {
+      try {
+        site = new URL(site).hostname;
+      } catch {
+        return;
+      }
+    }
+    this.newSite_ = '';
+    if (!this.trusted_.includes(site)) {
+      this.saveSites_([...this.trusted_, site]);
+    }
+  }
+
+  private onNewSiteKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Enter') {
+      this.onAddSiteClick_();
+    }
+  }
+
+  private onDashboardClick_() {
+    this.send_({
+      what: 'gotoURL',
+      details: {url: 'dashboard.html', select: true, index: -1},
+    });
+  }
+
+  // SettingsPlugin implementation
+  async searchContents(query: string) {
+    const searchRequest = await getSearchManager().search(query, this);
+    return searchRequest.getSearchResult();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-ublock-page': SettingsUblockPageElement;
+  }
+}
+
+customElements.define(
+    SettingsUblockPageElement.is, SettingsUblockPageElement);

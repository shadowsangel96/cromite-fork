diff --git a/chrome/browser/fork/site_dark_mode.cc b/chrome/browser/fork/site_dark_mode.cc
new file mode 100644
index 0000000000000000000000000000000000000000..2350cf13aa86b7d1184b4e26c852736bbc8e1fbc
--- /dev/null
+++ b/chrome/browser/fork/site_dark_mode.cc
@@ -0,0 +1,98 @@
+#include "chrome/browser/fork/site_dark_mode.h"
+
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/tab_contents/tab_contents_iterator.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/common/content_settings.h"
+#include "components/content_settings/core/common/content_settings_pattern.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace browser_fork {
+
+void RegisterSiteDarkModePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterIntegerPref(kSiteDarkModePref,
+                                static_cast<int>(SiteDarkMode::kAutomatic));
+}
+
+SiteDarkMode GetSiteDarkMode(Profile* profile) {
+  switch (profile->GetPrefs()->GetInteger(kSiteDarkModePref)) {
+    case static_cast<int>(SiteDarkMode::kAlways):
+      return SiteDarkMode::kAlways;
+    case static_cast<int>(SiteDarkMode::kNever):
+      return SiteDarkMode::kNever;
+    default:
+      return SiteDarkMode::kAutomatic;
+  }
+}
+
+SiteDarkException GetSiteDarkException(Profile* profile, const GURL& url) {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return SiteDarkException::kNone;
+  }
+  content_settings::SettingInfo info;
+  const ContentSetting setting =
+      HostContentSettingsMapFactory::GetForProfile(profile)->GetContentSetting(
+          url, url, ContentSettingsType::AUTO_DARK_WEB_CONTENT, &info);
+  // The default value is not an exception.
+  if (info.primary_pattern.MatchesAllHosts()) {
+    return SiteDarkException::kNone;
+  }
+  return setting == CONTENT_SETTING_BLOCK ? SiteDarkException::kOff
+                                          : SiteDarkException::kOn;
+}
+
+void SetSiteDarkException(Profile* profile,
+                          const GURL& url,
+                          SiteDarkException exception) {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  ContentSetting setting = CONTENT_SETTING_DEFAULT;
+  if (exception == SiteDarkException::kOn) {
+    setting = CONTENT_SETTING_ALLOW;
+  } else if (exception == SiteDarkException::kOff) {
+    setting = CONTENT_SETTING_BLOCK;
+  }
+  HostContentSettingsMapFactory::GetForProfile(profile)
+      ->SetContentSettingDefaultScope(
+          url, url, ContentSettingsType::AUTO_DARK_WEB_CONTENT, setting);
+  // The pages already open on the site change right away, without reloading.
+  tabs::ForEachTabInterface([profile](tabs::TabInterface* tab) {
+    content::WebContents* contents = tab->GetContents();
+    if (contents &&
+        Profile::FromBrowserContext(contents->GetBrowserContext()) == profile) {
+      contents->NotifyPreferencesChanged();
+    }
+    return true;
+  });
+}
+
+bool ShouldDarkenSite(Profile* profile, const GURL& url, bool browser_is_dark) {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  switch (GetSiteDarkException(profile, url)) {
+    case SiteDarkException::kOn:
+      return true;
+    case SiteDarkException::kOff:
+      return false;
+    case SiteDarkException::kNone:
+      break;
+  }
+  switch (GetSiteDarkMode(profile)) {
+    case SiteDarkMode::kAlways:
+      return true;
+    case SiteDarkMode::kNever:
+      return false;
+    case SiteDarkMode::kAutomatic:
+      return browser_is_dark;
+  }
+}
+
+}  // namespace browser_fork
diff --git a/chrome/browser/fork/site_dark_mode.h b/chrome/browser/fork/site_dark_mode.h
new file mode 100644
index 0000000000000000000000000000000000000000..0c13073481a4f0e94b7eef0fddcc06be9acc8efe
--- /dev/null
+++ b/chrome/browser/fork/site_dark_mode.h
@@ -0,0 +1,48 @@
+#ifndef CHROME_BROWSER_FORK_SITE_DARK_MODE_H_
+#define CHROME_BROWSER_FORK_SITE_DARK_MODE_H_
+
+class GURL;
+class Profile;
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}
+
+namespace browser_fork {
+
+// "Dark theme for sites" in the appearance settings. Blink's own engine darkens
+// the page while painting it: the page cannot see it, and sites that already
+// have a dark theme (color-scheme or prefers-color-scheme) keep theirs.
+inline constexpr char kSiteDarkModePref[] = "fork.site_dark_mode";
+
+enum class SiteDarkMode {
+  kAutomatic = 0,  // Only when the browser is dark.
+  kAlways = 1,
+  kNever = 2,
+};
+
+// The choice for one site, from the site panel. Stored as the
+// AUTO_DARK_WEB_CONTENT content setting: allow = on, block = off.
+enum class SiteDarkException {
+  kNone,
+  kOn,
+  kOff,
+};
+
+void RegisterSiteDarkModePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+SiteDarkMode GetSiteDarkMode(Profile* profile);
+SiteDarkException GetSiteDarkException(Profile* profile, const GURL& url);
+
+// Sets the exception for the site of `url` and updates the open tabs.
+void SetSiteDarkException(Profile* profile,
+                          const GURL& url,
+                          SiteDarkException exception);
+
+// Whether the pages of `url` are darkened. Only web pages: the browser's own
+// pages and the extensions' have their own themes.
+bool ShouldDarkenSite(Profile* profile, const GURL& url, bool browser_is_dark);
+
+}  // namespace browser_fork
+
+#endif  // CHROME_BROWSER_FORK_SITE_DARK_MODE_H_

+  // Empty for the pages that are not web pages: there the row is hidden.
+  std::u16string SiteDarkLabel(const GURL& url) {
+    if (!url.SchemeIsHTTPOrHTTPS()) {
+      return std::u16string();
+    }
+    switch (browser_fork::GetSiteDarkException(GetProfile(), url)) {
+      case browser_fork::SiteDarkException::kOn:
+        return l10n_util::GetStringUTF16(IDS_FORK_SITE_DARK_ON_HERE);
+      case browser_fork::SiteDarkException::kOff:
+        return l10n_util::GetStringUTF16(IDS_FORK_SITE_DARK_OFF_HERE);
+      case browser_fork::SiteDarkException::kNone:
+        break;
+    }
+    switch (browser_fork::GetSiteDarkMode(GetProfile())) {
+      case browser_fork::SiteDarkMode::kAlways:
+        return l10n_util::GetStringUTF16(IDS_FORK_SITE_DARK_ALWAYS);
+      case browser_fork::SiteDarkMode::kNever:
+        return l10n_util::GetStringUTF16(IDS_FORK_SITE_DARK_NEVER);
+      case browser_fork::SiteDarkMode::kAutomatic:
+        return l10n_util::GetStringUTF16(IDS_FORK_SITE_DARK_AUTOMATIC);
+    }
+  }
+
+  // Without an exception the click does the opposite of what the page shows
+  // now; with one it goes back to the general setting.
+  void OnToggleSiteDark(const base::ListValue& args) {
+    content::WebContents* contents = GetSiteContents();
+    if (!contents) {
+      return;
+    }
+    const GURL url = contents->GetLastCommittedURL();
+    browser_fork::SiteDarkException next =
+        browser_fork::SiteDarkException::kNone;
+    if (browser_fork::GetSiteDarkException(GetProfile(), url) ==
+        browser_fork::SiteDarkException::kNone) {
+      next = contents->GetOrCreateWebPreferences().force_dark_mode_enabled
+                 ? browser_fork::SiteDarkException::kOff
+                 : browser_fork::SiteDarkException::kOn;
+    }
+    browser_fork::SetSiteDarkException(GetProfile(), url, next);
+    SendState();
+  }

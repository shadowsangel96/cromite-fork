 const AtomicString& Document::referrer() const {
+  // A script of the page reading it counts in the protections panel.
+  if (v8::Isolate* isolate = v8::Isolate::TryGetCurrent();
+      isolate && isolate->InContext() && domWindow() &&
+      ExecutionContext::From(isolate->GetCurrentContext()) == domWindow()) {
+    CountForkRead(domWindow(), ForkRead::kReferrer);
+  }
   if (Loader())
     return Loader()->GetReferrer();
   return g_null_atom;

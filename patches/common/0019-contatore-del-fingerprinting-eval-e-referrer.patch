@@ -53,12 +53,16 @@ constexpr Category kCategories[] = {
     {"Storage", FingerprintingAnswer::kAllowed},
     {"Permessi", FingerprintingAnswer::kAllowed},
     {"Batteria", FingerprintingAnswer::kUniform},
-    {"eval", FingerprintingAnswer::kNotCounted},
-    {"Referrer", FingerprintingAnswer::kNotCounted},
+    // Code from strings stays allowed; the referrer goes only within a site,
+    // as Cromite removes it on the navigations between sites.
+    {"eval", FingerprintingAnswer::kAllowed},
+    {"Referrer", FingerprintingAnswer::kLimited},
 };
 static_assert(std::size(kCategories) == FingerprintingCounter::kCategoryCount);
 
 constexpr size_t kWebGL = 1;
+constexpr size_t kEval = 13;
+constexpr size_t kReferrer = 14;
 
 // The APIs that tell a device apart, as the use counters of Blink name them.
 std::optional<size_t> CategoryOf(WebFeature feature) {
@@ -192,6 +196,12 @@ class FarblingHostImpl : public blink::mojom::FarblingHost {
       : frame_(frame) {}
 
   // blink::mojom::FarblingHost:
+  void ReportRead(blink::mojom::FingerprintingRead read) override {
+    FingerprintingCounter::RecordScriptRead(
+        content::RenderFrameHost::FromID(frame_),
+        read == blink::mojom::FingerprintingRead::kEval);
+  }
+
   void GetSeed(GetSeedCallback callback) override {
     content::RenderFrameHost* frame = content::RenderFrameHost::FromID(frame_);
     std::move(callback).Run(frame ? FarblingSeedForFrame(frame)
@@ -241,6 +251,21 @@ void FingerprintingCounter::RecordFeatures(
   }
 }
 
+// static
+void FingerprintingCounter::RecordScriptRead(
+    content::RenderFrameHost* render_frame_host,
+    bool eval) {
+  if (!render_frame_host) {
+    return;
+  }
+  content::Page& page = render_frame_host->GetOutermostMainFrame()->GetPage();
+  ++GetOrCreateForPage(page)->counts_[eval ? kEval : kReferrer];
+  if (page.IsPrimary()) {
+    GetCallbacks().Notify(
+        content::WebContents::FromRenderFrameHost(render_frame_host));
+  }
+}
+
 // static
 std::vector<FingerprintingRow> FingerprintingCounter::GetRows(
     content::WebContents* contents) {

+// What the page already told the browser it read.
+class ForkReads final : public GarbageCollected<ForkReads>,
+                        public Supplement<LocalDOMWindow> {
+ public:
+  static const char kSupplementName[];
+
+  static ForkReads& From(LocalDOMWindow& window) {
+    ForkReads* reads = Supplement<LocalDOMWindow>::From<ForkReads>(window);
+    if (!reads) {
+      reads = MakeGarbageCollected<ForkReads>(window);
+      Supplement<LocalDOMWindow>::ProvideTo(window, reads);
+    }
+    return *reads;
+  }
+
+  explicit ForkReads(LocalDOMWindow& window)
+      : Supplement<LocalDOMWindow>(window) {}
+
+  void Trace(Visitor* visitor) const override {
+    Supplement<LocalDOMWindow>::Trace(visitor);
+  }
+
+  bool eval = false;
+  bool referrer = false;
+};
+
+const char ForkReads::kSupplementName[] = "ForkReads";
+
 }  // namespace
 
+void CountForkRead(ExecutionContext* context, ForkRead read) {
+  auto* window = DynamicTo<LocalDOMWindow>(context);
+  if (!window || !window->GetFrame()) {
+    return;
+  }
+  ForkReads& reads = ForkReads::From(*window);
+  bool& counted = read == ForkRead::kEval ? reads.eval : reads.referrer;
+  if (counted) {
+    return;
+  }
+  counted = true;
+  mojo::Remote<mojom::blink::FarblingHost> host;
+  window->GetFrame()->GetBrowserInterfaceBroker().GetInterface(
+      host.BindNewPipeAndPassReceiver());
+  host->ReportRead(read == ForkRead::kEval
+                       ? mojom::blink::FingerprintingRead::kEval
+                       : mojom::blink::FingerprintingRead::kReferrer);
+}
+

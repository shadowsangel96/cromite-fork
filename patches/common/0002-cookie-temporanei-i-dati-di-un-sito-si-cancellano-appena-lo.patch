diff --git a/chrome/browser/fork/temporary_site_data_service.cc b/chrome/browser/fork/temporary_site_data_service.cc
new file mode 100644
index 0000000000000000000000000000000000000000..d18e84c1de133a6e922d0b88e71b3f31735e0eed
--- /dev/null
+++ b/chrome/browser/fork/temporary_site_data_service.cc
@@ -0,0 +1,220 @@
+#include "chrome/browser/fork/temporary_site_data_service.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/values.h"
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/common/content_settings_pattern.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/browsing_data_filter_builder.h"
+#include "content/public/browser/browsing_data_remover.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
+#include "net/base/schemeful_site.h"
+#include "net/cookies/cookie_partition_key_collection.h"
+#include "url/gurl.h"
+
+namespace browser_fork {
+
+namespace {
+
+using Remover = content::BrowsingDataRemover;
+using FilterBuilder = content::BrowsingDataFilterBuilder;
+
+// Everything a site can read back. Site permissions (such as "allow WebGL") stay
+// and so does the HTTP cache, which is already separated by top-level site.
+constexpr uint64_t kSiteDataMask =
+    Remover::DATA_TYPE_COOKIES | Remover::DATA_TYPE_DOM_STORAGE |
+    Remover::DATA_TYPE_MEDIA_LICENSES | Remover::DATA_TYPE_DEVICE_BOUND_SESSIONS;
+constexpr uint64_t kOriginMask =
+    Remover::ORIGIN_TYPE_UNPROTECTED_WEB | Remover::ORIGIN_TYPE_PROTECTED_WEB;
+
+}  // namespace
+
+// static
+void TemporarySiteDataService::RegisterProfilePrefs(
+    user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterIntegerPref(kCookieModePref,
+                                static_cast<int>(CookieMode::kTemporary));
+  registry->RegisterListPref(kRememberedSitesPref);
+}
+
+// static
+std::string TemporarySiteDataService::SiteForUrl(const GURL& url) {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return std::string();
+  }
+  std::string domain = net::registry_controlled_domains::GetDomainAndRegistry(
+      url, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  return domain.empty() ? std::string(url.host()) : domain;
+}
+
+TemporarySiteDataService::TemporarySiteDataService(Profile* profile)
+    : profile_(profile) {
+  registrar_.Init(profile_->GetPrefs());
+  auto changed = base::BindRepeating(
+      &TemporarySiteDataService::OnSettingsChanged, base::Unretained(this));
+  registrar_.Add(kCookieModePref, changed);
+  registrar_.Add(kRememberedSitesPref, changed);
+  ReadRememberedSites();
+  if (mode() == CookieMode::kTemporary) {
+    // What the last session left behind: closing the browser or a crash can
+    // interrupt a deletion.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&TemporarySiteDataService::Sweep,
+                                  weak_factory_.GetWeakPtr()));
+  }
+}
+
+TemporarySiteDataService::~TemporarySiteDataService() = default;
+
+void TemporarySiteDataService::Shutdown() {
+  shut_down_ = true;
+  holds_.clear();
+  registrar_.RemoveAll();
+}
+
+CookieMode TemporarySiteDataService::mode() const {
+  return static_cast<CookieMode>(profile_->GetPrefs()->GetInteger(kCookieModePref));
+}
+
+void TemporarySiteDataService::ReadRememberedSites() {
+  remembered_.clear();
+  for (const base::Value& entry :
+       profile_->GetPrefs()->GetList(kRememberedSitesPref)) {
+    if (!entry.is_string()) {
+      continue;
+    }
+    std::string text = base::ToLowerASCII(entry.GetString());
+    base::TrimWhitespaceASCII(text, base::TRIM_ALL, &text);
+    if (text.empty()) {
+      continue;
+    }
+    GURL url(text.find("://") == std::string::npos ? "https://" + text : text);
+    std::string site = SiteForUrl(url);
+    if (!site.empty()) {
+      remembered_.insert(std::move(site));
+    }
+  }
+}
+
+void TemporarySiteDataService::OnSettingsChanged() {
+  ReadRememberedSites();
+  ApplyCookieContentSetting();
+  if (mode() == CookieMode::kTemporary) {
+    Sweep();
+  }
+}
+
+void TemporarySiteDataService::ApplyCookieContentSetting() {
+  HostContentSettingsMap* map =
+      HostContentSettingsMapFactory::GetForProfile(profile_);
+  map->ClearSettingsForOneType(ContentSettingsType::COOKIES);
+  if (mode() != CookieMode::kBlockAll) {
+    map->SetDefaultContentSetting(ContentSettingsType::COOKIES,
+                                  CONTENT_SETTING_DEFAULT);
+    return;
+  }
+  map->SetDefaultContentSetting(ContentSettingsType::COOKIES,
+                                CONTENT_SETTING_BLOCK);
+  for (const std::string& site : remembered_) {
+    map->SetContentSettingCustomScope(
+        ContentSettingsPattern::FromString("[*.]" + site),
+        ContentSettingsPattern::Wildcard(), ContentSettingsType::COOKIES,
+        CONTENT_SETTING_ALLOW);
+  }
+}
+
+void TemporarySiteDataService::TabEntered(const std::string& site) {
+  ++open_tabs_[site];
+}
+
+void TemporarySiteDataService::TabLeft(const std::string& site) {
+  auto it = open_tabs_.find(site);
+  if (it == open_tabs_.end()) {
+    return;
+  }
+  if (--it->second == 0) {
+    open_tabs_.erase(it);
+    MaybeClear(site);
+  }
+}
+
+void TemporarySiteDataService::Hold(const std::string& site) {
+  auto& timer = holds_[site];
+  if (!timer) {
+    timer = std::make_unique<base::OneShotTimer>();
+  }
+  timer->Start(FROM_HERE, kRoundTripHold,
+               base::BindOnce(&TemporarySiteDataService::Release,
+                              base::Unretained(this), site));
+}
+
+void TemporarySiteDataService::Release(const std::string& site) {
+  // The copy keeps `site` alive: it can belong to the timer being erased.
+  const std::string copy = site;
+  auto it = holds_.find(copy);
+  if (it == holds_.end()) {
+    return;
+  }
+  holds_.erase(it);
+  MaybeClear(copy);
+}
+
+void TemporarySiteDataService::MaybeClear(const std::string& site) {
+  if (shut_down_ || mode() != CookieMode::kTemporary ||
+      open_tabs_.contains(site) || holds_.contains(site) ||
+      remembered_.contains(site)) {
+    return;
+  }
+  ClearSite(site);
+}
+
+void TemporarySiteDataService::ClearSite(const std::string& site) {
+  Remover* remover = profile_->GetBrowsingDataRemover();
+  auto filter = FilterBuilder::Create(FilterBuilder::Mode::kDelete);
+  filter->AddRegisterableDomain(site);
+  remover->RemoveWithFilter(base::Time(), base::Time::Max(), kSiteDataMask,
+                            kOriginMask, std::move(filter));
+
+  // Cookies are separated by top-level site: those of the third parties
+  // embedded in this site have their own domain, so they need another pass.
+  for (const char* scheme : {"https://", "http://"}) {
+    auto partitioned = FilterBuilder::Create(FilterBuilder::Mode::kPreserve);
+    partitioned->SetCookiePartitionKeyCollection(
+        net::CookiePartitionKeyCollection::MatchesSite(
+            net::SchemefulSite(GURL(scheme + site))));
+    partitioned->SetPartitionedCookiesOnly(true);
+    remover->RemoveWithFilter(base::Time(), base::Time::Max(),
+                              Remover::DATA_TYPE_COOKIES, kOriginMask,
+                              std::move(partitioned));
+  }
+}
+
+void TemporarySiteDataService::Sweep() {
+  if (shut_down_) {
+    return;
+  }
+  auto filter = FilterBuilder::Create(FilterBuilder::Mode::kPreserve);
+  for (const std::string& site : remembered_) {
+    filter->AddRegisterableDomain(site);
+  }
+  for (const auto& [site, count] : open_tabs_) {
+    filter->AddRegisterableDomain(site);
+  }
+  for (const auto& [site, timer] : holds_) {
+    filter->AddRegisterableDomain(site);
+  }
+  profile_->GetBrowsingDataRemover()->RemoveWithFilter(
+      base::Time(), base::Time::Max(), kSiteDataMask, kOriginMask,
+      std::move(filter));
+}
+
+}  // namespace browser_fork
diff --git a/chrome/browser/fork/temporary_site_data_service.h b/chrome/browser/fork/temporary_site_data_service.h
new file mode 100644
index 0000000000000000000000000000000000000000..f9627ec7bfd7ee63dc85009d2f865fa5b6a3ab11
--- /dev/null
+++ b/chrome/browser/fork/temporary_site_data_service.h
@@ -0,0 +1,83 @@
+// Temporary cookies: what a site stores lasts for the visit and is deleted as
+// soon as the site is left, unless the user chose to remember the site.
+
+#ifndef CHROME_BROWSER_FORK_TEMPORARY_SITE_DATA_SERVICE_H_
+#define CHROME_BROWSER_FORK_TEMPORARY_SITE_DATA_SERVICE_H_
+
+#include <map>
+#include <memory>
+#include <set>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "components/prefs/pref_change_registrar.h"
+
+class GURL;
+class Profile;
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}
+
+namespace browser_fork {
+
+enum class CookieMode : int {
+  kTemporary = 0,  // Kept during the visit, deleted when the site is left.
+  kNormal = 1,     // As in Chromium.
+  kBlockAll = 2,   // Nothing is stored, except by the remembered sites.
+};
+
+inline constexpr char kCookieModePref[] = "fork.cookie_mode";
+inline constexpr char kRememberedSitesPref[] = "fork.remembered_sites";
+
+// How long the data of a site survives a round trip that the site itself
+// started, such as a payment on the page of a bank or an external login.
+inline constexpr base::TimeDelta kRoundTripHold = base::Minutes(5);
+
+class TemporarySiteDataService : public KeyedService {
+ public:
+  static void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+  // The site data is grouped by: the registrable domain, or the host when it
+  // has none (an IP address, a local name). Empty for anything but http(s).
+  static std::string SiteForUrl(const GURL& url);
+
+  explicit TemporarySiteDataService(Profile* profile);
+  ~TemporarySiteDataService() override;
+
+  // A tab shows, or stopped showing, a page of `site`.
+  void TabEntered(const std::string& site);
+  void TabLeft(const std::string& site);
+
+  // Keeps the data of `site` for at most kRoundTripHold.
+  void Hold(const std::string& site);
+  void Release(const std::string& site);
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  CookieMode mode() const;
+  void OnSettingsChanged();
+  void ReadRememberedSites();
+  void ApplyCookieContentSetting();
+  void MaybeClear(const std::string& site);
+  void ClearSite(const std::string& site);
+  void Sweep();
+
+  raw_ptr<Profile> profile_;
+  PrefChangeRegistrar registrar_;
+  std::set<std::string> remembered_;
+  std::map<std::string, int> open_tabs_;
+  std::map<std::string, std::unique_ptr<base::OneShotTimer>> holds_;
+  bool shut_down_ = false;
+  base::WeakPtrFactory<TemporarySiteDataService> weak_factory_{this};
+};
+
+}  // namespace browser_fork
+
+#endif  // CHROME_BROWSER_FORK_TEMPORARY_SITE_DATA_SERVICE_H_

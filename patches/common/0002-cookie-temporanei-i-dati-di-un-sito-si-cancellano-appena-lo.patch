+#ifndef CHROME_BROWSER_FORK_TEMPORARY_SITE_DATA_TAB_HELPER_H_
+#define CHROME_BROWSER_FORK_TEMPORARY_SITE_DATA_TAB_HELPER_H_
+
+#include <string>
+#include <vector>
+
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace browser_fork {
+
+class TemporarySiteDataService;
+
+// Tells TemporarySiteDataService which site a tab is showing.
+class TemporarySiteDataTabHelper
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<TemporarySiteDataTabHelper> {
+ public:
+  ~TemporarySiteDataTabHelper() override;
+
+ private:
+  friend class content::WebContentsUserData<TemporarySiteDataTabHelper>;
+
+  explicit TemporarySiteDataTabHelper(content::WebContents* web_contents);
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override;
+  void WebContentsDestroyed() override;
+
+  TemporarySiteDataService* service();
+  void ReleaseHeldSites();
+
+  std::string site_;
+  // The sites this tab left on a round trip they started and may come back to.
+  std::vector<std::string> held_sites_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace browser_fork
+
+#endif  // CHROME_BROWSER_FORK_TEMPORARY_SITE_DATA_TAB_HELPER_H_

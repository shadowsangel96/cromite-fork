+#include "chrome/browser/fork/temporary_site_data_service_factory.h"
+
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "chrome/browser/fork/temporary_site_data_service.h"
+#include "chrome/browser/profiles/profile.h"
+
+namespace browser_fork {
+
+// static
+TemporarySiteDataService* TemporarySiteDataServiceFactory::GetForProfile(
+    Profile* profile) {
+  return static_cast<TemporarySiteDataService*>(
+      GetInstance()->GetServiceForBrowserContext(profile, /*create=*/true));
+}
+
+// static
+TemporarySiteDataServiceFactory* TemporarySiteDataServiceFactory::GetInstance() {
+  static base::NoDestructor<TemporarySiteDataServiceFactory> instance;
+  return instance.get();
+}
+
+TemporarySiteDataServiceFactory::TemporarySiteDataServiceFactory()
+    : ProfileKeyedServiceFactory("TemporarySiteDataService",
+                                 ProfileSelections::BuildForRegularProfile()) {
+  DependsOn(HostContentSettingsMapFactory::GetInstance());
+}
+
+TemporarySiteDataServiceFactory::~TemporarySiteDataServiceFactory() = default;
+
+std::unique_ptr<KeyedService>
+TemporarySiteDataServiceFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  return std::make_unique<TemporarySiteDataService>(
+      Profile::FromBrowserContext(context));
+}
+
+}  // namespace browser_fork

diff --git a/chrome/browser/fork/temporary_site_data_tab_helper.cc b/chrome/browser/fork/temporary_site_data_tab_helper.cc
new file mode 100644
index 0000000000000000000000000000000000000000..2413e1b00af6720a0b251ed5e02d1a97857b8596
--- /dev/null
+++ b/chrome/browser/fork/temporary_site_data_tab_helper.cc
@@ -0,0 +1,124 @@
+#include "chrome/browser/fork/temporary_site_data_tab_helper.h"
+
+#include <algorithm>
+#include <string_view>
+#include <vector>
+
+#include "chrome/browser/fork/temporary_site_data_service.h"
+#include "chrome/browser/fork/temporary_site_data_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/page_transition_types.h"
+#include "url/gurl.h"
+
+namespace browser_fork {
+
+namespace {
+
+// True when the site itself sent the user away, so that it may expect them back:
+// a form sent to another site, a redirect of its server or of its scripts, a link
+// that carries the address to return to. Not when the user left: a plain link,
+// the address bar, the back button.
+bool SiteStartedRoundTrip(content::NavigationHandle* handle,
+                          const std::string& old_site) {
+  if (handle->GetPageTransition() & ui::PAGE_TRANSITION_FORWARD_BACK) {
+    return false;
+  }
+  if (handle->IsPost()) {
+    return true;
+  }
+  const std::vector<GURL>& chain = handle->GetRedirectChain();
+  if (handle->WasServerRedirect() && !chain.empty() &&
+      TemporarySiteDataService::SiteForUrl(chain.front()) == old_site) {
+    return true;
+  }
+  if (handle->IsRendererInitiated() && !handle->HasUserGesture()) {
+    return true;
+  }
+  return handle->GetURL().query().find("redirect_uri=") !=
+         std::string_view::npos;
+}
+
+}  // namespace
+
+TemporarySiteDataTabHelper::TemporarySiteDataTabHelper(
+    content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<TemporarySiteDataTabHelper>(*web_contents),
+      site_(TemporarySiteDataService::SiteForUrl(
+          web_contents->GetLastCommittedURL())) {
+  if (auto* s = service(); s && !site_.empty()) {
+    s->TabEntered(site_);
+  }
+}
+
+TemporarySiteDataTabHelper::~TemporarySiteDataTabHelper() = default;
+
+TemporarySiteDataService* TemporarySiteDataTabHelper::service() {
+  return TemporarySiteDataServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(web_contents()->GetBrowserContext()));
+}
+
+void TemporarySiteDataTabHelper::ReleaseHeldSites() {
+  TemporarySiteDataService* s = service();
+  for (const std::string& site : held_sites_) {
+    if (s) {
+      s->Release(site);
+    }
+  }
+  held_sites_.clear();
+}
+
+void TemporarySiteDataTabHelper::DidFinishNavigation(
+    content::NavigationHandle* handle) {
+  if (!handle->IsInPrimaryMainFrame() || !handle->HasCommitted() ||
+      handle->IsSameDocument()) {
+    return;
+  }
+  std::string new_site = TemporarySiteDataService::SiteForUrl(handle->GetURL());
+  if (new_site == site_) {
+    return;
+  }
+  TemporarySiteDataService* s = service();
+  if (!s) {
+    return;
+  }
+  const std::string old_site = site_;
+  const bool round_trip =
+      !old_site.empty() && SiteStartedRoundTrip(handle, old_site);
+  site_ = new_site;
+  if (!new_site.empty()) {
+    s->TabEntered(new_site);
+  }
+  if (round_trip) {
+    s->Hold(old_site);
+    held_sites_.push_back(old_site);
+  } else if (!held_sites_.empty()) {
+    // The user went elsewhere, or came back: the trip is over.
+    ReleaseHeldSites();
+  }
+  if (round_trip && std::ranges::contains(held_sites_, new_site)) {
+    // The trip ended with a redirect back to a site that was waiting.
+    ReleaseHeldSites();
+  }
+  if (!old_site.empty()) {
+    s->TabLeft(old_site);
+  }
+}
+
+void TemporarySiteDataTabHelper::WebContentsDestroyed() {
+  TemporarySiteDataService* s = service();
+  if (!s) {
+    return;
+  }
+  ReleaseHeldSites();
+  if (!site_.empty()) {
+    s->TabLeft(site_);
+    site_.clear();
+  }
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TemporarySiteDataTabHelper);
+
+}  // namespace browser_fork

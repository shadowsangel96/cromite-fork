+#include "chrome/browser/ui/webui/top_chrome/top_chrome_webui_config.h"
+#include "chrome/common/webui_url_constants.h"
+#include "content/public/common/url_constants.h"
+
+class SitePanelUI;
+
+class SitePanelUIConfig : public DefaultTopChromeWebUIConfig<SitePanelUI> {
+ public:
+  SitePanelUIConfig()
+      : DefaultTopChromeWebUIConfig(content::kChromeUIScheme,
+                                    chrome::kChromeUISitePanelHost) {}
+
+  // TopChromeWebUIConfig:
+  bool ShouldAutoResizeHost() override { return true; }
+};
+
+// The panel of the shield in the address field: what the browser does on the site
+// of the active tab, as in the sketches.
+class SitePanelUI : public TopChromeWebUIController {
+ public:
+  explicit SitePanelUI(content::WebUI* web_ui);
+  SitePanelUI(const SitePanelUI&) = delete;
+  SitePanelUI& operator=(const SitePanelUI&) = delete;
+  ~SitePanelUI() override;
+
+  static constexpr std::string_view GetWebUIName() { return "SitePanel"; }
+  static constexpr int kBubbleCornerRadius = 18;
+
+ private:
+  WEB_UI_CONTROLLER_TYPE_DECL();
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SITE_PANEL_UI_H_

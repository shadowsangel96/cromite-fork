diff --git a/chrome/browser/ui/webui/site_panel_ui.cc b/chrome/browser/ui/webui/site_panel_ui.cc
new file mode 100644
index 0000000000000000000000000000000000000000..125a4845f53e2d75bf59ea974749dcc9471031a7
--- /dev/null
+++ b/chrome/browser/ui/webui/site_panel_ui.cc
@@ -0,0 +1,238 @@
+#include "chrome/browser/ui/webui/site_panel_ui.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/values.h"
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "chrome/browser/fork/temporary_site_data_service.h"
+#include "chrome/browser/fork/vpn_status.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ssl/chrome_security_state_util.h"
+#include "chrome/browser/ui/bubble_anchor_util.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/page_info/page_info_dialog.h"
+#include "chrome/browser/ui/singleton_tabs.h"
+#include "chrome/browser/ui/webui/webui_embedding_context.h"
+#include "chrome/grit/browser_resources.h"
+#include "components/browsing_data/content/browsing_data_helper.h"
+#include "components/content_settings/browser/page_specific_content_settings.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/common/content_settings.h"
+#include "components/prefs/pref_service.h"
+#include "components/security_state/core/security_state.h"
+#include "components/tabs/public/tab_interface.h"
+#include "components/url_formatter/elide_url.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "content/public/browser/web_ui_message_handler.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr ContentSettingsType kPermissions[] = {
+    ContentSettingsType::GEOLOCATION, ContentSettingsType::NOTIFICATIONS,
+    ContentSettingsType::MEDIASTREAM_MIC,
+    ContentSettingsType::MEDIASTREAM_CAMERA};
+
+const char* RouteName(browser_fork::VpnStatus::Route route) {
+  switch (route) {
+    case browser_fork::VpnStatus::Route::kNormal:
+      return "normal";
+    case browser_fork::VpnStatus::Route::kVpn:
+      return "vpn";
+    case browser_fork::VpnStatus::Route::kVpnDown:
+      return "down";
+    case browser_fork::VpnStatus::Route::kDirectReserve:
+      return "direct";
+  }
+}
+
+class SitePanelHandler : public content::WebUIMessageHandler {
+ public:
+  SitePanelHandler() = default;
+  SitePanelHandler(const SitePanelHandler&) = delete;
+  SitePanelHandler& operator=(const SitePanelHandler&) = delete;
+  ~SitePanelHandler() override = default;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    const auto add = [this](const char* name,
+                            void (SitePanelHandler::*method)(
+                                const base::ListValue&)) {
+      web_ui()->RegisterMessageCallback(
+          name, base::BindRepeating(method, base::Unretained(this)));
+    };
+    add("ready", &SitePanelHandler::OnReady);
+    add("close", &SitePanelHandler::OnClose);
+    add("openPageInfo", &SitePanelHandler::OnOpenPageInfo);
+    add("openVpnSettings", &SitePanelHandler::OnOpenVpnSettings);
+    add("setRemembered", &SitePanelHandler::OnSetRemembered);
+    add("setWebgl", &SitePanelHandler::OnSetWebgl);
+  }
+
+ private:
+  BrowserWindowInterface* GetBrowser() {
+    return webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+  }
+
+  // The tab the panel talks about. The bubble closes when the tab changes.
+  content::WebContents* GetSiteContents() {
+    BrowserWindowInterface* browser = GetBrowser();
+    tabs::TabInterface* tab = browser ? browser->GetActiveTabInterface() : nullptr;
+    return tab ? tab->GetContents() : nullptr;
+  }
+
+  Profile* GetProfile() { return Profile::FromWebUI(web_ui()); }
+
+  std::string SiteOf(const GURL& url) {
+    return browser_fork::TemporarySiteDataService::SiteForUrl(url);
+  }
+
+  bool IsRemembered(const GURL& url) {
+    const std::string site = SiteOf(url);
+    for (const base::Value& entry :
+         GetProfile()->GetPrefs()->GetList(browser_fork::kRememberedSitesPref)) {
+      if (entry.is_string() && SiteOf(GURL(entry.GetString().find("://") ==
+                                                   std::string::npos
+                                               ? "https://" + entry.GetString()
+                                               : entry.GetString())) == site) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  base::DictValue BuildState(content::WebContents* contents) {
+    const GURL url = contents->GetLastCommittedURL();
+    HostContentSettingsMap* map =
+        HostContentSettingsMapFactory::GetForProfile(GetProfile());
+    int permissions = 0;
+    for (ContentSettingsType type : kPermissions) {
+      if (map->GetContentSetting(url, url, type) == CONTENT_SETTING_ALLOW) {
+        ++permissions;
+      }
+    }
+    int cookies = 0;
+    if (auto* settings = content_settings::PageSpecificContentSettings::GetForFrame(
+            contents->GetPrimaryMainFrame())) {
+      cookies = browsing_data::GetUniqueHostCount(
+          *settings->allowed_browsing_data_model());
+    }
+    base::DictValue state;
+    state.Set("site", url_formatter::FormatUrlForSecurityDisplay(
+                          url, url_formatter::SchemeDisplay::OMIT_HTTP_AND_HTTPS));
+    state.Set("secure", chrome_security_state::GetSecurityLevel(contents) ==
+                            security_state::SECURE);
+    state.Set("route", RouteName(browser_fork::VpnStatus::Get()->route()));
+    state.Set("city",
+              GetProfile()->GetPrefs()->GetString(browser_fork::kVpnExitCityPref));
+    state.Set("cookies", cookies);
+    state.Set("permissions", permissions);
+    state.Set("remembered", IsRemembered(url));
+    state.Set("webgl", map->GetContentSetting(url, url,
+                                              ContentSettingsType::WEBGL) ==
+                           CONTENT_SETTING_ALLOW);
+    return state;
+  }
+
+  void SendState() {
+    if (content::WebContents* contents = GetSiteContents()) {
+      AllowJavascript();
+      web_ui()->CallJavascriptFunctionUnsafe("SitePanel.loaded",
+                                             BuildState(contents));
+    }
+  }
+
+  void OnReady(const base::ListValue& args) {
+    SendState();
+    if (auto embedder =
+            web_ui()->GetController()->GetAs<SitePanelUI>()->embedder()) {
+      embedder->ShowUI();
+    }
+  }
+
+  void Close() {
+    if (auto embedder =
+            web_ui()->GetController()->GetAs<SitePanelUI>()->embedder()) {
+      embedder->CloseUI();
+    }
+  }
+
+  void OnClose(const base::ListValue& args) { Close(); }
+
+  void OnOpenPageInfo(const base::ListValue& args) {
+    content::WebContents* contents = GetSiteContents();
+    Close();
+    if (contents) {
+      ShowPageInfoDialog(contents, base::DoNothing(),
+                         bubble_anchor_util::Anchor::kLocationBar);
+    }
+  }
+
+  void OnOpenVpnSettings(const base::ListValue& args) {
+    BrowserWindowInterface* browser = GetBrowser();
+    Close();
+    if (browser) {
+      ShowSingletonTab(browser, GURL("chrome://proxy"));
+    }
+  }
+
+  void OnSetRemembered(const base::ListValue& args) {
+    content::WebContents* contents = GetSiteContents();
+    if (!contents || args.size() != 1 || !args[0].is_bool()) {
+      return;
+    }
+    const GURL url = contents->GetLastCommittedURL();
+    const std::string site = SiteOf(url);
+    PrefService* prefs = GetProfile()->GetPrefs();
+    base::ListValue sites =
+        prefs->GetList(browser_fork::kRememberedSitesPref).Clone();
+    sites.EraseIf([&](const base::Value& entry) {
+      return entry.is_string() &&
+             SiteOf(GURL(entry.GetString().find("://") == std::string::npos
+                             ? "https://" + entry.GetString()
+                             : entry.GetString())) == site;
+    });
+    if (args[0].GetBool()) {
+      sites.Append(site);
+    }
+    prefs->SetList(browser_fork::kRememberedSitesPref, std::move(sites));
+    SendState();
+  }
+
+  void OnSetWebgl(const base::ListValue& args) {
+    content::WebContents* contents = GetSiteContents();
+    if (!contents || args.size() != 1 || !args[0].is_bool()) {
+      return;
+    }
+    const GURL url = contents->GetLastCommittedURL();
+    HostContentSettingsMapFactory::GetForProfile(GetProfile())
+        ->SetContentSettingDefaultScope(
+            url, url, ContentSettingsType::WEBGL,
+            args[0].GetBool() ? CONTENT_SETTING_ALLOW : CONTENT_SETTING_DEFAULT);
+    contents->GetController().Reload(content::ReloadType::NORMAL,
+                                     /*check_for_repost=*/true);
+    SendState();
+  }
+};
+
+}  // namespace
+
+SitePanelUI::SitePanelUI(content::WebUI* web_ui)
+    : TopChromeWebUIController(web_ui, /*enable_chrome_send=*/true) {
+  web_ui->AddMessageHandler(std::make_unique<SitePanelHandler>());
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      Profile::FromWebUI(web_ui), chrome::kChromeUISitePanelHost);
+  source->AddResourcePath("site_panel.js", IDR_SITE_PANEL_JS);
+  source->SetDefaultResource(IDR_SITE_PANEL_HTML);
+}
+
+SitePanelUI::~SitePanelUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(SitePanelUI)

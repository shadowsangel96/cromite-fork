--- /dev/null
+++ b/chrome/browser/resources/site_panel.js
@@ -0,0 +1,62 @@
+window.SitePanel = (function() {
+  'use strict';
+
+  let state = null;
+
+  const $ = (id) => document.getElementById(id);
+
+  function routeText(s) {
+    const place = s.city ? ' (' + s.city + ')' : '';
+    switch (s.route) {
+      case 'vpn':
+        return 'Esci dalla VPN personale' + place;
+      case 'down':
+        return 'Il server VPN non risponde: nessuna pagina esce diretta';
+      case 'direct':
+        return 'Connessione diretta: i siti vedono l\'IP di casa';
+      default:
+        return 'VPN spenta: esci dalla connessione normale';
+    }
+  }
+
+  function loaded(s) {
+    state = s;
+    $('site').textContent = s.site;
+    $('lock').toggleAttribute('hidden', !s.secure);
+    $('secure-text').textContent =
+        s.secure ? 'Connessione sicura' : 'Connessione non sicura';
+    $('route').className = s.route;
+    $('route-text').textContent = routeText(s);
+    $('webgl-chip').className = 'chip ' + (s.webgl ? 'uni' : 'block');
+    $('webgl-chip').textContent = s.webgl ? 'Consentito' : 'Bloccato';
+    $('webgl-on').hidden = !s.webgl;
+    $('webgl-off').hidden = s.webgl;
+    $('webgl').classList.toggle('on', s.webgl);
+    $('webgl').textContent = s.webgl ? 'Blocca di nuovo WebGL su questo sito' :
+                                       'Consenti WebGL su questo sito';
+    $('remember-value').textContent = s.remembered ? 'Sì' : 'No';
+    $('cookies-value').textContent = s.cookies ? s.cookies + ' in uso' : 'Nessuno';
+    $('permissions-value').textContent =
+        s.permissions ? String(s.permissions) : 'Nessuna';
+  }
+
+  document.addEventListener('DOMContentLoaded', () => {
+    $('close').onclick = () => chrome.send('close');
+    $('route').onclick = () => chrome.send('openVpnSettings');
+    $('webgl').onclick = () => chrome.send('setWebgl', [!state.webgl]);
+    $('remember').onclick = () => chrome.send('setRemembered', [!state.remembered]);
+    $('cookies').onclick = () => chrome.send('openPageInfo');
+    $('permissions').onclick = () => chrome.send('openPageInfo');
+    chrome.send('ready');
+  });
+
+  // Il pannello resta in memoria per qualche secondo: riaprendolo la pagina non si
+  // ricarica, e il sito può essere un altro.
+  document.addEventListener('visibilitychange', () => {
+    if (document.visibilityState === 'visible') {
+      chrome.send('ready');
+    }
+  });
+
+  return {loaded};
+})();

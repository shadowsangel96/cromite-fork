+  --green: #157038; --green-bg: rgba(21,112,56,0.13); --orange: #9a4f00; --orange-bg: rgba(201,105,0,0.15);
+  --red: #c4001a; --red-bg: rgba(196,0,26,0.11); --stripe-a: rgba(196,0,26,0.12); --stripe-b: rgba(196,0,26,0.03);
+  --canvas-bg: #ffffff; --chip-solid: #ffffff;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --text: #f5f5f7; --sub: #b3b3ba; --field: rgba(255,255,255,0.1); --sep: rgba(255,255,255,0.12);
+    --panel: #28282c; --group: rgba(255,255,255,0.05); --accent: #5aa9ff; --accent-bg: rgba(90,169,255,0.16);
+    --green: #4cd27f; --green-bg: rgba(76,210,127,0.15); --orange: #ffad33; --orange-bg: rgba(255,173,51,0.15);
+    --red: #ff6b6b; --red-bg: rgba(255,107,107,0.15); --stripe-a: rgba(255,107,107,0.18); --stripe-b: rgba(255,107,107,0.05);
+    --canvas-bg: #f4f4f6; --chip-solid: #2c2c30;
+  }
+}
+html, body { margin: 0; width: 372px; background: var(--panel); }
+body { font-family: -apple-system, BlinkMacSystemFont, system-ui, sans-serif; color: var(--text); text-align: left; }
+button { font: inherit; cursor: pointer; }
+#panel { box-sizing: border-box; padding: 14px; display: flex; flex-direction: column; gap: 12px; }
+header { display: flex; align-items: flex-start; gap: 10px; }
+header > div { flex: 1; min-width: 0; }
+#site { font-size: 15px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+#secure { margin-top: 2px; font-size: 12px; color: var(--sub); display: flex; align-items: center; gap: 4px; }
+#close { width: 24px; height: 24px; border: 0; border-radius: 12px; background: var(--field); color: var(--sub); display: flex; align-items: center; justify-content: center; padding: 0; }
+#route { width: 100%; padding: 8px 10px; border: 0; border-radius: 10px; font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px; text-align: left; }
+#route span { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; background: currentColor; }
+#route b { font-weight: inherit; }
+#route.vpn { background: var(--green-bg); color: var(--green); }
+#route.down { background: var(--orange-bg); color: var(--orange); }
+#route.direct { background: #c4001a; color: #ffffff; }
+#route.normal { background: var(--field); color: var(--sub); }
+h2 { margin: 0; font-size: 13px; font-weight: 700; }
+h3 { margin: 0 0 6px; font-size: 12px; font-weight: 600; color: var(--sub); }
+.hint { margin: 4px 0 8px; font-size: 12px; line-height: 1.4; color: var(--sub); }
+.group { border-radius: 12px; background: var(--group); }
+.row { width: 100%; min-height: 30px; padding: 0 10px; box-sizing: border-box; border: 0; background: transparent; color: var(--text); font-size: 13px; display: flex; align-items: center; gap: 8px; text-align: left; }
+.row + .row { border-top: 1px solid var(--sep); }
+.row > span:first-child { flex: 1; min-width: 0; }
+.chip { padding: 2px 8px; border-radius: 9px; font-size: 11px; font-weight: 600; white-space: nowrap; }
+.rand { background: var(--accent-bg); color: var(--accent); }
+.block { background: var(--red-bg); color: var(--red); }
+.uni { background: var(--field); color: var(--text); }
+.value { font-size: 12px; color: var(--sub); }
+.row svg { color: var(--sub); }
+.previews { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
+figure { margin: 0; }
+.preview { height: 64px; border-radius: 8px; overflow: hidden; box-shadow: inset 0 0 0 1px var(--sep); background: var(--canvas-bg); }
+.preview.blocked { background: repeating-linear-gradient(135deg, var(--stripe-a) 0 7px, var(--stripe-b) 7px 14px); display: flex; align-items: center; justify-content: center; }
+.preview.blocked span { padding: 3px 9px; border-radius: 9px; background: var(--chip-solid); color: var(--red); font-size: 11px; font-weight: 700; }
+figcaption { margin-top: 4px; font-size: 11px; color: var(--sub); }

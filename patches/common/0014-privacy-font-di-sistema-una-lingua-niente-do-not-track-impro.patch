diff --git a/chrome/browser/fork/farbling_key.cc b/chrome/browser/fork/farbling_key.cc
new file mode 100644
index 0000000000000000000000000000000000000000..61928f20cc3c1466368a29ee7eb28cbccb28c4c2
--- /dev/null
+++ b/chrome/browser/fork/farbling_key.cc
@@ -0,0 +1,40 @@
+#include "chrome/browser/fork/farbling_key.h"
+
+#include <memory>
+
+#include "base/rand_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/supports_user_data.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/spare_render_process_host_manager.h"
+
+namespace browser_fork {
+
+namespace {
+
+struct FarblingKeyData : public base::SupportsUserData::Data {
+  std::string key = base::HexEncode(base::RandBytesAsVector(32));
+};
+
+constexpr char kFarblingKeyUserDataKey[] = "fork_farbling_key";
+
+}  // namespace
+
+const std::string& GetFarblingKey(Profile* profile) {
+  auto* data = static_cast<FarblingKeyData*>(
+      profile->GetUserData(kFarblingKeyUserDataKey));
+  if (!data) {
+    auto owned = std::make_unique<FarblingKeyData>();
+    data = owned.get();
+    profile->SetUserData(kFarblingKeyUserDataKey, std::move(owned));
+  }
+  return data->key;
+}
+
+void ResetFarblingKey(Profile* profile) {
+  profile->RemoveUserData(kFarblingKeyUserDataKey);
+  // The spare renderer, ready for the next page, still has the old key.
+  content::SpareRenderProcessHostManager::Get().CleanupSparesForTesting();
+}
+
+}  // namespace browser_fork
diff --git a/chrome/browser/fork/farbling_key.h b/chrome/browser/fork/farbling_key.h
new file mode 100644
index 0000000000000000000000000000000000000000..9a323c57fe83ebd67a824ced2a285d4c768d342e
--- /dev/null
+++ b/chrome/browser/fork/farbling_key.h
@@ -0,0 +1,22 @@
+#ifndef CHROME_BROWSER_FORK_FARBLING_KEY_H_
+#define CHROME_BROWSER_FORK_FARBLING_KEY_H_
+
+#include <string>
+
+class Profile;
+
+namespace browser_fork {
+
+// The key of the noise against fingerprinting: one for each profile, new at
+// every start of the browser and only in memory. The renderers mix it with the
+// site, so a site reads the same values for the whole session and two sites
+// can't match them.
+const std::string& GetFarblingKey(Profile* profile);
+
+// A new key when the data of every site is deleted: the pages opened from now
+// on show a new fingerprint.
+void ResetFarblingKey(Profile* profile);
+
+}  // namespace browser_fork
+
+#endif  // CHROME_BROWSER_FORK_FARBLING_KEY_H_

new file mode 100644
index 0000000000000000000000000000000000000000..72853989b46bf18ded91f041805ecb543b898ad6
--- /dev/null
+++ b/chrome/browser/ui/views/location_bar/ublock_button.cc
@@ -0,0 +1,202 @@
+#include "chrome/browser/ui/views/location_bar/ublock_button.h"
+
+#include <algorithm>

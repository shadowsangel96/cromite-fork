+#include "chrome/browser/ui/extensions/extension_popup_types.h"
+#include "chrome/browser/ui/views/extensions/extension_popup.h"
+#include "chrome/browser/ui/views/location_bar/location_bar_view.h"
+#include "content/public/browser/web_contents.h"
+#include "extensions/browser/extension_action.h"
+#include "extensions/browser/extension_action_manager.h"
+#include "extensions/browser/extension_registry.h"
+#include "ui/accessibility/ax_enums.mojom.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/gfx/font_list.h"
+#include "ui/gfx/image/image_skia.h"
+#include "ui/gfx/text_utils.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/bubble/bubble_anchor.h"
+#include "ui/views/bubble/bubble_border.h"
+
+namespace {
+
+// Sizes from the boards: a 30x26 capsule with a 14 dp badge that sticks out
+// 3 dp at the top right. The view is as tall as the bar so the badge fits.
+constexpr int kCapsuleWidth = 30;
+constexpr int kCapsuleHeight = 26;
+constexpr int kBadgeHeight = 14;
+constexpr int kBadgeOverhang = 3;
+constexpr int kIconSize = 16;
+
+}  // namespace
+
+UBlockButton::UBlockButton(LocationBarView* location_bar,
+                           BrowserWindowInterface* browser,
+                           Profile* profile)
+    : views::Button(base::BindRepeating(&UBlockButton::OnPressed,
+                                        base::Unretained(this))),
+      location_bar_(location_bar),
+      browser_(browser),
+      profile_(profile) {
+  SetVisible(false);
+  GetViewAccessibility().SetRole(ax::mojom::Role::kButton);
+  GetViewAccessibility().SetName(u"Blocco contenuti");
+  action_observation_.Observe(
+      extensions::ExtensionActionDispatcher::Get(profile_));
+}
+
+UBlockButton::~UBlockButton() = default;
+
+const extensions::Extension* UBlockButton::GetExtension() const {
+  return extensions::ExtensionRegistry::Get(profile_)
+      ->enabled_extensions()
+      .GetByID(browser_fork::kUBlockExtensionId);
+}
+
+void UBlockButton::Update(content::WebContents* contents, bool show) {
+  const extensions::Extension* extension = GetExtension();
+  extensions::ExtensionAction* action =
+      extension ? extensions::ExtensionActionManager::Get(profile_)
+                      ->GetExtensionAction(*extension)
+                : nullptr;
+  SetVisible(show && action && contents);
+  if (!GetVisible()) {
+    return;
+  }
+  const int tab_id = extensions::ExtensionTabUtil::GetTabId(contents);
+  badge_ = base::UTF8ToUTF16(action->GetDisplayBadgeText(tab_id));
+  // uBlock Origin writes "(off)" in the title when it is off on the site.
+  on_ = !base::EndsWith(action->GetTitle(tab_id), "(off)");
+  icon_ = action->GetExplicitlySetIcon(tab_id);
+  if (icon_.IsEmpty()) {
+    icon_ = action->GetDefaultIconImage();
+  }
+  // The badge can also be "!": the page started before uBlock Origin was ready.
+  const bool counted = !badge_.empty() && base::IsAsciiDigit(badge_[0]);
+  const std::u16string name =
+      on_ ? (counted ? u"Blocco contenuti: " + badge_ + u" elementi bloccati"
+                     : u"Blocco contenuti")
+          : u"Blocco contenuti spento su questo sito";
+  GetViewAccessibility().SetName(name);
+  SetTooltipText(name);
+  SchedulePaint();
+}
+
+void UBlockButton::OnPressed() {
+  // The click that lands here has already closed the open panel.
+  if (base::TimeTicks::Now() - panel_closed_at_ < base::Milliseconds(400)) {
+    return;
+  }
+  ShowPanel();
+}
+
+void UBlockButton::ShowPanel() {
+  const extensions::Extension* extension = GetExtension();
+  if (!extension || panel_observation_.IsObserving()) {
+    return;
+  }
+  std::unique_ptr<extensions::ExtensionViewHost> host =
+      extensions::ExtensionViewHostFactory::CreatePopupHost(
+          *extension, extension->GetResourceURL("blocco.html"), browser_);
+  panel_observation_.Observe(ExtensionPopup::ShowPopup(
+      browser_, std::move(host), views::BubbleAnchor(this),
+      views::BubbleBorder::TOP_RIGHT, PopupShowAction::kShow,
+      base::DoNothing()));
+}
+
+void UBlockButton::OnWidgetDestroying(views::Widget* widget) {
+  panel_observation_.Reset();
+  panel_closed_at_ = base::TimeTicks::Now();
+}
+
+gfx::Size UBlockButton::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(kCapsuleWidth + kBadgeOverhang, kCapsuleHeight);
+}
+
+gfx::Rect UBlockButton::GetAnchorBoundsInScreen() const {
+  // Where the boards put the panel: 42 dp below the top of the bar, 4 dp past
+  // its right edge.
+  const gfx::Rect bar = parent()->GetBoundsInScreen();
+  return gfx::Rect(bar.right() + 3, bar.y(), 1, 42);
+}
+
+void UBlockButton::PaintButtonContents(gfx::Canvas* canvas) {
+  const bool dark = color_utils::IsDark(
+      GetColorProvider()->GetColor(kColorToolbar));
+  const SkColor capsule =
+      on_ ? (dark ? SkColorSetA(SkColorSetRGB(255, 107, 107), 38)
+                  : SkColorSetA(SkColorSetRGB(196, 0, 26), 28))
+          : (dark ? SkColorSetA(SK_ColorWHITE, 26) : SkColorSetA(SK_ColorBLACK, 18));
+  const SkColor badge_color =
+      dark ? SkColorSetRGB(255, 107, 107) : SkColorSetRGB(196, 0, 26);
+  const SkColor badge_text = dark ? SkColorSetRGB(43, 0, 6) : SK_ColorWHITE;
+  const SkColor badge_ring = dark ? SkColorSetRGB(42, 42, 46) : SK_ColorWHITE;
+
+  const gfx::Rect pill(0, (height() - kCapsuleHeight) / 2, kCapsuleWidth,
+                       kCapsuleHeight);
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(capsule);
+  canvas->DrawRoundRect(pill, kCapsuleHeight / 2, flags);
+
+  if (!icon_.IsEmpty()) {
+    canvas->DrawImageInt(*icon_.ToImageSkia(), 0, 0, icon_.Width(),
+                         icon_.Height(),
+                         pill.x() + (pill.width() - kIconSize) / 2,
+                         pill.y() + (pill.height() - kIconSize) / 2, kIconSize,
+                         kIconSize, /*filter=*/true);
+  }
+
+  if (!on_ || badge_.empty()) {
+    return;
+  }
+  const gfx::FontList font =
+      gfx::FontList().DeriveWithSizeDelta(9 - gfx::FontList().GetFontSize())
+          .DeriveWithWeight(gfx::Font::Weight::BOLD);
+  const int badge_width =
+      std::max(kBadgeHeight, gfx::GetStringWidth(badge_, font) + 6);
+  const gfx::Rect badge(pill.right() + kBadgeOverhang - badge_width,
+                        std::max(0, pill.y() - kBadgeOverhang), badge_width,
+                        kBadgeHeight);
+  gfx::RectF ring(badge);
+  ring.Outset(1.5f);
+  flags.setColor(badge_ring);
+  canvas->DrawRoundRect(ring, ring.height() / 2, flags);
+  flags.setColor(badge_color);
+  canvas->DrawRoundRect(badge, kBadgeHeight / 2, flags);
+  canvas->DrawStringRectWithFlags(badge_, font, badge_text, badge,
+                                  gfx::Canvas::TEXT_ALIGN_CENTER);
+}
+
+void UBlockButton::OnExtensionActionUpdated(
+    extensions::ExtensionAction* extension_action,
+    content::WebContents* web_contents,
+    content::BrowserContext* browser_context) {
+  if (extension_action->extension_id() == browser_fork::kUBlockExtensionId) {
+    location_bar_->UpdateUBlockButton();
+  }
+}
+
+void UBlockButton::OnShuttingDown() {
+  action_observation_.Reset();
+}
+
+BEGIN_METADATA(UBlockButton)
+END_METADATA

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shadowsangel96 <188833096+shadowsangel96@users.noreply.github.com>
Date: Tue, 10 Nov 2026 17:48:48 +0100
Subject: [PATCH] Traduzioni: le nostre scritte in inglese e italiano

Le scritte delle nostre patch passano dalle risorse di Chromium: fork_strings.grd
(inglese) e fork_strings_it.xtb (italiano), generati da tools/fork_strings.py del
fork a partire da strings/fork_strings.json. La lingua segue quella del browser.

Fork-Patch: common/0022-traduzioni-le-nostre-scritte-in-inglese-e-italiano.patch

diff --git a/chrome/app/BUILD.gn b/chrome/app/BUILD.gn
index 07e4d3aa8789b0a9631bb84312b0e22916b2c3b5..7f592d9c63b23472f6f7bf1ced245cab16c93a35 100644
--- a/chrome/app/BUILD.gn
+++ b/chrome/app/BUILD.gn
@@ -93,6 +93,15 @@ if (is_win) {
   }
 }
 
+# The strings of the fork: English in fork_strings.grd, the translations in
+# resources/fork_strings_*.xtb, both made by tools/fork_strings.py of the fork.
+grit_strings("fork_strings") {
+  source = "fork_strings.grd"
+  inputs = [ "resources/fork_strings_it.xtb" ]
+  output_dir = "$root_gen_dir/chrome"
+  outputs = [ "grit/fork_strings.h" ]
+}
+
 grit_strings("generated_resources") {
   source = "generated_resources.grd"
   gritdeps = "generated_resources.grd.gritdeps"

@@ -0,0 +1,496 @@
+#include "chrome/browser/fork/login_assistant.h"
+
+#include <algorithm>
+#include <iterator>
+#include <string_view>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "chrome/browser/extensions/extension_tab_util.h"
+#include "chrome/browser/fork/temporary_site_data_service.h"
+#include "chrome/browser/fork/ublock_extension.h"
+#include "chrome/browser/lookalikes/lookalike_url_service.h"
+#include "chrome/browser/lookalikes/lookalike_url_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/grit/fork_strings.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+#include "components/lookalikes/core/lookalike_url_util.h"
+#include "components/lookalikes/core/safety_tips_config.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/storage_partition.h"
+#include "content/public/browser/web_contents.h"
+#include "components/url_formatter/url_formatter.h"
+#include "net/base/url_util.h"
+#include "extensions/browser/extension_action.h"
+#include "extensions/browser/extension_action_manager.h"
+#include "extensions/browser/extension_registry.h"
+#include "services/network/public/mojom/cookie_manager.mojom.h"
+#include "ui/base/l10n/l10n_util.h"
+
+namespace browser_fork {
+
+namespace {
+
+// After the sign-in the site usually sets its cookies and moves to the next
+// page: the verdict waits for that.
+constexpr base::TimeDelta kSettleDelay = base::Milliseconds(1500);
+
+// With this many trackers blocked on the page the site is "with care".
+constexpr int kManyTrackers = 10;
+
+ShowLoginAssistantCallback& ShowCallback() {
+  static base::NoDestructor<ShowLoginAssistantCallback> callback;
+  return *callback;
+}
+
+enum class CookieKind {
+  kSite,
+  kAnalytics,
+  kAdvertising,
+};
+
+struct KnownCookie {
+  std::string_view name;
+  CookieKind kind;
+};
+
+struct VendorCookie {
+  std::string_view name;
+  std::string_view domain;
+  CookieKind kind;
+  bool prefix;
+};
+
+// The analytics and advertising cookies of the Open Cookie Database
+// (Apache-2.0), converted by tools/dati_accesso.py of the fork.
+#include "chrome/browser/fork/login_cookie_data.inc"
+
+bool InDomain(std::string_view domain, std::string_view site) {
+  return domain == site ||
+         (domain.size() > site.size() && domain.ends_with(site) &&
+          domain[domain.size() - site.size() - 1] == '.');
+}
+
+// What a cookie of `site` is for. Names that only mean something on the
+// domain of a company (SID on google.com) count only there.
+CookieKind ClassifyCookie(std::string_view name, std::string_view site) {
+  const auto* it = std::ranges::lower_bound(kGenericCookies, name, {},
+                                            &KnownCookie::name);
+  if (it != std::end(kGenericCookies) && it->name == name) {
+    return it->kind;
+  }
+  for (const KnownCookie& known : kGenericCookiePrefixes) {
+    if (name.starts_with(known.name)) {
+      return known.kind;
+    }
+  }
+  for (const VendorCookie& known : kVendorCookies) {
+    if ((known.prefix ? name.starts_with(known.name) : name == known.name) &&
+        InDomain(known.domain, site)) {
+      return known.kind;
+    }
+  }
+  return CookieKind::kSite;
+}
+
+// The big tracking networks, with the company: present on many other sites
+// with their pixels and scripts. A list of our own: the ready-made ones
+// (Disconnect, Ghostery, DuckDuckGo) are not under a free license.
+struct TrackingNetwork {
+  std::string_view domain;
+  std::string_view company;
+};
+constexpr TrackingNetwork kTrackingNetworks[] = {
+    {"facebook.com", "Meta"},        {"instagram.com", "Meta"},
+    {"messenger.com", "Meta"},       {"meta.com", "Meta"},
+    {"threads.net", "Meta"},         {"threads.com", "Meta"},
+    {"google.com", "Google"},        {"google.it", "Google"},
+    {"youtube.com", "Google"},       {"blogger.com", "Google"},
+    {"microsoft.com", "Microsoft"},  {"live.com", "Microsoft"},
+    {"outlook.com", "Microsoft"},    {"bing.com", "Microsoft"},
+    {"msn.com", "Microsoft"},        {"linkedin.com", "Microsoft"},
+    {"x.com", "X"},                  {"twitter.com", "X"},
+    {"tiktok.com", "TikTok"},        {"amazon.com", "Amazon"},
+    {"amazon.it", "Amazon"},         {"amazon.de", "Amazon"},
+    {"amazon.fr", "Amazon"},         {"amazon.es", "Amazon"},
+    {"amazon.co.uk", "Amazon"},      {"pinterest.com", "Pinterest"},
+    {"pinterest.it", "Pinterest"},   {"snapchat.com", "Snap"},
+    {"reddit.com", "Reddit"},        {"yahoo.com", "Yahoo"},
+    {"adobe.com", "Adobe"},          {"criteo.com", "Criteo"},
+    {"taboola.com", "Taboola"},      {"outbrain.com", "Outbrain"},
+    {"yandex.ru", "Yandex"},         {"yandex.com", "Yandex"},
+    {"baidu.com", "Baidu"},
+};
+
+std::optional<std::string_view> TrackingCompany(std::string_view site) {
+  for (const TrackingNetwork& network : kTrackingNetworks) {
+    if (InDomain(site, network.domain)) {
+      return network.company;
+    }
+  }
+  return std::nullopt;
+}
+
+// The domain that `url` imitates, if any. LookalikeUrlService stops when the
+// Safety Tips configuration is missing, and it comes from the component
+// updater, which Cromite turns off: the checks themselves (skeletons of the
+// top domains, edit distance, character swaps) are in the browser and work
+// with an empty configuration.
+std::optional<std::string> LookalikeOf(Profile* profile, const GURL& url) {
+  const std::string host(url.host());
+  if (!url.SchemeIsHTTPOrHTTPS() || net::HostStringIsLocalhost(host) ||
+      net::IsHostnameNonUnique(host) ||
+      lookalikes::GetETLDPlusOne(host).empty() ||
+      lookalikes::IsSafeTLD(host) || url_formatter::IsTopDomain(url)) {
+    return std::nullopt;
+  }
+  LookalikeUrlService* service =
+      LookalikeUrlServiceFactory::GetForProfile(profile);
+  // DomainInfo cannot be assigned: the list is built once, here.
+  const std::vector<lookalikes::DomainInfo> engaged =
+      service ? service->GetLatestEngagedSites()
+              : std::vector<lookalikes::DomainInfo>();
+  const lookalikes::DomainInfo navigated = lookalikes::GetDomainInfo(url);
+  // A site the user uses a lot is not a fake one.
+  if (std::ranges::contains(engaged, navigated.domain_and_registry,
+                            &lookalikes::DomainInfo::domain_and_registry)) {
+    return std::nullopt;
+  }
+  static const base::NoDestructor<reputation::SafetyTipsConfig> kEmptyConfig;
+  const reputation::SafetyTipsConfig* config =
+      lookalikes::GetSafetyTipsRemoteConfigProto();
+  if (!config) {
+    config = kEmptyConfig.get();
+  }
+  std::string matched;
+  lookalikes::LookalikeUrlMatchType match_type;
+  if (lookalikes::GetMatchingDomain(
+          navigated, engaged,
+          base::BindRepeating(
+              &lookalikes::IsTargetHostAllowlistedBySafetyTipsComponent,
+              config),
+          config, &matched, &match_type) &&
+      !matched.empty()) {
+    return matched;
+  }
+  return std::nullopt;
+}
+
+bool CookieBelongsToSite(const net::CanonicalCookie& cookie,
+                         const std::string& site) {
+  std::string_view domain = cookie.Domain();
+  if (domain.starts_with('.')) {
+    domain.remove_prefix(1);
+  }
+  return domain == site || domain.ends_with("." + site);
+}
+
+// The number on the uBlock Origin icon for the tab: "12", "1k"...
+int BlockedTrackers(Profile* profile, content::WebContents* contents) {
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(profile)
+          ->enabled_extensions()
+          .GetByID(kUBlockExtensionId);
+  extensions::ExtensionAction* action =
+      extension ? extensions::ExtensionActionManager::Get(profile)
+                      ->GetExtensionAction(*extension)
+                : nullptr;
+  if (!action) {
+    return 0;
+  }
+  const std::string badge = action->GetDisplayBadgeText(
+      extensions::ExtensionTabUtil::GetTabId(contents));
+  size_t digits = 0;
+  while (digits < badge.size() && base::IsAsciiDigit(badge[digits])) {
+    ++digits;
+  }
+  int count = 0;
+  if (!base::StringToInt(std::string_view(badge).substr(0, digits), &count)) {
+    return 0;
+  }
+  if (digits < badge.size() && (badge[digits] == 'k' || badge[digits] == 'K')) {
+    count *= 1000;
+  }
+  return count;
+}
+
+std::u16string Count(int n) {
+  return base::NumberToString16(n);
+}
+
+}  // namespace
+
+LoginAssessment::LoginAssessment() = default;
+LoginAssessment::LoginAssessment(const LoginAssessment&) = default;
+LoginAssessment::~LoginAssessment() = default;
+
+void RegisterLoginAssistantPrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterListPref(kLoginAssistantDeclinedPref);
+}
+
+void SetShowLoginAssistantCallback(ShowLoginAssistantCallback callback) {
+  ShowCallback() = std::move(callback);
+}
+
+bool IsSiteRemembered(Profile* profile, const std::string& site) {
+  for (const base::Value& entry :
+       profile->GetPrefs()->GetList(kRememberedSitesPref)) {
+    if (!entry.is_string()) {
+      continue;
+    }
+    const std::string& text = entry.GetString();
+    const GURL url(text.find("://") == std::string::npos ? "https://" + text
+                                                          : text);
+    if (TemporarySiteDataService::SiteForUrl(url) == site) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void OnLoginDetected(content::WebContents* contents,
+                     const GURL& url,
+                     LoginKind kind) {
+  if (!contents) {
+    return;
+  }
+  // An external sign-in in a popup: the popup shows the provider, and the
+  // question goes to the tab that opened it, the one of the site.
+  const std::string site = TemporarySiteDataService::SiteForUrl(url);
+  if (TemporarySiteDataService::SiteForUrl(contents->GetLastCommittedURL()) !=
+      site) {
+    content::RenderFrameHost* opener = contents->GetOpener();
+    content::WebContents* opener_contents =
+        opener ? content::WebContents::FromRenderFrameHost(opener) : nullptr;
+    if (!opener_contents ||
+        TemporarySiteDataService::SiteForUrl(
+            opener_contents->GetLastCommittedURL()) != site) {
+      return;
+    }
+    contents = opener_contents;
+  }
+  LoginAssistantTabHelper::CreateForWebContents(contents);
+  LoginAssistantTabHelper::FromWebContents(contents)->OnLoginDetected(url,
+                                                                      kind);
+}
+
+LoginAssistantTabHelper::LoginAssistantTabHelper(content::WebContents* contents)
+    : content::WebContentsObserver(contents),
+      content::WebContentsUserData<LoginAssistantTabHelper>(*contents) {}
+
+LoginAssistantTabHelper::~LoginAssistantTabHelper() = default;
+
+Profile* LoginAssistantTabHelper::GetProfile() {
+  return Profile::FromBrowserContext(web_contents()->GetBrowserContext());
+}
+
+void LoginAssistantTabHelper::OnLoginDetected(const GURL& url, LoginKind kind) {
+  Profile* profile = GetProfile();
+  if (profile->IsOffTheRecord()) {
+    return;
+  }
+  // Only temporary cookies forget the sign-in when the site is left.
+  if (profile->GetPrefs()->GetInteger(kCookieModePref) !=
+      static_cast<int>(CookieMode::kTemporary)) {
+    return;
+  }
+  const std::string site = TemporarySiteDataService::SiteForUrl(url);
+  if (site.empty() || asked_.contains(site) ||
+      IsSiteRemembered(profile, site)) {
+    return;
+  }
+  for (const base::Value& entry :
+       profile->GetPrefs()->GetList(kLoginAssistantDeclinedPref)) {
+    if (entry.is_string() && entry.GetString() == site) {
+      return;
+    }
+  }
+  asked_.insert(site);
+  pending_site_ = site;
+  pending_url_ = url;
+  pending_kind_ = kind;
+  timer_.Start(FROM_HERE, kSettleDelay,
+               base::BindOnce(&LoginAssistantTabHelper::Evaluate,
+                              weak_factory_.GetWeakPtr()));
+}
+
+void LoginAssistantTabHelper::Evaluate() {
+  // The user went to another site in the meantime.
+  if (TemporarySiteDataService::SiteForUrl(
+          web_contents()->GetLastCommittedURL()) != pending_site_) {
+    return;
+  }
+  web_contents()
+      ->GetBrowserContext()
+      ->GetDefaultStoragePartition()
+      ->GetCookieManagerForBrowserProcess()
+      ->GetAllCookies(base::BindOnce(&LoginAssistantTabHelper::OnCookies,
+                                     weak_factory_.GetWeakPtr(),
+                                     pending_site_));
+}
+
+void LoginAssistantTabHelper::OnCookies(
+    const std::string& site,
+    const std::vector<net::CanonicalCookie>& cookies) {
+  if (site != pending_site_ || TemporarySiteDataService::SiteForUrl(
+                                   web_contents()->GetLastCommittedURL()) !=
+                                   site) {
+    return;
+  }
+  Profile* profile = GetProfile();
+  LoginAssessment assessment;
+  assessment.site = site;
+  assessment.kind = pending_kind_;
+
+  std::vector<LoginReason> bad, warn, good;
+
+  // 1. An address that imitates a known one: possibly a fake site.
+  bool lookalike = false;
+  if (std::optional<std::string> imitated = LookalikeOf(profile, pending_url_)) {
+    lookalike = true;
+    bad.push_back({l10n_util::GetStringFUTF16(IDS_FORK_LOGIN_REASON_LOOKALIKE,
+                                              base::UTF8ToUTF16(*imitated)),
+                   ReasonTone::kBad});
+  }
+
+  // 2. The site is also a tracking network present on many other sites: it can
+  // be remembered (here cookies stay separate per site), with care.
+  if (std::optional<std::string_view> company = TrackingCompany(site)) {
+    warn.push_back({l10n_util::GetStringFUTF16(
+                        IDS_FORK_LOGIN_REASON_TRACKER_NETWORK,
+                        base::UTF8ToUTF16(*company)),
+                    ReasonTone::kWarn});
+  }
+
+  // 3. The trackers that the page tried to load (blocked by uBlock Origin).
+  const int trackers = BlockedTrackers(profile, web_contents());
+  if (trackers == 0) {
+    good.push_back({l10n_util::GetStringUTF16(IDS_FORK_LOGIN_REASON_NO_TRACKERS),
+                    lookalike ? ReasonTone::kNeutral : ReasonTone::kGood});
+  } else {
+    LoginReason reason{
+        trackers == 1
+            ? l10n_util::GetStringUTF16(IDS_FORK_LOGIN_REASON_ONE_TRACKER)
+            : l10n_util::GetStringFUTF16(IDS_FORK_LOGIN_REASON_TRACKERS,
+                                         Count(trackers)),
+        trackers >= kManyTrackers ? ReasonTone::kWarn : ReasonTone::kNeutral};
+    (trackers >= kManyTrackers ? warn : good).push_back(std::move(reason));
+  }
+
+  // 4. The cookies the site saved, by kind.
+  int own = 0, analytics = 0, advertising = 0;
+  for (const net::CanonicalCookie& cookie : cookies) {
+    if (!CookieBelongsToSite(cookie, site)) {
+      continue;
+    }
+    switch (ClassifyCookie(cookie.Name(), site)) {
+      case CookieKind::kSite:
+        ++own;
+        break;
+      case CookieKind::kAnalytics:
+        ++analytics;
+        break;
+      case CookieKind::kAdvertising:
+        ++advertising;
+        break;
+    }
+  }
+  if (own + analytics + advertising == 0) {
+    good.push_back({l10n_util::GetStringUTF16(IDS_FORK_LOGIN_REASON_NO_COOKIES),
+                    ReasonTone::kNeutral});
+  } else {
+    std::vector<std::u16string> parts;
+    if (own) {
+      parts.push_back(
+          l10n_util::GetStringFUTF16(IDS_FORK_LOGIN_COOKIES_SITE, Count(own)));
+    }
+    if (analytics) {
+      parts.push_back(l10n_util::GetStringFUTF16(
+          IDS_FORK_LOGIN_COOKIES_ANALYTICS, Count(analytics)));
+    }
+    if (advertising) {
+      parts.push_back(
+          advertising == 1
+              ? l10n_util::GetStringUTF16(IDS_FORK_LOGIN_COOKIES_ONE_AD)
+              : l10n_util::GetStringFUTF16(IDS_FORK_LOGIN_COOKIES_ADS,
+                                           Count(advertising)));
+    } else {
+      parts.push_back(l10n_util::GetStringUTF16(IDS_FORK_LOGIN_COOKIES_NO_ADS));
+    }
+    LoginReason reason{
+        l10n_util::GetStringFUTF16(IDS_FORK_LOGIN_REASON_COOKIES,
+                                   base::JoinString(parts, u", ")),
+        advertising ? ReasonTone::kWarn : ReasonTone::kGood};
+    (advertising ? warn : good).push_back(std::move(reason));
+  }
+
+  if (!lookalike) {
+    good.push_back({l10n_util::GetStringUTF16(IDS_FORK_LOGIN_REASON_REGULAR),
+                    ReasonTone::kGood});
+  }
+
+  if (lookalike) {
+    assessment.verdict = LoginVerdict::kNotRecommended;
+  } else if (!warn.empty()) {
+    assessment.verdict = LoginVerdict::kCaution;
+  } else {
+    assessment.verdict = LoginVerdict::kSafe;
+  }
+  // The worst reasons first, as in the board.
+  for (auto* list : {&bad, &warn, &good}) {
+    std::ranges::move(*list, std::back_inserter(assessment.reasons));
+  }
+  assessment_ = std::move(assessment);
+
+  if (ShowCallback()) {
+    ShowCallback().Run(web_contents());
+  }
+}
+
+void LoginAssistantTabHelper::Remember() {
+  if (!assessment_) {
+    return;
+  }
+  Profile* profile = GetProfile();
+  if (!IsSiteRemembered(profile, assessment_->site)) {
+    ScopedListPrefUpdate update(profile->GetPrefs(), kRememberedSitesPref);
+    update->Append(assessment_->site);
+  }
+  assessment_.reset();
+}
+
+void LoginAssistantTabHelper::Decline() {
+  if (!assessment_) {
+    return;
+  }
+  ScopedListPrefUpdate update(GetProfile()->GetPrefs(),
+                              kLoginAssistantDeclinedPref);
+  update->Append(assessment_->site);
+  assessment_.reset();
+}
+
+void LoginAssistantTabHelper::Dismiss() {
+  assessment_.reset();
+}
+
+void LoginAssistantTabHelper::PrimaryPageChanged(content::Page& page) {
+  // A question about a site that is no longer in the tab is stale.
+  if (assessment_ && TemporarySiteDataService::SiteForUrl(
+                         page.GetMainDocument().GetLastCommittedURL()) !=
+                         assessment_->site) {
+    assessment_.reset();
+  }
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(LoginAssistantTabHelper);
+
+}  // namespace browser_fork

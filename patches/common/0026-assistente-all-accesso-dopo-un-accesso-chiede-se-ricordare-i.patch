+// The login assistant's bubble (login_assistant.html), on the same host as the
+// panel: what to answer about the sign-in in the active tab.
+class LoginAssistantHandler : public content::WebUIMessageHandler {
+ public:
+  LoginAssistantHandler() = default;
+  LoginAssistantHandler(const LoginAssistantHandler&) = delete;
+  LoginAssistantHandler& operator=(const LoginAssistantHandler&) = delete;
+  ~LoginAssistantHandler() override = default;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    const auto add = [this](const char* name,
+                            void (LoginAssistantHandler::*method)(
+                                const base::ListValue&)) {
+      web_ui()->RegisterMessageCallback(
+          name, base::BindRepeating(method, base::Unretained(this)));
+    };
+    add("loginReady", &LoginAssistantHandler::OnReady);
+    add("loginRemember", &LoginAssistantHandler::OnRemember);
+    add("loginDecline", &LoginAssistantHandler::OnDecline);
+    add("loginClose", &LoginAssistantHandler::OnClose);
+  }
+
+ private:
+  browser_fork::LoginAssistantTabHelper* GetHelper() {
+    BrowserWindowInterface* browser =
+        webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+    tabs::TabInterface* tab =
+        browser ? browser->GetActiveTabInterface() : nullptr;
+    content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+    return contents
+               ? browser_fork::LoginAssistantTabHelper::FromWebContents(contents)
+               : nullptr;
+  }
+
+  void Close() {
+    if (auto embedder =
+            web_ui()->GetController()->GetAs<SitePanelUI>()->embedder()) {
+      embedder->CloseUI();
+    }
+  }
+
+  static const char* Tone(browser_fork::ReasonTone tone) {
+    switch (tone) {
+      case browser_fork::ReasonTone::kGood:
+        return "good";
+      case browser_fork::ReasonTone::kWarn:
+        return "warn";
+      case browser_fork::ReasonTone::kBad:
+        return "bad";
+      case browser_fork::ReasonTone::kNeutral:
+        return "neutral";
+    }
+  }
+
+  void OnReady(const base::ListValue& args) {
+    browser_fork::LoginAssistantTabHelper* helper = GetHelper();
+    if (!helper || !helper->assessment()) {
+      Close();
+      return;
+    }
+    const browser_fork::LoginAssessment& assessment = *helper->assessment();
+    base::DictValue state;
+    state.Set("site", assessment.site);
+    switch (assessment.verdict) {
+      case browser_fork::LoginVerdict::kSafe:
+        state.Set("verdict", "safe");
+        state.Set("verdictText",
+                  l10n_util::GetStringUTF16(IDS_FORK_LOGIN_VERDICT_SAFE));
+        break;
+      case browser_fork::LoginVerdict::kCaution:
+        state.Set("verdict", "caution");
+        state.Set("verdictText",
+                  l10n_util::GetStringUTF16(IDS_FORK_LOGIN_VERDICT_CAUTION));
+        break;
+      case browser_fork::LoginVerdict::kNotRecommended:
+        state.Set("verdict", "bad");
+        state.Set("verdictText", l10n_util::GetStringUTF16(
+                                     IDS_FORK_LOGIN_VERDICT_NOT_RECOMMENDED));
+        break;
+    }
+    base::ListValue reasons;
+    for (const browser_fork::LoginReason& reason : assessment.reasons) {
+      base::DictValue entry;
+      entry.Set("text", reason.text);
+      entry.Set("tone", Tone(reason.tone));
+      reasons.Append(std::move(entry));
+    }
+    state.Set("reasons", std::move(reasons));
+    AllowJavascript();
+    web_ui()->CallJavascriptFunctionUnsafe("LoginAssistant.loaded", state);
+    if (auto embedder =
+            web_ui()->GetController()->GetAs<SitePanelUI>()->embedder()) {
+      embedder->ShowUI();
+    }
+  }
+
+  void OnRemember(const base::ListValue& args) {
+    if (browser_fork::LoginAssistantTabHelper* helper = GetHelper()) {
+      helper->Remember();
+    }
+    Close();
+  }
+
+  void OnDecline(const base::ListValue& args) {
+    if (browser_fork::LoginAssistantTabHelper* helper = GetHelper()) {
+      helper->Decline();
+    }
+    Close();
+  }
+
+  void OnClose(const base::ListValue& args) {
+    if (browser_fork::LoginAssistantTabHelper* helper = GetHelper()) {
+      helper->Dismiss();
+    }
+    Close();
+  }
+};
+
 }  // namespace
 
 SitePanelUI::SitePanelUI(content::WebUI* web_ui)
     : TopChromeWebUIController(web_ui, /*enable_chrome_send=*/true) {
   web_ui->AddMessageHandler(std::make_unique<SitePanelHandler>());

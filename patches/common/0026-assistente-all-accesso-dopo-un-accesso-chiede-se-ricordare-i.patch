+
+class Profile;
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}
+
+namespace browser_fork {
+
+// The login assistant: with temporary cookies, after a successful sign-in on a
+// site that is not remembered, a bubble from the shield asks whether to stay
+// signed in there, with a verdict computed locally (ROADMAP, section 10).
+
+// The sites where the user answered "Don't remember": the bubble does not come
+// back there. "Remember this site" in the site panel still works.
+inline constexpr char kLoginAssistantDeclinedPref[] =
+    "fork.login_assistant_declined";
+
+void RegisterLoginAssistantPrefs(user_prefs::PrefRegistrySyncable* registry);
+
+enum class LoginKind {
+  kPassword,         // The password manager saw the form go through.
+  kExternalAccount,  // Back from an OAuth sign-in (Google, Apple...).
+  kPasskey,          // WebAuthn assertion.
+};
+
+enum class LoginVerdict {
+  kSafe,
+  kCaution,
+  kNotRecommended,
+};
+
+enum class ReasonTone {
+  kGood,
+  kWarn,
+  kBad,
+  kNeutral,
+};
+
+struct LoginReason {
+  std::u16string text;
+  ReasonTone tone;
+};
+
+struct LoginAssessment {
+  LoginAssessment();
+  LoginAssessment(const LoginAssessment&);
+  ~LoginAssessment();
+
+  std::string site;
+  LoginKind kind = LoginKind::kPassword;
+  LoginVerdict verdict = LoginVerdict::kSafe;
+  std::vector<LoginReason> reasons;
+};
+
+// From the sign-in hooks (password manager, login detection, WebAuthn).
+// `contents` can be a popup: then the tab that opened it is used.
+void OnLoginDetected(content::WebContents* contents,
+                     const GURL& url,
+                     LoginKind kind);
+
+// The browser window shows the bubble for `contents`, its active tab. Set by
+// the views code, which the browser code cannot include.
+using ShowLoginAssistantCallback =
+    base::RepeatingCallback<void(content::WebContents*)>;
+void SetShowLoginAssistantCallback(ShowLoginAssistantCallback callback);
+
+// Whether `site` is in the remembered sites (entries can be full addresses).
+bool IsSiteRemembered(Profile* profile, const std::string& site);
+
+class LoginAssistantTabHelper
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<LoginAssistantTabHelper> {
+ public:
+  LoginAssistantTabHelper(const LoginAssistantTabHelper&) = delete;
+  LoginAssistantTabHelper& operator=(const LoginAssistantTabHelper&) = delete;
+  ~LoginAssistantTabHelper() override;
+
+  void OnLoginDetected(const GURL& url, LoginKind kind);
+
+  // What the bubble shows; empty when there is nothing to ask.
+  const std::optional<LoginAssessment>& assessment() const {
+    return assessment_;
+  }
+
+  // The answers in the bubble.
+  void Remember();
+  void Decline();
+  void Dismiss();
+
+ private:
+  friend class content::WebContentsUserData<LoginAssistantTabHelper>;
+  explicit LoginAssistantTabHelper(content::WebContents* contents);
+
+  Profile* GetProfile();
+  void Evaluate();
+  void OnCookies(const std::string& site,
+                 const std::vector<net::CanonicalCookie>& cookies);
+
+  // content::WebContentsObserver:
+  void PrimaryPageChanged(content::Page& page) override;
+
+  std::string pending_site_;
+  GURL pending_url_;
+  LoginKind pending_kind_ = LoginKind::kPassword;
+  base::OneShotTimer timer_;
+  // Asked once per tab and site: several hooks can see the same sign-in.
+  std::set<std::string> asked_;
+  std::optional<LoginAssessment> assessment_;
+  base::WeakPtrFactory<LoginAssistantTabHelper> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace browser_fork

+#ifndef CHROME_BROWSER_FORK_LOGIN_ASSISTANT_H_
+#define CHROME_BROWSER_FORK_LOGIN_ASSISTANT_H_
+
+#include <optional>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "content/public/browser/web_contents_observer.h"

+#panel { box-sizing: border-box; padding: 14px; display: flex; flex-direction: column; gap: 12px; }
+header { display: flex; align-items: flex-start; gap: 10px; }
+header > div { flex: 1; min-width: 0; }
+h1 { margin: 0; font-size: 15px; font-weight: 600; }
+#subtitle { margin-top: 2px; font-size: 12px; color: var(--sub); overflow-wrap: anywhere; }
+#subtitle strong { color: var(--text); font-weight: 600; }
+#close { width: 24px; height: 24px; flex-shrink: 0; border: 0; border-radius: 12px; background: var(--field); color: var(--sub); display: flex; align-items: center; justify-content: center; padding: 0; }
+#verdict { padding: 8px 10px; border-radius: 10px; font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
+#verdict span { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; background: currentColor; }

+<!doctype html>
+<html dir="$i18n{textdirection}" lang="$i18n{language}">
+<head>
+<meta charset="utf-8">
+<title>$i18n{forkLoginPanelLabel}</title>
+<style>
+:root {
+  --text: #1d1d1f; --sub: #5a5a60; --field: rgba(0,0,0,0.07); --sep: rgba(0,0,0,0.12);
+  --panel: #fafafc; --group: rgba(0,0,0,0.04); --accent: #0066d6; --on-accent: #ffffff;
+  --green: #157038; --green-bg: rgba(21,112,56,0.13); --orange: #9a4f00; --orange-bg: rgba(201,105,0,0.15);
+  --red: #c4001a; --red-bg: rgba(196,0,26,0.11); --grey: #8a8a90;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --text: #f5f5f7; --sub: #b3b3ba; --field: rgba(255,255,255,0.1); --sep: rgba(255,255,255,0.12);
+    --panel: #28282c; --group: rgba(255,255,255,0.05); --accent: #5aa9ff; --on-accent: #0b0b0d;
+    --green: #4cd27f; --green-bg: rgba(76,210,127,0.15); --orange: #ffad33; --orange-bg: rgba(255,173,51,0.15);
+    --red: #ff6b6b; --red-bg: rgba(255,107,107,0.15); --grey: #8a8a90;

--- /dev/null
+++ b/chrome/browser/resources/login_assistant.js
@@ -0,0 +1,70 @@
+import {loadTimeData} from 'chrome://resources/js/load_time_data.js';
+
+import './strings.m.js';
+
+// The login assistant's bubble, as in the board "Fumetto Ricorda".
+window.LoginAssistant = (function() {
+  'use strict';
+
+  const $ = (id) => document.getElementById(id);
+
+  // "You just signed in to $1", with the site in bold wherever it falls.
+  function subtitle(site) {
+    const parts = loadTimeData.getString('forkLoginSubtitle').split('$1');
+    const box = $('subtitle');
+    box.textContent = '';
+    parts.forEach((text, i) => {
+      if (i) {
+        const strong = document.createElement('strong');
+        strong.textContent = site;
+        box.appendChild(strong);
+      }
+      box.appendChild(document.createTextNode(text));
+    });
+  }
+
+  function loaded(s) {
+    subtitle(s.site);
+    $('verdict').className = s.verdict;
+    $('verdict-text').textContent = s.verdictText;
+    const list = $('reasons');
+    list.textContent = '';
+    for (const r of s.reasons) {
+      const row = document.createElement('div');
+      row.className = 'reason';
+      const dot = document.createElement('i');
+      dot.className = r.tone;
+      dot.setAttribute('aria-hidden', 'true');
+      const text = document.createElement('span');
+      text.textContent = r.text;
+      row.append(dot, text);
+      list.appendChild(row);
+    }
+    const bad = s.verdict === 'bad';
+    $('note').textContent = loadTimeData.getString(
+        bad ? 'forkLoginNoteNotRecommended' : 'forkLoginNoteRemember');
+    // Not recommended: "Don't remember" becomes the main button.
+    const left = $('left');
+    const right = $('right');
+    left.textContent = loadTimeData.getString(bad ? 'forkLoginRememberAnyway' : 'forkLoginDontRemember');
+    left.className = bad ? 'secondary danger' : 'secondary';
+    left.onclick = () => chrome.send(bad ? 'loginRemember' : 'loginDecline');
+    right.textContent = loadTimeData.getString(bad ? 'forkLoginDontRemember' : 'forkLoginRemember');
+    right.className = 'primary';
+    right.onclick = () => chrome.send(bad ? 'loginDecline' : 'loginRemember');
+  }
+
+  document.addEventListener('DOMContentLoaded', () => {
+    $('close').onclick = () => chrome.send('loginClose');
+    chrome.send('loginReady');
+  });
+
+  // The bubble stays in memory for a while: when it comes back, ask again.
+  document.addEventListener('visibilitychange', () => {
+    if (document.visibilityState === 'visible') {
+      chrome.send('loginReady');
+    }
+  });
+
+  return {loaded};
+})();

 FingerprintingCounter::FingerprintingCounter(content::Page& page)
@@ -243,6 +262,41 @@ int FingerprintingCounter::GetBlocked(content::WebContents* contents) {
   return blocked;
 }
 
+// static
+std::string FingerprintingCounter::GetPreview(content::WebContents* contents,
+                                              bool webgl) {
+  FingerprintingCounter* counter =
+      contents ? GetForPage(contents->GetPrimaryPage()) : nullptr;
+  if (!counter) {
+    return std::string();
+  }
+  return webgl ? counter->webgl_preview_ : counter->canvas_preview_;
+}
+
+// static
+void FingerprintingCounter::SetPreview(
+    content::RenderFrameHost* render_frame_host,
+    bool webgl,
+    const std::vector<uint8_t>& png) {
+  // A small PNG, nothing else: it comes from the page's process.
+  static constexpr uint8_t kSignature[] = {0x89, 'P', 'N', 'G',
+                                           '\r', '\n', 0x1a, '\n'};
+  if (!render_frame_host || png.size() > 256 * 1024 ||
+      png.size() < sizeof(kSignature) ||
+      !std::equal(std::begin(kSignature), std::end(kSignature),
+                  png.begin())) {
+    return;
+  }
+  content::Page& page = render_frame_host->GetOutermostMainFrame()->GetPage();
+  FingerprintingCounter* counter = GetOrCreateForPage(page);
+  (webgl ? counter->webgl_preview_ : counter->canvas_preview_) =
+      "data:image/png;base64," + base::Base64Encode(png);
+  if (page.IsPrimary()) {
+    GetCallbacks().Notify(
+        content::WebContents::FromRenderFrameHost(render_frame_host));
+  }
+}
+
 // static
 base::CallbackListSubscription FingerprintingCounter::RegisterChangedCallback(
     base::RepeatingCallback<void(content::WebContents*)> callback) {
@@ -254,6 +308,14 @@ CreateFingerprintingObserver() {

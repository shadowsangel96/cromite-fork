+// To the browser, for the panel of the page whose script read the image.
+void SendPreviewOfRunningScript(bool webgl, base::span<const uint8_t> png) {
+  v8::Isolate* isolate = v8::Isolate::TryGetCurrent();
+  if (!isolate || !isolate->InContext()) {
+    return;
+  }
+  auto* window = DynamicTo<LocalDOMWindow>(
+      ExecutionContext::From(isolate->GetCurrentContext()));
+  if (!window || !window->GetFrame()) {
+    return;
+  }
+  mojo::Remote<mojom::blink::FarblingPreviewHost> host;
+  window->GetFrame()->GetBrowserInterfaceBroker().GetInterface(
+      host.BindNewPipeAndPassReceiver());
+  host->ReportImage(webgl, Vector<uint8_t>(png));
+}
+
 }  // namespace
 

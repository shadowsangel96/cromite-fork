+class FarblingPreviewHostImpl : public blink::mojom::FarblingPreviewHost {
+ public:
+  explicit FarblingPreviewHostImpl(content::GlobalRenderFrameHostId frame)
+      : frame_(frame) {}
+
+  // blink::mojom::FarblingPreviewHost:
+  void ReportImage(bool webgl, const std::vector<uint8_t>& png) override {
+    FingerprintingCounter::SetPreview(content::RenderFrameHost::FromID(frame_),
+                                      webgl, png);
+  }

 }
 
+void BindFarblingPreviewHost(
+    content::RenderFrameHost* render_frame_host,
+    mojo::PendingReceiver<blink::mojom::FarblingPreviewHost> receiver) {
+  mojo::MakeSelfOwnedReceiver(std::make_unique<FarblingPreviewHostImpl>(
+                                  render_frame_host->GetGlobalId()),
+                              std::move(receiver));
+}
+
 PAGE_USER_DATA_KEY_IMPL(FingerprintingCounter);
 

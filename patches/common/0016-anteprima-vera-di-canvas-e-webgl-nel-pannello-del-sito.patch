@@ -86,6 +107,7 @@ uint64_t FarblingSeed(ExecutionContext* context) {
 
 void InstallFarblingSeedProvider() {
   SetFarblingSeedProvider(&SeedOfRunningScript);
+  SetFarblingPreviewSink(&SendPreviewOfRunningScript);
 }
 
 }  // namespace blink

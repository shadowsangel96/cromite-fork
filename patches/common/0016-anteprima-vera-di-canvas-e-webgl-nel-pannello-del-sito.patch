 namespace blink {
 
 namespace {
 
 std::atomic<FarblingSeedProvider> g_provider{nullptr};
+std::atomic<FarblingPreviewSink> g_preview_sink{nullptr};
+
+// As big as the image of the panel.
+constexpr int kPreviewWidth = 320;
+constexpr int kPreviewHeight = 128;
 
 constinit thread_local bool g_has_scoped_seed = false;
 constinit thread_local uint64_t g_scoped_seed = 0;
@@ -46,6 +60,55 @@ ScopedFarblingSeed::~ScopedFarblingSeed() {
   g_scoped_seed = previous_seed_;
 }
 
+void SetFarblingPreviewSink(FarblingPreviewSink sink) {
+  g_preview_sink.store(sink);
+}
+
+void ReportFarbledImage(const SkPixmap& pixmap, bool webgl, bool flip_y) {
+  FarblingPreviewSink sink = g_preview_sink.load();
+  if (!sink || !IsMainThread() || pixmap.width() < 8 || pixmap.height() < 8) {
+    return;
+  }
+  // Twice a second at most, so a page that reads in a loop doesn't pay for
+  // it.
+  static base::TimeTicks last_canvas;
+  static base::TimeTicks last_webgl;
+  base::TimeTicks& last = webgl ? last_webgl : last_canvas;
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (!last.is_null() && now - last < base::Milliseconds(500)) {
+    return;
+  }
+  last = now;
+
+  const double scale = std::min(
+      {1.0, static_cast<double>(kPreviewWidth) / pixmap.width(),
+       static_cast<double>(kPreviewHeight) / pixmap.height()});
+  const int width = std::max(1, static_cast<int>(pixmap.width() * scale));
+  const int height = std::max(1, static_cast<int>(pixmap.height() * scale));
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(SkImageInfo::MakeN32Premul(width, height))) {
+    return;
+  }
+  sk_sp<SkImage> image = SkImages::RasterFromPixmapCopy(pixmap);
+  if (!image) {
+    return;
+  }
+  SkCanvas canvas(bitmap);
+  canvas.clear(SK_ColorTRANSPARENT);
+  if (flip_y) {
+    canvas.translate(0, height);
+    canvas.scale(1, -1);
+  }
+  canvas.drawImageRect(image, SkRect::MakeIWH(width, height),
+                       SkSamplingOptions(SkFilterMode::kLinear));
+  Vector<unsigned char> png;
+  if (!ImageEncoder::Encode(&png, bitmap.pixmap(),
+                            SkPngRustEncoder::CompressionLevel::kLow)) {
+    return;
+  }
+  sink(webgl, base::span(png));
+}

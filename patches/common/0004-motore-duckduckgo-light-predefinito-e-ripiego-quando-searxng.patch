 constexpr char kPersonalSearchPath[] = "/search?q={searchTerms}";
 
+// HTTPS-only mode would block the engine: a server at home usually has plain
+// http, on an address no certificate can cover.
+void AllowHttpForPersonalSearch(PrefService* prefs,
+                                const std::string& old_host,
+                                const GURL& url) {
+  base::ListValue hosts = prefs->GetList(prefs::kHttpAllowlist).Clone();
+  if (!old_host.empty()) {
+    hosts.EraseValue(base::Value(old_host));
+  }
+  if (url.is_valid() && url.SchemeIs(url::kHttpScheme)) {
+    hosts.Append(std::string(url.host()));
+  }
+  prefs->SetList(prefs::kHttpAllowlist, std::move(hosts));
+}
+
 }  // namespace
 

new file mode 100644
index 0000000000000000000000000000000000000000..ad08b23f0f8906a07e6658253ad75d8d9edef3d2
--- /dev/null
+++ b/chrome/browser/fork/personal_search.h
@@ -0,0 +1,13 @@
+#ifndef CHROME_BROWSER_FORK_PERSONAL_SEARCH_H_
+#define CHROME_BROWSER_FORK_PERSONAL_SEARCH_H_
+
+namespace browser_fork {
+
+// The engine on the user's own server, and where a search goes when it doesn't
+// answer.
+inline constexpr char16_t kPersonalSearchKeyword[] = u"searxng";
+inline constexpr char16_t kSearchFallbackKeyword[] = u"duckduckgo.com/lite";
+
+}  // namespace browser_fork
+
+#endif  // CHROME_BROWSER_FORK_PERSONAL_SEARCH_H_
diff --git a/chrome/browser/fork/personal_search_tab_helper.cc b/chrome/browser/fork/personal_search_tab_helper.cc
new file mode 100644
index 0000000000000000000000000000000000000000..7b3516d11ac09791913fb5f5b27661ac496d81ac
--- /dev/null
+++ b/chrome/browser/fork/personal_search_tab_helper.cc
@@ -0,0 +1,132 @@
+#include "chrome/browser/fork/personal_search_tab_helper.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "chrome/browser/fork/personal_search.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/search_engines/template_url_service_factory.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_service.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/net_errors.h"
+#include "ui/base/page_transition_types.h"
+#include "url/gurl.h"
+
+namespace browser_fork {
+
+namespace {
+
+// Longer than the 3 seconds SearXNG gives the engines it asks.
+constexpr base::TimeDelta kAnswerTimeout = base::Seconds(8);
+
+// The server can't be reached or isn't working. Not a page blocked by the
+// browser, and not a VPN that is down: the other engine can't be reached either
+// then, and the error page is the one that tells why.
+bool ServerDidNotAnswer(net::Error error) {
+  switch (error) {
+    case net::ERR_ADDRESS_UNREACHABLE:
+    case net::ERR_CONNECTION_CLOSED:
+    case net::ERR_CONNECTION_FAILED:
+    case net::ERR_CONNECTION_REFUSED:
+    case net::ERR_CONNECTION_RESET:
+    case net::ERR_CONNECTION_TIMED_OUT:
+    case net::ERR_EMPTY_RESPONSE:
+    case net::ERR_HTTP_RESPONSE_CODE_FAILURE:
+    case net::ERR_INTERNET_DISCONNECTED:
+    case net::ERR_NAME_NOT_RESOLVED:
+    case net::ERR_NETWORK_CHANGED:
+    case net::ERR_TIMED_OUT:
+      return true;
+    default:
+      return false;
+  }
+}
+
+TemplateURLService* SearchService(content::WebContents* web_contents) {
+  TemplateURLService* service = TemplateURLServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(web_contents->GetBrowserContext()));
+  return service && service->loaded() ? service : nullptr;
+}
+
+}  // namespace
+
+PersonalSearchTabHelper::PersonalSearchTabHelper(
+    content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<PersonalSearchTabHelper>(*web_contents) {}
+
+PersonalSearchTabHelper::~PersonalSearchTabHelper() = default;
+
+void PersonalSearchTabHelper::DidStartNavigation(
+    content::NavigationHandle* handle) {
+  if (!handle->IsInPrimaryMainFrame() || handle->IsSameDocument()) {
+    return;
+  }
+  navigation_id_ = 0;
+  terms_.clear();
+  timeout_.Stop();
+
+  TemplateURLService* service = SearchService(web_contents());
+  const TemplateURL* personal =
+      service ? service->GetTemplateURLForKeyword(kPersonalSearchKeyword)
+              : nullptr;
+  std::u16string terms;
+  if (!personal ||
+      !personal->ExtractSearchTermsFromURL(
+          handle->GetURL(), service->search_terms_data(), &terms) ||
+      terms.empty()) {
+    return;
+  }
+  navigation_id_ = handle->GetNavigationId();
+  terms_ = std::move(terms);
+  timeout_.Start(FROM_HERE, kAnswerTimeout,
+                 base::BindOnce(&PersonalSearchTabHelper::SearchWithFallback,
+                                weak_factory_.GetWeakPtr(),
+                                /*replace_current_entry=*/false));
+}
+
+void PersonalSearchTabHelper::DidFinishNavigation(
+    content::NavigationHandle* handle) {
+  if (!navigation_id_ || handle->GetNavigationId() != navigation_id_) {
+    return;
+  }
+  navigation_id_ = 0;
+  timeout_.Stop();
+  if (!ServerDidNotAnswer(handle->GetNetErrorCode())) {
+    terms_.clear();
+    return;
+  }
+  // Not from inside the callback of a navigation.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&PersonalSearchTabHelper::SearchWithFallback,
+                                weak_factory_.GetWeakPtr(),
+                                /*replace_current_entry=*/handle->HasCommitted()));
+}
+
+void PersonalSearchTabHelper::SearchWithFallback(bool replace_current_entry) {
+  navigation_id_ = 0;
+  const std::u16string terms = std::exchange(terms_, std::u16string());
+  TemplateURLService* service = SearchService(web_contents());
+  const TemplateURL* fallback =
+      service ? service->GetTemplateURLForKeyword(kSearchFallbackKeyword)
+              : nullptr;
+  if (!fallback || terms.empty()) {
+    return;
+  }
+  content::NavigationController::LoadURLParams params(
+      GURL(fallback->url_ref().ReplaceSearchTerms(
+          TemplateURLRef::SearchTermsArgs(terms),
+          service->search_terms_data())));
+  params.transition_type = ui::PAGE_TRANSITION_GENERATED;
+  params.should_replace_current_entry = replace_current_entry;
+  web_contents()->GetController().LoadURLWithParams(params);
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(PersonalSearchTabHelper);
+
+}  // namespace browser_fork
diff --git a/chrome/browser/fork/personal_search_tab_helper.h b/chrome/browser/fork/personal_search_tab_helper.h
new file mode 100644
index 0000000000000000000000000000000000000000..c0340d180910cb15bbb4cab0e07a89004522caa6
--- /dev/null
+++ b/chrome/browser/fork/personal_search_tab_helper.h
@@ -0,0 +1,45 @@
+#ifndef CHROME_BROWSER_FORK_PERSONAL_SEARCH_TAB_HELPER_H_
+#define CHROME_BROWSER_FORK_PERSONAL_SEARCH_TAB_HELPER_H_
+
+#include <cstdint>
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace browser_fork {
+
+// When the personal search engine doesn't answer, repeats the search on the
+// fallback engine: away from home the server may be out of reach.
+class PersonalSearchTabHelper
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<PersonalSearchTabHelper> {
+ public:
+  ~PersonalSearchTabHelper() override;
+
+ private:
+  friend class content::WebContentsUserData<PersonalSearchTabHelper>;
+
+  explicit PersonalSearchTabHelper(content::WebContents* web_contents);
+
+  // content::WebContentsObserver:
+  void DidStartNavigation(content::NavigationHandle* handle) override;
+  void DidFinishNavigation(content::NavigationHandle* handle) override;
+
+  void SearchWithFallback(bool replace_current_entry);
+
+  // The search waiting for an answer; 0 when there is none.
+  int64_t navigation_id_ = 0;
+  std::u16string terms_;
+  base::OneShotTimer timeout_;
+
+  base::WeakPtrFactory<PersonalSearchTabHelper> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace browser_fork
+
+#endif  // CHROME_BROWSER_FORK_PERSONAL_SEARCH_TAB_HELPER_H_

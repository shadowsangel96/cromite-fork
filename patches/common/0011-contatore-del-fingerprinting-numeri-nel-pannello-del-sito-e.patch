     $('route').className = s.route;
     $('route-text').textContent = routeText(s);
-    $('webgl-chip').className = 'chip ' + (s.webgl ? 'uni' : 'block');
-    $('webgl-chip').textContent = s.webgl ? 'Consentito' : 'Bloccato';
+    showFingerprinting(s);
     $('webgl-on').hidden = !s.webgl;
     $('webgl-off').hidden = s.webgl;

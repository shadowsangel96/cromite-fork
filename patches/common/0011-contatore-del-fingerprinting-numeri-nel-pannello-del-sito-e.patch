+namespace {
+
+// The shield of the boards: a 30x26 capsule with a 14 dp badge that sticks out
+// 3 dp at the top right. The image is as tall as the bar, so the badge fits.
+constexpr int kShieldCapsuleWidth = 30;
+constexpr int kShieldCapsuleHeight = 26;
+constexpr int kShieldBadgeHeight = 14;
+constexpr int kShieldBadgeOverhang = 3;
+constexpr int kShieldIconSize = 15;
+
+class ShieldImageSource : public gfx::CanvasImageSource {
+ public:
+  // With nothing blocked on the page, the shield alone in `plain_color`.
+  ShieldImageSource(int blocked, bool dark, SkColor plain_color)
+      : gfx::CanvasImageSource(
+            gfx::Size(kShieldCapsuleWidth + kShieldBadgeOverhang + 2,
+                      kShieldCapsuleHeight + 2 * (kShieldBadgeOverhang + 1))),
+        blocked_(blocked),
+        dark_(dark),
+        plain_color_(plain_color) {}
+
+  // gfx::CanvasImageSource:
+  void Draw(gfx::Canvas* canvas) override {
+    const SkColor accent =
+        dark_ ? SkColorSetRGB(0x5a, 0xa9, 0xff) : SkColorSetRGB(0x00, 0x66, 0xd6);
+    const gfx::Rect capsule(0, kShieldBadgeOverhang + 1, kShieldCapsuleWidth,
+                            kShieldCapsuleHeight);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    if (blocked_ > 0) {
+      flags.setColor(SkColorSetA(accent, dark_ ? 41 : 31));
+      canvas->DrawRoundRect(capsule, kShieldCapsuleHeight / 2, flags);
+    }
+    canvas->DrawImageInt(
+        gfx::CreateVectorIcon(vector_icons::kShieldIcon, kShieldIconSize,
+                              blocked_ > 0 ? accent : plain_color_),
+        capsule.x() + (capsule.width() - kShieldIconSize) / 2,
+        capsule.y() + (capsule.height() - kShieldIconSize) / 2);
+    if (blocked_ <= 0) {
+      return;
+    }
+
+    const std::u16string text =
+        blocked_ > 99 ? u"99+" : base::NumberToString16(blocked_);
+    const gfx::FontList font =
+        gfx::FontList()
+            .DeriveWithSizeDelta(9 - gfx::FontList().GetFontSize())
+            .DeriveWithWeight(gfx::Font::Weight::BOLD);
+    const int badge_width =
+        std::max(kShieldBadgeHeight, gfx::GetStringWidth(text, font) + 6);
+    const gfx::Rect badge(
+        capsule.right() + kShieldBadgeOverhang - badge_width,
+        capsule.y() - kShieldBadgeOverhang, badge_width, kShieldBadgeHeight);
+    gfx::RectF ring(badge);
+    ring.Outset(1.5f);
+    flags.setColor(dark_ ? SkColorSetRGB(0x2a, 0x2a, 0x2e) : SK_ColorWHITE);
+    canvas->DrawRoundRect(ring, ring.height() / 2, flags);
+    flags.setColor(accent);
+    canvas->DrawRoundRect(badge, kShieldBadgeHeight / 2, flags);
+    canvas->DrawStringRectWithFlags(
+        text, font, dark_ ? SkColorSetRGB(0x0b, 0x1a, 0x2b) : SK_ColorWHITE,
+        badge, gfx::Canvas::TEXT_ALIGN_CENTER);
+  }
+
+ private:
+  const int blocked_;
+  const bool dark_;
+  const SkColor plain_color_;
+};
+
+// What the boards say for the shield with its number.

diff --git a/chrome/browser/fork/fingerprinting_counter.cc b/chrome/browser/fork/fingerprinting_counter.cc
new file mode 100644
index 0000000000000000000000000000000000000000..0c8c566dcb29a55a076a127c4905e295cefec04c
--- /dev/null
+++ b/chrome/browser/fork/fingerprinting_counter.cc
@@ -0,0 +1,258 @@
+#include "chrome/browser/fork/fingerprinting_counter.h"
+
+#include <iterator>
+#include <optional>
+
+#include "base/no_destructor.h"
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/common/content_settings.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "components/page_load_metrics/browser/page_load_metrics_observer.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/blink/public/mojom/use_counter/metrics/web_feature.mojom-shared.h"
+#include "third_party/blink/public/mojom/use_counter/use_counter_feature.mojom-shared.h"
+#include "url/gurl.h"
+
+namespace browser_fork {
+
+namespace {
+
+using blink::mojom::WebFeature;
+
+struct Category {
+  const char* name;
+  FingerprintingAnswer answer;
+};
+
+// The categories of the boards, in their order, with what the browser answers
+// by default: the noise of Cromite on canvas, text sizes, rects and audio,
+// WebGL off until the site is allowed, WebGPU off, fixed battery values, no
+// local addresses through WebRTC. The time zone stays the real one unless it
+// is changed in the settings of the site.
+constexpr Category kCategories[] = {
+    {"Canvas", FingerprintingAnswer::kRandomized},
+    {"WebGL", FingerprintingAnswer::kBlocked},
+    {"Audio", FingerprintingAnswer::kRandomized},
+    {"Font", FingerprintingAnswer::kRandomized},
+    {"Schermo", FingerprintingAnswer::kRandomized},
+    {"Navigator e Client Hints", FingerprintingAnswer::kUniform},
+    {"WebGPU", FingerprintingAnswer::kBlocked},
+    {"ClientRects", FingerprintingAnswer::kRandomized},
+    {"Fuso orario", FingerprintingAnswer::kAllowed},
+    {"WebRTC", FingerprintingAnswer::kLimited},
+    {"Storage", FingerprintingAnswer::kAllowed},
+    {"Permessi", FingerprintingAnswer::kAllowed},
+    {"Batteria", FingerprintingAnswer::kUniform},
+    {"eval", FingerprintingAnswer::kNotCounted},
+    {"Referrer", FingerprintingAnswer::kNotCounted},
+};
+static_assert(std::size(kCategories) == FingerprintingCounter::kCategoryCount);
+
+constexpr size_t kWebGL = 1;
+
+// The APIs that tell a device apart, as the use counters of Blink name them.
+std::optional<size_t> CategoryOf(WebFeature feature) {
+  switch (feature) {
+    case WebFeature::kCanvasToDataURL:
+    case WebFeature::kCanvasToBlob:
+    case WebFeature::kOffscreenCanvasConvertToBlob:
+    case WebFeature::kCanvas2DGetImageData:
+      return 0;
+    // A WebGL context also counts when it is refused.
+    case WebFeature::kHTMLCanvasElement_WebGL:
+    case WebFeature::kHTMLCanvasElement_WebGL2:
+    case WebFeature::kOffscreenCanvas_WebGL:
+    case WebFeature::kOffscreenCanvas_WebGL2:
+    case WebFeature::kWebGLRenderingContextGetParameter:
+    case WebFeature::kWebGLDebugRendererInfo:
+    case WebFeature::kWebGLRenderingContextGetShaderPrecisionFormat:
+    case WebFeature::kV8WebGLRenderingContext_GetSupportedExtensions_Method:
+    case WebFeature::kV8WebGL2RenderingContext_GetSupportedExtensions_Method:
+      return 1;
+    case WebFeature::kAudioContextCreateAnalyser:
+    case WebFeature::kV8AnalyserNode_GetFloatFrequencyData_Method:
+    case WebFeature::kV8AnalyserNode_GetFloatTimeDomainData_Method:
+    case WebFeature::kV8AnalyserNode_GetByteFrequencyData_Method:
+    case WebFeature::kV8AnalyserNode_GetByteTimeDomainData_Method:
+    case WebFeature::kV8AudioBuffer_GetChannelData_Method:
+    case WebFeature::kOfflineAudioContextStartRendering:
+    case WebFeature::kAudioContextBaseLatency:
+    case WebFeature::kAudioContextOutputLatency:
+      return 2;
+    case WebFeature::kCanvas2DMeasureText:
+    case WebFeature::kV8Window_QueryLocalFonts_Method:
+      return 3;
+    case WebFeature::kV8Screen_Width_AttributeGetter:
+    case WebFeature::kV8Screen_Height_AttributeGetter:
+    case WebFeature::kV8Screen_AvailWidth_AttributeGetter:
+    case WebFeature::kV8Screen_AvailHeight_AttributeGetter:
+    case WebFeature::kV8Screen_AvailLeft_AttributeGetter:
+    case WebFeature::kV8Screen_AvailTop_AttributeGetter:
+    case WebFeature::kV8Screen_ColorDepth_AttributeGetter:
+    case WebFeature::kV8Screen_PixelDepth_AttributeGetter:
+      return 4;
+    case WebFeature::kNavigatorHardwareConcurrency:
+    case WebFeature::kNavigatorDeviceMemory:
+    case WebFeature::kNavigatorPlatform:
+    case WebFeature::kNavigatorMaxTouchPoints:
+    case WebFeature::kNavigatorPlugins:
+    case WebFeature::kNavigatorMimeTypes:
+    case WebFeature::kNavigatorUAData_GetHighEntropyValues:
+    case WebFeature::kNetInfoRtt:
+    case WebFeature::kNetInfoDownlink:
+    case WebFeature::kNetInfoEffectiveType:
+    case WebFeature::kNetInfoSaveData:
+    case WebFeature::kMediaDevicesEnumerateDevices:
+      return 5;
+    case WebFeature::kWebGPURequestAdapter:
+    case WebFeature::kHTMLCanvasElement_WebGPU:
+    case WebFeature::kOffscreenCanvas_WebGPU:
+      return 6;
+    case WebFeature::kV8Element_GetClientRects_Method:
+    case WebFeature::kV8Element_GetBoundingClientRect_Method:
+    case WebFeature::kV8Range_GetClientRects_Method:
+    case WebFeature::kV8Range_GetBoundingClientRect_Method:
+      return 7;
+    case WebFeature::kDateTimeFormat:
+      return 8;
+    case WebFeature::kRTCPeerConnectionConstructorCompliant:
+    case WebFeature::kRTCPeerConnectionConstructorConstraints:
+      return 9;
+    case WebFeature::kPersistentStorageEstimate:
+      return 10;
+    case WebFeature::kV8Permissions_Query_Method:
+      return 11;
+    case WebFeature::kBatteryStatusGetBattery:
+      return 12;
+    default:
+      return std::nullopt;
+  }
+}
+
+bool IsWebglAllowed(content::WebContents* contents) {
+  const GURL& url = contents->GetLastCommittedURL();
+  return HostContentSettingsMapFactory::GetForProfile(
+             contents->GetBrowserContext())
+             ->GetContentSetting(url, url, ContentSettingsType::WEBGL) ==
+         CONTENT_SETTING_ALLOW;
+}
+
+base::RepeatingCallbackList<void(content::WebContents*)>& GetCallbacks() {
+  static base::NoDestructor<
+      base::RepeatingCallbackList<void(content::WebContents*)>>
+      callbacks;
+  return *callbacks;
+}
+
+class FingerprintingObserver
+    : public page_load_metrics::PageLoadMetricsObserver {
+ public:
+  // page_load_metrics::PageLoadMetricsObserver:
+  const char* GetObserverName() const override {
+    return "FingerprintingObserver";
+  }
+
+  ObservePolicy OnFencedFramesStart(
+      content::NavigationHandle* navigation_handle,
+      const GURL& currently_committed_url) override {
+    return FORWARD_OBSERVING;
+  }
+
+  ObservePolicy OnPrerenderStart(content::NavigationHandle* navigation_handle,
+                                 const GURL& currently_committed_url) override {
+    return CONTINUE_OBSERVING;
+  }
+
+  // The page can come back with the back button and read more.
+  ObservePolicy OnEnterBackForwardCache(
+      const page_load_metrics::mojom::PageLoadTiming& timing) override {
+    return CONTINUE_OBSERVING;
+  }
+
+  void OnFeaturesUsageObserved(
+      content::RenderFrameHost* render_frame_host,
+      const std::vector<blink::UseCounterFeature>& features) override {
+    FingerprintingCounter::RecordFeatures(render_frame_host, features);
+  }
+};
+
+}  // namespace
+
+FingerprintingCounter::FingerprintingCounter(content::Page& page)
+    : content::PageUserData<FingerprintingCounter>(page) {}
+
+FingerprintingCounter::~FingerprintingCounter() = default;
+
+// static
+void FingerprintingCounter::RecordFeatures(
+    content::RenderFrameHost* render_frame_host,
+    const std::vector<blink::UseCounterFeature>& features) {
+  // The frames of the page, fenced frames included, count for the page.
+  content::Page& page = render_frame_host->GetOutermostMainFrame()->GetPage();
+  FingerprintingCounter* counter = nullptr;
+  for (const blink::UseCounterFeature& feature : features) {
+    if (feature.type() != blink::mojom::UseCounterFeatureType::kWebFeature) {
+      continue;
+    }
+    const std::optional<size_t> category =
+        CategoryOf(static_cast<WebFeature>(feature.value()));
+    if (!category) {
+      continue;
+    }
+    if (!counter) {
+      counter = GetOrCreateForPage(page);
+    }
+    ++counter->counts_[*category];
+  }
+  if (counter && page.IsPrimary()) {
+    GetCallbacks().Notify(
+        content::WebContents::FromRenderFrameHost(render_frame_host));
+  }
+}
+
+// static
+std::vector<FingerprintingRow> FingerprintingCounter::GetRows(
+    content::WebContents* contents) {
+  FingerprintingCounter* counter =
+      contents ? GetForPage(contents->GetPrimaryPage()) : nullptr;
+  std::vector<FingerprintingRow> rows;
+  for (size_t i = 0; i < kCategoryCount; ++i) {
+    FingerprintingAnswer answer = kCategories[i].answer;
+    if (i == kWebGL && contents && IsWebglAllowed(contents)) {
+      answer = FingerprintingAnswer::kAllowed;
+    }
+    rows.push_back({kCategories[i].name, counter ? counter->counts_[i] : 0,
+                    answer});
+  }
+  return rows;
+}
+
+// static
+int FingerprintingCounter::GetBlocked(content::WebContents* contents) {
+  int blocked = 0;
+  for (const FingerprintingRow& row : GetRows(contents)) {
+    if (row.answer != FingerprintingAnswer::kAllowed &&
+        row.answer != FingerprintingAnswer::kNotCounted) {
+      blocked += row.count;
+    }
+  }
+  return blocked;
+}
+
+// static
+base::CallbackListSubscription FingerprintingCounter::RegisterChangedCallback(
+    base::RepeatingCallback<void(content::WebContents*)> callback) {
+  return GetCallbacks().Add(std::move(callback));
+}
+
+std::unique_ptr<page_load_metrics::PageLoadMetricsObserver>
+CreateFingerprintingObserver() {
+  return std::make_unique<FingerprintingObserver>();
+}
+
+PAGE_USER_DATA_KEY_IMPL(FingerprintingCounter);
+
+}  // namespace browser_fork
diff --git a/chrome/browser/fork/fingerprinting_counter.h b/chrome/browser/fork/fingerprinting_counter.h
new file mode 100644
index 0000000000000000000000000000000000000000..f3e724dbc52e9b3c7bc654115a8aae0dc05323ce
--- /dev/null
+++ b/chrome/browser/fork/fingerprinting_counter.h
@@ -0,0 +1,87 @@
+#ifndef CHROME_BROWSER_FORK_FINGERPRINTING_COUNTER_H_
+#define CHROME_BROWSER_FORK_FINGERPRINTING_COUNTER_H_
+
+#include <array>
+#include <memory>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/functional/callback.h"
+#include "content/public/browser/page_user_data.h"
+#include "third_party/blink/public/common/use_counter/use_counter_feature.h"
+
+namespace content {
+class Page;
+class RenderFrameHost;
+class WebContents;
+}  // namespace content
+
+namespace page_load_metrics {
+class PageLoadMetricsObserver;
+}  // namespace page_load_metrics
+
+namespace browser_fork {
+
+// What the browser answers when a site reads the APIs of a category.
+enum class FingerprintingAnswer {
+  kRandomized,
+  kBlocked,
+  kUniform,
+  kLimited,
+  // The real value: nothing protects it yet.
+  kAllowed,
+  // Blink doesn't tell when a site uses it.
+  kNotCounted,
+};
+
+struct FingerprintingRow {
+  const char* name;
+  int count;
+  FingerprintingAnswer answer;
+};
+
+// The fingerprinting APIs a page read, by category: the 15 of the panel of the
+// site. Each API counts once for every frame that reads it, from the use
+// counters Blink already sends to the browser.
+class FingerprintingCounter
+    : public content::PageUserData<FingerprintingCounter> {
+ public:
+  static constexpr size_t kCategoryCount = 15;
+
+  FingerprintingCounter(const FingerprintingCounter&) = delete;
+  FingerprintingCounter& operator=(const FingerprintingCounter&) = delete;
+  ~FingerprintingCounter() override;
+
+  // The features a frame of the page used for the first time.
+  static void RecordFeatures(
+      content::RenderFrameHost* render_frame_host,
+      const std::vector<blink::UseCounterFeature>& features);
+
+  // The categories of the page shown in the tab, in the order of the boards.
+  static std::vector<FingerprintingRow> GetRows(content::WebContents* contents);
+
+  // The reads the browser answered with a protection: the number on the
+  // shield.
+  static int GetBlocked(content::WebContents* contents);
+
+  // Called when the counts of the page shown in a tab change.
+  static base::CallbackListSubscription RegisterChangedCallback(
+      base::RepeatingCallback<void(content::WebContents*)> callback);
+
+ private:
+  friend class content::PageUserData<FingerprintingCounter>;
+
+  explicit FingerprintingCounter(content::Page& page);
+
+  std::array<int, kCategoryCount> counts_ = {};
+
+  PAGE_USER_DATA_KEY_DECL();
+};
+
+// What passes the use counters of every page to FingerprintingCounter.
+std::unique_ptr<page_load_metrics::PageLoadMetricsObserver>
+CreateFingerprintingObserver();
+
+}  // namespace browser_fork
+
+#endif  // CHROME_BROWSER_FORK_FINGERPRINTING_COUNTER_H_

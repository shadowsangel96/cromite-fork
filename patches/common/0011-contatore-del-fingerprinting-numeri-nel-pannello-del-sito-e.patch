+    $('fp-hint').textContent = used.length ?
+        'Il sito ha cercato di leggere queste API. Ecco cosa gli ha risposto il browser.' :
+        'Finora il sito non ha letto nessuna di queste API.';
+    $('fp-rows').replaceChildren(...rows.map(row));
+    $('fp-rows').hidden = !rows.length;
+    $('fp-all').textContent = showAll ? 'Mostra solo quelle usate' :
+                                        'Mostra tutte e ' + s.fp.length + ' le categorie';
+  }
+
   function loaded(s) {
     state = s;
     $('site').textContent = s.site;

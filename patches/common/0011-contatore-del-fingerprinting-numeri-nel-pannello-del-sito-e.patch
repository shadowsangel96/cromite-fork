--- a/chrome/browser/resources/site_panel.js
+++ b/chrome/browser/resources/site_panel.js
@@ -2,6 +2,8 @@ window.SitePanel = (function() {
   'use strict';
 
   let state = null;
+  // "Mostra tutte e 15 le categorie": stays as chosen while the panel lives.
+  let showAll = false;
 
   const $ = (id) => document.getElementById(id);
 
@@ -19,6 +21,38 @@ window.SitePanel = (function() {
     }
   }
 
+  function row(r) {
+    const used = r.count > 0;
+    const div = document.createElement('div');
+    div.className = 'row';
+    const name = document.createElement('span');
+    name.textContent = r.name;
+    const count = document.createElement('span');
+    count.className = 'count';
+    count.textContent = used ? String(r.count) : '';
+    const chip = document.createElement('span');
+    const counted = r.kind !== 'none';
+    chip.className = 'chip ' + (used || !counted ? r.kind : 'none');
+    chip.textContent = used || !counted ? r.status : 'Non usata';
+    div.append(name, count, chip);
+    return div;
+  }
+
+  // The categories the page read first, then on request all the others.
+  function showFingerprinting(s) {
+    const used = s.fp.filter((r) => r.count > 0);

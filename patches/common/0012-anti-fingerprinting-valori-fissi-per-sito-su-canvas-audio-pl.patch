+constexpr char kFarbledRenderer[] =
+    "ANGLE (Intel, Mesa Intel(R) UHD Graphics 620 (KBL GT2), OpenGL 4.6)";
+#endif
+
+int64_t CommonLimit(GLenum pname, int64_t value) {

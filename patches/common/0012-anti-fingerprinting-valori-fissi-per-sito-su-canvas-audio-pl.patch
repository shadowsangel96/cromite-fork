+
+template <size_t N>
+const char* Pick(FarblingRandom& random, const char* const (&words)[N]) {
+  return words[random.Below(N)];
+}
+
+String RandomLetters(FarblingRandom& random, int length) {
+  static constexpr char kLetters[] = "abcdefghijklmnopqrstuvwxyz0123456789";
+  StringBuilder builder;
+  for (int i = 0; i < length; ++i) {
+    builder.Append(kLetters[random.Below(sizeof(kLetters) - 1)]);
+  }
+  return builder.ToString();
+}
+
+// A plugin that exists only for this site in this session, named like the
+// ones of the browsers, as in Brave: the list stops matching between sites.
+DOMPlugin* MakeFarbledPlugin(FarblingRandom& random, LocalDOMWindow* window) {
+  static constexpr const char* kMakers[] = {
+      "Chrome ", "Chromium ", "Web ", "Browser ", "OpenSource ", "Online ", ""};
+  static constexpr const char* kKinds[] = {
+      "PDF ", "Portable Document Format ", "Document ", "PDF and PS ",
+      "Media ", "Native Client "};
+  static constexpr const char* kRoles[] = {"Viewer", "Renderer", "Display",
+                                           "Plugin", "Reader", "Extension"};
+  const String name = StrCat(
+      {Pick(random, kMakers), Pick(random, kKinds), Pick(random, kRoles)});
+  auto* plugin_info = MakeGarbageCollected<PluginInfo>(
+      name, RandomLetters(random, 32), StrCat({name, " ", RandomLetters(random, 6)}),
+      /*background_color=*/Color::kTransparent,
+      /*may_use_external_handler=*/false);
+  plugin_info->AddMimeType(MakeGarbageCollected<MimeClassInfo>(
+      StrCat({"application/x-", RandomLetters(random, 8)}), name, *plugin_info,
+      Vector<String>{RandomLetters(random, 3)}));
+  return MakeGarbageCollected<DOMPlugin>(window, *plugin_info);
+}
 }  // namespace
 
 DOMPluginArray::DOMPluginArray(LocalDOMWindow* window) : window_(window) {
@@ -63,6 +103,11 @@ DOMPluginArray::DOMPluginArray(LocalDOMWindow* window) : window_(window) {
     for (auto name : plugins) {
       dom_plugins_.push_back(MakeFakePlugin(name, window));
     }
+    // Two more, different on every site.
+    FarblingRandom random(FarblingSeed(window) ^ 0x706c7567696e73ull);
+    for (int i = 0; i < 2; ++i) {
+      dom_plugins_.push_back(MakeFarbledPlugin(random, window));
+    }
   }
 }
 

diff --git a/third_party/blink/renderer/core/canvas_interventions/fork_farbling_seed.cc b/third_party/blink/renderer/core/canvas_interventions/fork_farbling_seed.cc
new file mode 100644
index 0000000000000000000000000000000000000000..4c5af5f0dd6da9932762f5b8b13fd2425ee0c1af
--- /dev/null
+++ b/third_party/blink/renderer/core/canvas_interventions/fork_farbling_seed.cc
@@ -0,0 +1,91 @@
+#include "third_party/blink/renderer/core/canvas_interventions/fork_farbling_seed.h"
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/no_destructor.h"
+#include "base/numerics/byte_conversions.h"
+#include "base/rand_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "crypto/hmac.h"
+#include "third_party/blink/public/common/fingerprinting_protection/noise_token.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/platform/fork_farbling.h"
+#include "third_party/blink/renderer/platform/network/blink_schemeful_site.h"
+#include "third_party/blink/renderer/platform/storage/blink_storage_key.h"
+#include "v8/include/v8-context.h"
+#include "v8/include/v8-isolate.h"
+
+namespace blink {
+
+namespace {
+
+// Given by the browser to every renderer of the profile.
+constexpr char kFarblingKeySwitch[] = "fork-farbling-key";
+
+const std::vector<uint8_t>& FarblingKey() {
+  static const base::NoDestructor<std::vector<uint8_t>> key([] {
+    std::vector<uint8_t> bytes;
+    if (!base::HexStringToBytes(
+            base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+                kFarblingKeySwitch),
+            &bytes) ||
+        bytes.size() < 16) {
+      // Not given: a key for this process alone, still never the same twice.
+      bytes = base::RandBytesAsVector(32);
+    }
+    return bytes;
+  }());
+  return *key;
+}
+
+// The site whose values the context reads: the top-level one for a page and
+// its frames, a credentialless frame apart from the others.
+std::string FarblingSite(ExecutionContext* context) {
+  if (auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    const BlinkStorageKey& key = window->GetStorageKey();
+    std::string site = key.GetTopLevelSite().Serialize().Utf8();
+    if (key.GetNonce()) {
+      site += " " + key.GetNonce()->ToString();
+    }
+    return site;
+  }
+  return BlinkSchemefulSite(context->GetSecurityOrigin()).Serialize().Utf8();
+}
+
+uint64_t SeedOfRunningScript() {
+  v8::Isolate* isolate = v8::Isolate::TryGetCurrent();
+  if (!isolate || !isolate->InContext()) {
+    return FarblingSeed(nullptr);
+  }
+  return FarblingSeed(ExecutionContext::From(isolate->GetCurrentContext()));
+}
+
+}  // namespace
+
+uint64_t FarblingSeed(ExecutionContext* context) {
+  if (!context) {
+    static const uint64_t seed = base::RandUint64();
+    return seed;
+  }
+  if (const std::optional<NoiseToken>& token = context->CanvasNoiseToken()) {
+    return token->Value();
+  }
+  const std::string site = FarblingSite(context);
+  const auto mac = crypto::hmac::SignSha256(base::span(FarblingKey()),
+                                            base::as_byte_span(site));
+  const uint64_t seed =
+      base::U64FromNativeEndian(base::span(mac).first<8>());
+  context->SetCanvasNoiseToken(NoiseToken(seed));
+  return seed;
+}
+
+void InstallFarblingSeedProvider() {
+  SetFarblingSeedProvider(&SeedOfRunningScript);
+}
+
+}  // namespace blink

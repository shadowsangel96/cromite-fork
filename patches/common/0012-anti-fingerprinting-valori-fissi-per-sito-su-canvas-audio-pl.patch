@@ -2831,6 +2832,27 @@ bool ChromeContentBrowserClient::IsFileAccessAllowed(
 
 namespace {
 
+// The key of the noise against fingerprinting: one for each profile, new at
+// every start of the browser and only in memory. The renderers mix it with the
+// site, so a site reads the same values for the whole session and two sites
+// can't match them.
+struct FarblingKeyData : public base::SupportsUserData::Data {
+  std::string key = base::HexEncode(base::RandBytesAsVector(32));
+};
+
+constexpr char kFarblingKeyUserDataKey[] = "fork_farbling_key";
+
+const std::string& GetFarblingKey(Profile* profile) {
+  auto* data = static_cast<FarblingKeyData*>(
+      profile->GetUserData(kFarblingKeyUserDataKey));
+  if (!data) {
+    auto owned = std::make_unique<FarblingKeyData>();
+    data = owned.get();
+    profile->SetUserData(kFarblingKeyUserDataKey, std::move(owned));
+  }
+  return data->key;
+}
+
 void MaybeAppendBlinkSettingsSwitchForFieldTrial(
     const base::CommandLine& browser_command_line,
     base::CommandLine* command_line) {
@@ -2968,6 +2990,8 @@ void ChromeContentBrowserClient::AppendExtraCommandLineSwitches(
     if (process) {
       Profile* profile =
           Profile::FromBrowserContext(process->GetBrowserContext());
+      command_line->AppendSwitchASCII("fork-farbling-key",
+                                      GetFarblingKey(profile));
       PrefService* prefs = profile->GetPrefs();
       PrefService* local_state = g_browser_process->local_state();
       // Currently this pref is only registered if applied via a policy.

@@ -0,0 +1,23 @@
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_CANVAS_INTERVENTIONS_FORK_FARBLING_SEED_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_CANVAS_INTERVENTIONS_FORK_FARBLING_SEED_H_
+
+#include <cstdint>
+
+#include "third_party/blink/renderer/core/core_export.h"
+
+namespace blink {
+
+class ExecutionContext;
+
+// The seed of the noise against fingerprinting for `context`: a key of the
+// profile, new at every start of the browser, mixed with the top-level site of
+// the page, so frames of other sites inside it read the same values as the
+// page. Kept in the canvas noise token of the context.
+CORE_EXPORT uint64_t FarblingSeed(ExecutionContext* context);
+
+// Lets the platform find the seed of the running script.
+void InstallFarblingSeedProvider();
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_CANVAS_INTERVENTIONS_FORK_FARBLING_SEED_H_

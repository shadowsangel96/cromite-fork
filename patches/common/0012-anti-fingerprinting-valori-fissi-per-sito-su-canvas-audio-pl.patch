new file mode 100644
index 0000000000000000000000000000000000000000..88628d4849339360cbbf71ea118e88f150575ff9
--- /dev/null
+++ b/third_party/blink/renderer/platform/fork_farbling.cc
@@ -0,0 +1,58 @@
+#include "third_party/blink/renderer/platform/fork_farbling.h"
+
+#include <atomic>
+
+#include "base/rand_util.h"
+
+namespace blink {
+
+namespace {
+
+std::atomic<FarblingSeedProvider> g_provider{nullptr};
+
+constinit thread_local bool g_has_scoped_seed = false;
+constinit thread_local uint64_t g_scoped_seed = 0;
+
+// Without a page, a seed for the whole process: still the same on every read.
+uint64_t ProcessSeed() {
+  static const uint64_t seed = base::RandUint64();
+  return seed;
+}
+
+}  // namespace
+
+void SetFarblingSeedProvider(FarblingSeedProvider provider) {
+  g_provider.store(provider);
+}
+
+uint64_t CurrentFarblingSeed() {
+  if (g_has_scoped_seed) {
+    return g_scoped_seed;
+  }
+  if (FarblingSeedProvider provider = g_provider.load()) {
+    return provider();
+  }
+  return ProcessSeed();
+}
+
+ScopedFarblingSeed::ScopedFarblingSeed(uint64_t seed)
+    : had_seed_(g_has_scoped_seed), previous_seed_(g_scoped_seed) {
+  g_has_scoped_seed = true;
+  g_scoped_seed = seed;
+}
+
+ScopedFarblingSeed::~ScopedFarblingSeed() {
+  g_has_scoped_seed = had_seed_;
+  g_scoped_seed = previous_seed_;
+}
+
+uint64_t FarblingHash(uint64_t seed, base::span<const uint8_t> data) {
+  // FNV-1a over the bytes, then mixed once more with the seed.
+  uint64_t hash = 0xcbf29ce484222325ull;
+  for (uint8_t byte : data) {
+    hash = (hash ^ byte) * 0x100000001b3ull;
+  }
+  return FarblingRandom(seed ^ hash).Next();
+}
+
+}  // namespace blink

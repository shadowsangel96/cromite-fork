new file mode 100644
index 0000000000000000000000000000000000000000..2f7f4a64c2dd15a9a12b03d217aead943c6e5c92
--- /dev/null
+++ b/third_party/blink/renderer/platform/fork_farbling.h
@@ -0,0 +1,65 @@
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_FORK_FARBLING_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_FORK_FARBLING_H_
+
+#include <cstdint>
+
+#include "base/containers/span.h"
+#include "third_party/blink/renderer/platform/platform_export.h"
+
+namespace blink {
+
+// The noise against fingerprinting comes from a seed that is the same on a
+// site for the whole session of the browser and different between sites, so a
+// site always reads the same values and two sites can't match them. The seed
+// itself comes from core, which knows the site of the running script.
+using FarblingSeedProvider = uint64_t (*)();
+PLATFORM_EXPORT void SetFarblingSeedProvider(FarblingSeedProvider provider);
+
+// The seed of the page whose script is running, or of the ScopedFarblingSeed
+// around the current work.
+PLATFORM_EXPORT uint64_t CurrentFarblingSeed();
+
+// For the work that doesn't run inside a script of the page, like the end of
+// an offline audio rendering.
+class PLATFORM_EXPORT ScopedFarblingSeed {
+ public:
+  explicit ScopedFarblingSeed(uint64_t seed);
+  ScopedFarblingSeed(const ScopedFarblingSeed&) = delete;
+  ScopedFarblingSeed& operator=(const ScopedFarblingSeed&) = delete;
+  ~ScopedFarblingSeed();
+
+ private:
+  const bool had_seed_;
+  const uint64_t previous_seed_;
+};
+
+// SplitMix64: a fixed sequence of values for each seed.
+class FarblingRandom {
+ public:
+  explicit FarblingRandom(uint64_t seed) : state_(seed) {}
+
+  uint64_t Next() {
+    uint64_t z = (state_ += 0x9e3779b97f4a7c15ull);
+    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ull;
+    z = (z ^ (z >> 27)) * 0x94d049bb133111ebull;
+    return z ^ (z >> 31);
+  }
+
+  // A value from 0 to `n` - 1.
+  uint64_t Below(uint64_t n) { return n ? Next() % n : 0; }
+
+  // A value from 0 (included) to 1 (excluded).
+  double Unit() { return (Next() >> 11) * 0x1.0p-53; }
+
+ private:
+  uint64_t state_;
+};
+
+// Mixes `data` into `seed`: the same content on the same site gets the same
+// noise.
+PLATFORM_EXPORT uint64_t FarblingHash(uint64_t seed,
+                                      base::span<const uint8_t> data);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_FORK_FARBLING_H_

+void ApplyInvidiousAddressSpaceOverrides(PrefService* local_state) {
+  if (!local_state) {
+    return;
+  }
+  const base::ListValue& addresses =
+      local_state->GetList(kInvidiousPublicAddressesPref);
+  if (local_state->IsManagedPreference(
+          prefs::kManagedLocalNetworkAccessIpAddressSpaceOverrides)) {
+    return;
+  }
+  if (addresses.empty()) {
+    local_state->ClearPref(
+        prefs::kManagedLocalNetworkAccessIpAddressSpaceOverrides);
+  } else {
+    local_state->SetList(
+        prefs::kManagedLocalNetworkAccessIpAddressSpaceOverrides,
+        addresses.Clone());
+  }
+}
+
+const char* ServiceName(RedirectService service) {
+  switch (service) {
+    case RedirectService::kYoutube:
+      return "YouTube";
+    case RedirectService::kInstagram:
+      return "Instagram";
+    case RedirectService::kTiktok:
+      return "TikTok";
+    case RedirectService::kNone:
+      return "";
+  }
+}
+
+const char* RespectfulName(RedirectService service) {
+  switch (service) {
+    case RedirectService::kYoutube:
+      return "Invidious";
+    case RedirectService::kInstagram:
+      return "imginn";
+    case RedirectService::kTiktok:
+      return "urlebird";
+    case RedirectService::kNone:
+      return "";
+  }
+}
+
+RedirectService SiteService(const GURL& url) {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return RedirectService::kNone;
+  }
+  if (url.DomainIs("youtube.com") || url.DomainIs("youtu.be") ||
+      url.DomainIs("youtube-nocookie.com")) {
+    return RedirectService::kYoutube;
+  }
+  if (url.DomainIs("instagram.com")) {
+    return RedirectService::kInstagram;
+  }
+  if (url.DomainIs("tiktok.com")) {
+    return RedirectService::kTiktok;
+  }
+  return RedirectService::kNone;
+}
+
+RedirectService RespectfulService(const GURL& url, const PrefService* prefs) {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return RedirectService::kNone;
+  }
+  if (prefs && IsInvidiousOrigin(url, prefs)) {
+    return RedirectService::kYoutube;
+  }
+  if (HostIn(url, {"imginn.com", "www.imginn.com"})) {
+    return RedirectService::kInstagram;
+  }
+  if (HostIn(url, {"urlebird.com", "www.urlebird.com"})) {
+    return RedirectService::kTiktok;
+  }
+  return RedirectService::kNone;
+}
+
+bool IsRedirectOn(RedirectService service, const PrefService* prefs) {
+  if (!prefs) {
+    return false;
+  }
+  switch (service) {
+    case RedirectService::kYoutube:
+      return prefs->GetBoolean(kRedirectYoutubePref) &&
+             !(HomeAddress(prefs).empty() && RemoteAddress(prefs).empty());
+    case RedirectService::kInstagram:
+      return prefs->GetBoolean(kRedirectInstagramPref);
+    case RedirectService::kTiktok:
+      return prefs->GetBoolean(kRedirectTiktokPref);
+    case RedirectService::kNone:
+      return false;
+  }
+}
+
+GURL RespectfulUrl(const GURL& url, const PrefService* prefs, bool main_frame) {
+  if (!url.SchemeIsHTTPOrHTTPS() || !prefs) {
+    return GURL();
+  }
+  // The page of the cookies of YouTube, in Europe: the page asked for is in it.
+  if (main_frame && url.host() == "consent.youtube.com") {
+    std::string next;
+    if (net::GetValueForKeyInQuery(url, "continue", &next) &&
+        GURL(next).host() != "consent.youtube.com") {
+      return RespectfulUrl(GURL(next), prefs, main_frame);
+    }
+    return GURL();
+  }
+  if (HostIn(url, {"youtube.com", "www.youtube.com", "m.youtube.com",
+                   "youtu.be", "youtube-nocookie.com",
+                   "www.youtube-nocookie.com"})) {
+    if (!IsRedirectOn(RedirectService::kYoutube, prefs)) {
+      return GURL();
+    }
+    const std::string base = InvidiousLocator::Get()->Current(prefs);
+    return base.empty() ? GURL() : YoutubeTarget(url, base, main_frame);
+  }
+  // imginn and urlebird don't let other sites show their pages in a frame.
+  if (!main_frame) {
+    return GURL();
+  }
+  if (HostIn(url, {"instagram.com", "www.instagram.com", "m.instagram.com"})) {
+    return IsRedirectOn(RedirectService::kInstagram, prefs)
+               ? InstagramTarget(url)
+               : GURL();
+  }
+  if (HostIn(url, {"tiktok.com", "www.tiktok.com", "m.tiktok.com",
+                   "vm.tiktok.com", "vt.tiktok.com"})) {
+    return IsRedirectOn(RedirectService::kTiktok, prefs) ? TiktokTarget(url)
+                                                          : GURL();
+  }
+  return GURL();
+}
+
+GURL OriginalUrl(const GURL& url, const PrefService* prefs) {
+  std::vector<std::string> parts = PathParts(url);
+  switch (RespectfulService(url, prefs)) {
+    case RedirectService::kYoutube: {
+      const std::string path(url.path());
+      const std::string with_query =
+          url.has_query() ? path + "?" + std::string(url.query()) : path;
+      if (parts.empty()) {
+        return GURL("https://www.youtube.com/");
+      }
+      const std::string& first = parts[0];
+      if (first == "search") {
+        std::string terms;
+        net::GetValueForKeyInQuery(url, "q", &terms);
+        return net::AppendQueryParameter(
+            GURL("https://www.youtube.com/results"), "search_query", terms);
+      }
+      if (first == "watch" || first == "embed" || first == "playlist" ||
+          first == "channel" || first == "hashtag" ||
+          base::StartsWith(first, "@") || first == "feed") {
+        return GURL("https://www.youtube.com" + with_query);
+      }
+      return GURL("https://www.youtube.com/");
+    }
+    case RedirectService::kInstagram: {
+      if (parts.size() >= 2 && parts[0] == "p") {
+        return GURL("https://www.instagram.com/p/" + parts[1] + "/");
+      }
+      if (parts.size() >= 2 && parts[0] == "stories") {
+        return GURL("https://www.instagram.com/stories/" + parts[1] + "/");
+      }
+      if (parts.size() >= 2 && parts[0] == "tagged") {
+        return GURL("https://www.instagram.com/" + parts[1] + "/tagged/");
+      }
+      if (parts.size() == 1 && IsInstagramUser(parts[0])) {
+        return GURL("https://www.instagram.com/" + parts[0] + "/");
+      }
+      return GURL("https://www.instagram.com/");
+    }
+    case RedirectService::kTiktok: {
+      // urlebird.com/it/user/...: the language first.
+      if (!parts.empty() && parts[0].size() == 2) {
+        parts.erase(parts.begin());
+      }
+      if (parts.size() >= 2 && parts[0] == "user" && IsTiktokUser(parts[1])) {
+        return GURL("https://www.tiktok.com/@" + parts[1]);
+      }
+      if (!parts.empty() && parts[0] == "trending") {
+        return GURL("https://www.tiktok.com/explore");
+      }
+      return GURL("https://www.tiktok.com/");
+    }
+    case RedirectService::kNone:
+      return GURL();
+  }
+}
+
+std::string InvidiousReachability(const PrefService* prefs) {
+  switch (InvidiousLocator::Get()->state(prefs)) {
+    case InvidiousLocator::State::kUnknown:
+      return HomeAddress(prefs).empty() && RemoteAddress(prefs).empty()
+                 ? std::string()
+                 : "checking";
+    case InvidiousLocator::State::kChecking:
+      return "checking";
+    case InvidiousLocator::State::kHome:
+      return "home";
+    case InvidiousLocator::State::kRemote:
+      return "remote";
+    case InvidiousLocator::State::kNone:
+      return "none";
+  }
+}
+
+void SiteRedirectSettingsChanged(PrefService* prefs, base::OnceClosure done) {
+  std::vector<std::string> plain_http;
+  for (const std::string& address : {HomeAddress(prefs), RemoteAddress(prefs)}) {
+    const GURL url(address);
+    if (url.is_valid() && url.SchemeIs(url::kHttpScheme)) {
+      plain_http.push_back(address);
+      // HTTPS-only mode would stop the server: at home it has plain http, on
+      // an address no certificate can cover.
+      base::ListValue hosts = prefs->GetList(prefs::kHttpAllowlist).Clone();
+      if (!std::ranges::contains(hosts, base::Value(url.host()))) {
+        hosts.Append(std::string(url.host()));
+        prefs->SetList(prefs::kHttpAllowlist, std::move(hosts));
+      }
+    }
+  }
+  // The videos of YouTube inside other sites go to Invidious too: a secure page
+  // can hold the plain http of the user's own server only if the browser trusts
+  // it. Tailscale encrypts its part anyway.
+  // And a site on the internet can't show a frame from the network at home
+  // without asking (Local Network Access): only these two addresses count as
+  // public, the rest of the network at home stays protected. From the next
+  // start of the browser, see ApplyInvidiousAddressSpaceOverrides().
+  base::ListValue public_addresses;
+  for (const std::string& address : {HomeAddress(prefs), RemoteAddress(prefs)}) {
+    const GURL url(address);
+    if (url.is_valid() && url.HostIsIPAddress()) {
+      public_addresses.Append(std::string(url.host()) + ":" +
+                              base::NumberToString(url.EffectiveIntPort()) +
+                              "=public");
+    }
+  }
+  if (PrefService* local_state = g_browser_process->local_state()) {
+    if (plain_http.empty()) {
+      local_state->ClearPref(prefs::kUnsafelyTreatInsecureOriginAsSecure);
+    } else {
+      local_state->SetString(prefs::kUnsafelyTreatInsecureOriginAsSecure,
+                             base::JoinString(plain_http, ","));
+    }
+    local_state->SetList(kInvidiousPublicAddressesPref,
+                         std::move(public_addresses));
+  }
+  InvidiousLocator::Get()->CheckNow(prefs, std::move(done));
+}
+
+std::unique_ptr<blink::URLLoaderThrottle> MaybeCreateSiteRedirectThrottle(
+    const network::ResourceRequest& request,
+    content::BrowserContext* browser_context,
+    const base::RepeatingCallback<content::WebContents*()>& wc_getter,
+    content::FrameTreeNodeId frame_tree_node_id) {
+  const bool main_frame =
+      request.destination == network::mojom::RequestDestination::kDocument;
+  if (!main_frame &&
+      request.destination != network::mojom::RequestDestination::kIframe &&
+      request.destination != network::mojom::RequestDestination::kFrame) {
+    return nullptr;
+  }
+  PrefService* prefs = PrefsOf(browser_context);
+  content::WebContents* contents = wc_getter ? wc_getter.Run() : nullptr;
+  SiteRedirectTabHelper* helper =
+      contents ? SiteRedirectTabHelper::FromWebContents(contents) : nullptr;
+  if (!prefs || !helper) {
+    return nullptr;
+  }
+  const RedirectService service = SiteService(request.url);
+  GURL target;
+  if (service != RedirectService::kNone) {
+    // The original the user chose stays, also for the links inside it; and a
+    // link of the respectful version to its original ("Guarda su YouTube") is
+    // the user's choice too.
+    const bool from_respectful =
+        request.request_initiator &&
+        RespectfulService(request.request_initiator->GetURL(), prefs) ==
+            service;
+    if (main_frame && from_respectful) {
+      helper->Bypass(service);
+      return nullptr;
+    }
+    if (main_frame ? helper->IsBypassed(service)
+                   : SiteService(contents->GetLastCommittedURL()) == service) {
+      return nullptr;
+    }
+    target = RespectfulUrl(request.url, prefs, main_frame);
+  }
+  if (!target.is_valid() && !main_frame) {
+    return nullptr;
+  }
+  return std::make_unique<SiteRedirectThrottle>(std::move(target), main_frame,
+                                                wc_getter);
+}
+
+SiteRedirectTabHelper::SiteRedirectTabHelper(content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<SiteRedirectTabHelper>(*web_contents) {
+  // The first tabs open with the browser: by the time YouTube opens, the browser
+  // knows which address of Invidious answers.
+  if (IsRedirectOn(RedirectService::kYoutube, prefs())) {
+    InvidiousLocator::Get()->Current(prefs());
+  }
+}
+
+SiteRedirectTabHelper::~SiteRedirectTabHelper() = default;
+
+void SiteRedirectTabHelper::Bypass(RedirectService service) {
+  bypass_ = service;
+}
+
+bool SiteRedirectTabHelper::IsBypassed(RedirectService service) const {
+  return service != RedirectService::kNone && bypass_ == service;
+}
+
+void SiteRedirectTabHelper::ExpectRespectful(const GURL& original,
+                                             const GURL& respectful) {
+  expected_original_ = original;
+  expected_respectful_ = respectful;
+}
+
+RedirectService SiteRedirectTabHelper::ShownRespectful() const {
+  return RespectfulService(web_contents()->GetLastCommittedURL(), prefs());
+}
+
+RedirectService SiteRedirectTabHelper::ShownOriginal() const {
+  return SiteService(web_contents()->GetLastCommittedURL());
+}
+
+void SiteRedirectTabHelper::OpenOriginal() {
+  const GURL url = web_contents()->GetLastCommittedURL();
+  const RedirectService service = RespectfulService(url, prefs());
+  if (service == RedirectService::kNone) {
+    return;
+  }
+  GURL original;
+  if (content::NavigationEntry* entry =
+          web_contents()->GetController().GetLastCommittedEntry()) {
+    if (auto it = originals_.find(entry->GetUniqueID());
+        it != originals_.end()) {
+      original = it->second;
+    }
+  }
+  if (!original.is_valid()) {
+    original = OriginalUrl(url, prefs());
+  }
+  bypass_ = service;
+  Load(original, /*replace_current_entry=*/false);
+}
+
+void SiteRedirectTabHelper::OpenRespectful() {
+  const GURL url = web_contents()->GetLastCommittedURL();
+  bypass_ = RedirectService::kNone;
+  GURL target = RespectfulUrl(url, prefs(), /*main_frame=*/true);
+  if (!target.is_valid()) {
+    return;
+  }
+  Load(target, /*replace_current_entry=*/false);
+}
+
+bool SiteRedirectTabHelper::OfferOriginal() {
+  if (ShownRespectful() != RedirectService::kYoutube) {
+    return false;
+  }
+  OpenOriginal();
+  return true;
+}
+
+void SiteRedirectTabHelper::DidFinishNavigation(
+    content::NavigationHandle* handle) {
+  if (!handle->IsInPrimaryMainFrame() || handle->IsSameDocument()) {
+    return;
+  }
+  const GURL url = handle->GetURL();
+  if (handle->HasCommitted() && SiteService(url) != bypass_) {
+    bypass_ = RedirectService::kNone;
+  }
+  if (handle->HasCommitted() && expected_respectful_.is_valid() &&
+      std::ranges::contains(handle->GetRedirectChain(), expected_respectful_)) {
+    if (content::NavigationEntry* entry =
+            web_contents()->GetController().GetLastCommittedEntry()) {
+      if (originals_.size() > 50) {
+        originals_.erase(originals_.begin());
+      }
+      originals_[entry->GetUniqueID()] = expected_original_;
+    }
+    expected_original_ = GURL();
+    expected_respectful_ = GURL();
+  }
+  // Invidious didn't answer at the address in use: ask both again, and if the
+  // other one answers open the page there.
+  if (handle->IsErrorPage() &&
+      RespectfulService(url, prefs()) == RedirectService::kYoutube) {
+    switch (handle->GetNetErrorCode()) {
+      case net::ERR_ADDRESS_UNREACHABLE:
+      case net::ERR_CONNECTION_FAILED:
+      case net::ERR_CONNECTION_REFUSED:
+      case net::ERR_CONNECTION_RESET:
+      case net::ERR_CONNECTION_TIMED_OUT:
+      case net::ERR_EMPTY_RESPONSE:
+      case net::ERR_NETWORK_CHANGED:
+      case net::ERR_TIMED_OUT:
+        InvidiousLocator::Get()->CheckNow(
+            prefs(), base::BindOnce(&SiteRedirectTabHelper::OnInvidiousChecked,
+                                    weak_factory_.GetWeakPtr(), url));
+        break;
+      default:
+        break;
+    }
+  }
+}
+
+void SiteRedirectTabHelper::OnInvidiousChecked(const GURL& failed_url) {
+  if (web_contents()->GetLastCommittedURL() != failed_url) {
+    return;
+  }
+  const InvidiousLocator::State state = InvidiousLocator::Get()->state(prefs());
+  if (state != InvidiousLocator::State::kHome &&
+      state != InvidiousLocator::State::kRemote) {
+    return;
+  }
+  const std::string base = InvidiousLocator::Get()->Current(prefs());
+  if (base.empty() || url::Origin::Create(failed_url).Serialize() == base) {
+    return;
+  }
+  const std::string path(failed_url.path());
+  Load(GURL(base + (failed_url.has_query()
+                        ? path + "?" + std::string(failed_url.query())
+                        : path)),
+       /*replace_current_entry=*/true);
+}
+
+PrefService* SiteRedirectTabHelper::prefs() const {
+  return PrefsOf(web_contents()->GetBrowserContext());
+}
+
+void SiteRedirectTabHelper::Load(const GURL& url, bool replace_current_entry) {
+  if (!url.is_valid()) {
+    return;
+  }
+  // Not from inside the callback of a navigation or of the panel.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&LoadInTab, web_contents()->GetWeakPtr(), url,
+                                replace_current_entry));
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(SiteRedirectTabHelper);
+
+}  // namespace browser_fork

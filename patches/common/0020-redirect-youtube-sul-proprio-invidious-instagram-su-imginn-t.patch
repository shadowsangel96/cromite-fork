+void RegisterSiteRedirectPrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterStringPref(kInvidiousHomePref, std::string());
+  registry->RegisterStringPref(kInvidiousRemotePref, std::string());
+  registry->RegisterBooleanPref(kRedirectYoutubePref, true);
+  registry->RegisterBooleanPref(kRedirectInstagramPref, true);
+  registry->RegisterBooleanPref(kRedirectTiktokPref, true);
+}
+
+void RegisterSiteRedirectLocalStatePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterListPref(kInvidiousPublicAddressesPref);
+}

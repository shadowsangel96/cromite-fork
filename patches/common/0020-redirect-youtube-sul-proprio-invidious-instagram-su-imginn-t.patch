+constexpr char kImginn[] = "https://imginn.com";
+constexpr char kUrlebird[] = "https://urlebird.com";
+
+// The answer of a server tells which address works now, for a while: a
+// change of network checks again sooner.
+constexpr base::TimeDelta kRecheckAfter = base::Minutes(10);
+constexpr base::TimeDelta kCheckTimeout = base::Seconds(3);
+
+// The internal firewall of Cromite drops any request whose tag isn't in
+// services/firewall/tools/rules.xml: this one asks the user's own server
+// whether it's there, like the check of the VPN, so it uses the same tag.
+constexpr net::NetworkTrafficAnnotationTag kInvidiousCheckAnnotation =
+    net::DefineNetworkTrafficAnnotation("proxy_config_settings", R"(
+      semantics {
+        sender: "Site redirects"
+        description: "Asks the user's own Invidious which of its addresses answers."
+        trigger: "A page of YouTube opens, the network changes, or the user saves the addresses."
+        data: "None."
+        destination: OTHER
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "chrome://proxy, Siti che tracciano."
+        policy_exception_justification: "Not implemented."
+      })");
+
+bool HostIn(const GURL& url, std::initializer_list<std::string_view> hosts) {
+  for (std::string_view host : hosts) {
+    if (url.host() == host) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool AllCharsIn(std::string_view text, std::string_view extra) {
+  for (char c : text) {
+    if (!base::IsAsciiAlphaNumeric(c) && extra.find(c) == std::string_view::npos) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool IsVideoId(std::string_view id) {
+  return id.size() == 11 && AllCharsIn(id, "_-");
+}
+
+bool IsInstagramUser(std::string_view user) {
+  static constexpr std::string_view kReserved[] = {
+      "about",   "accounts", "api",     "ar",      "challenge", "developer",
+      "direct",  "emails",   "explore", "graphql", "legal",     "lite",
+      "nametag", "oauth",    "p",       "privacy", "qr",        "reel",
+      "reels",   "session",  "static",  "stories", "terms",     "tv",
+      "web"};
+  return !user.empty() && user.size() <= 30 && AllCharsIn(user, "._") &&
+         !std::ranges::contains(kReserved, user);
+}
+
+bool IsInstagramCode(std::string_view code) {
+  return code.size() >= 5 && code.size() <= 48 && AllCharsIn(code, "_-");
+}
+
+bool IsTiktokUser(std::string_view user) {
+  return !user.empty() && user.size() <= 32 && AllCharsIn(user, "._");
+}
+
+std::vector<std::string> PathParts(const GURL& url) {
+  return base::SplitString(url.path(), "/", base::TRIM_WHITESPACE,
+                           base::SPLIT_WANT_NONEMPTY);
+}
+
+// "server.local:3000/" -> "http://server.local:3000"
+std::string NormalizeAddress(const std::string& typed) {
+  std::string address;
+  base::TrimString(typed, " \t/", &address);
+  if (address.empty()) {
+    return std::string();
+  }
+  if (address.find("://") == std::string::npos) {
+    address = "http://" + address;
+  }
+  const GURL url(address);
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || !url.has_host()) {
+    return std::string();
+  }
+  return url::Origin::Create(url).Serialize();
+}
+
+std::string HomeAddress(const PrefService* prefs) {
+  return NormalizeAddress(prefs->GetString(kInvidiousHomePref));
+}
+
+std::string RemoteAddress(const PrefService* prefs) {
+  return NormalizeAddress(prefs->GetString(kInvidiousRemotePref));
+}
+
+bool IsInvidiousOrigin(const GURL& url, const PrefService* prefs) {
+  const std::string origin = url::Origin::Create(url).Serialize();
+  for (const std::string& address : {HomeAddress(prefs), RemoteAddress(prefs)}) {
+    if (!address.empty() && origin == address) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Which address of Invidious to use. Both are asked; the one at home wins if it
+// answers, so at home the videos don't go around through Tailscale. A server
+// counts only if it says it's Invidious: on another network the address of
+// home can be somebody else's device.
+class InvidiousLocator
+    : public network::NetworkConnectionTracker::NetworkConnectionObserver {
+ public:
+  enum class State { kUnknown, kChecking, kHome, kRemote, kNone };
+
+  static InvidiousLocator* Get() {
+    static base::NoDestructor<InvidiousLocator> locator;
+    return locator.get();
+  }
+
+  InvidiousLocator(const InvidiousLocator&) = delete;
+  InvidiousLocator& operator=(const InvidiousLocator&) = delete;
+
+  // The address to use now; empty when there's none. Asks again when the
+  // answer is old.
+  std::string Current(const PrefService* prefs) {
+    if (Update(prefs) || stale_ ||
+        base::TimeTicks::Now() - checked_at_ > kRecheckAfter) {
+      Check(base::OnceClosure());
+    }
+    return chosen_;
+  }
+
+  State state(const PrefService* prefs) {
+    Update(prefs);
+    return checking_ ? State::kChecking : state_;
+  }
+
+  void CheckNow(const PrefService* prefs, base::OnceClosure done) {
+    Update(prefs);
+    Check(std::move(done));
+  }
+
+ private:
+  friend class base::NoDestructor<InvidiousLocator>;
+
+  struct Probe {
+    std::string address;
+    std::unique_ptr<network::SimpleURLLoader> loader;
+    bool done = false;
+    bool answered = false;
+  };
+
+  InvidiousLocator() {
+    content::GetNetworkConnectionTracker()->AddNetworkConnectionObserver(this);
+  }
+  ~InvidiousLocator() override = default;
+
+  // network::NetworkConnectionTracker::NetworkConnectionObserver:
+  void OnConnectionChanged(net::NetworkChangeNotifier::ConnectionType) override {
+    stale_ = true;
+    if (!home_.empty() || !remote_.empty()) {
+      Check(base::OnceClosure());
+    }
+  }
+
+  // True when the addresses changed.
+  bool Update(const PrefService* prefs) {
+    std::string home = HomeAddress(prefs);
+    std::string remote = RemoteAddress(prefs);
+    if (home == home_ && remote == remote_) {
+      return false;
+    }
+    home_ = std::move(home);
+    remote_ = std::move(remote);
+    chosen_ = home_.empty() ? remote_ : home_;
+    state_ = State::kUnknown;
+    probes_.clear();
+    checking_ = false;
+    return true;
+  }
+
+  void Check(base::OnceClosure done) {
+    if (done) {
+      waiting_.push_back(std::move(done));
+    }
+    if (checking_) {
+      return;
+    }
+    if (home_.empty() && remote_.empty()) {
+      Finish();
+      return;
+    }
+    checking_ = true;
+    stale_ = false;
+    probes_.clear();
+    for (const std::string& address : {home_, remote_}) {
+      if (address.empty()) {
+        continue;
+      }
+      auto request = std::make_unique<network::ResourceRequest>();
+      request->url = GURL(address + "/api/v1/stats");
+      request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+      request->load_flags = net::LOAD_DISABLE_CACHE | net::LOAD_BYPASS_CACHE;
+      auto probe = std::make_unique<Probe>();
+      probe->address = address;
+      probe->loader = network::SimpleURLLoader::Create(
+          std::move(request), kInvidiousCheckAnnotation);
+      probe->loader->SetTimeoutDuration(kCheckTimeout);
+      Probe* raw = probe.get();
+      probes_.push_back(std::move(probe));
+      // Home and Tailscale are out of the VPN anyway: the system context goes
+      // there directly.
+      raw->loader->DownloadToString(
+          g_browser_process->system_network_context_manager()
+              ->GetURLLoaderFactory(),
+          base::BindOnce(&InvidiousLocator::OnProbed, base::Unretained(this),
+                         raw),
+          4096);
+    }
+  }
+
+  void OnProbed(Probe* probe, std::optional<std::string> body) {
+    probe->done = true;
+    probe->answered = body && body->find("\"invidious\"") != std::string::npos;
+    probe->loader.reset();
+    for (const auto& other : probes_) {
+      if (!other->done) {
+        return;
+      }
+    }
+    std::string home_answered, remote_answered;
+    for (const auto& other : probes_) {
+      if (other->answered) {
+        (other->address == home_ ? home_answered : remote_answered) =
+            other->address;
+      }
+    }
+    if (!home_answered.empty()) {
+      chosen_ = home_answered;
+      state_ = State::kHome;
+    } else if (!remote_answered.empty()) {
+      chosen_ = remote_answered;
+      state_ = State::kRemote;
+    } else {
+      state_ = State::kNone;
+    }
+    checking_ = false;
+    checked_at_ = base::TimeTicks::Now();
+    probes_.clear();
+    Finish();
+  }
+
+  void Finish() {
+    std::vector<base::OnceClosure> waiting = std::move(waiting_);
+    for (base::OnceClosure& done : waiting) {
+      std::move(done).Run();
+    }
+  }
+
+  std::string home_;
+  std::string remote_;
+  std::string chosen_;
+  State state_ = State::kUnknown;
+  bool checking_ = false;
+  bool stale_ = true;
+  base::TimeTicks checked_at_;
+  std::vector<std::unique_ptr<Probe>> probes_;
+  std::vector<base::OnceClosure> waiting_;
+};
+
+GURL YoutubeTarget(const GURL& url, const std::string& base, bool main_frame) {
+  const std::string path(url.path());
+  const std::string query(url.query());
+  const std::string with_query = url.has_query() ? path + "?" + query : path;
+  const std::vector<std::string> parts = PathParts(url);
+
+  if (url.host() == "youtu.be") {
+    if (!main_frame || parts.size() != 1 || !IsVideoId(parts[0])) {
+      return GURL();
+    }
+    std::string target = base + "/watch?v=" + parts[0];
+    for (const char* key : {"t", "list"}) {
+      std::string value;
+      if (net::GetValueForKeyInQuery(url, key, &value) &&
+          AllCharsIn(value, "_-")) {
+        target += std::string("&") + key + "=" + value;
+      }
+    }
+    return GURL(target);
+  }
+  if (!parts.empty() && parts[0] == "embed" && parts.size() >= 2) {
+    return GURL(base + with_query);
+  }
+  if (!main_frame || url.DomainIs("youtube-nocookie.com")) {
+    return GURL();
+  }
+  if (parts.empty()) {
+    return GURL(base + "/");
+  }
+  const std::string& first = parts[0];
+  if ((first == "shorts" || first == "live") && parts.size() >= 2 &&
+      IsVideoId(parts[1])) {
+    return GURL(base + "/watch?v=" + parts[1]);
+  }
+  if (first == "watch" || first == "playlist" || first == "results" ||
+      first == "channel" || first == "c" || first == "user" ||
+      first == "hashtag" || base::StartsWith(first, "@") ||
+      (first == "feed" && parts.size() >= 2 && parts[1] == "trending")) {
+    return GURL(base + with_query);
+  }
+  return GURL();
+}
+
+GURL InstagramTarget(const GURL& url) {
+  const std::vector<std::string> parts = PathParts(url);
+  if (parts.empty()) {
+    return GURL(std::string(kImginn) + "/");
+  }
+  const std::string& first = parts[0];
+  if ((first == "p" || first == "reel" || first == "reels" || first == "tv") &&
+      parts.size() >= 2 && IsInstagramCode(parts[1])) {
+    return GURL(std::string(kImginn) + "/p/" + parts[1] + "/");
+  }
+  if (first == "stories" && parts.size() >= 2 && IsInstagramUser(parts[1])) {
+    return GURL(std::string(kImginn) + "/stories/" + parts[1] + "/");
+  }
+  if (!IsInstagramUser(first)) {
+    return GURL();
+  }
+  if (parts.size() >= 3 && (parts[1] == "p" || parts[1] == "reel") &&
+      IsInstagramCode(parts[2])) {
+    return GURL(std::string(kImginn) + "/p/" + parts[2] + "/");
+  }
+  if (parts.size() >= 2 && parts[1] == "tagged") {
+    return GURL(std::string(kImginn) + "/tagged/" + first + "/");
+  }
+  return GURL(std::string(kImginn) + "/" + first + "/");
+}
+
+// urlebird puts the words of the description in the address of a video, which
+// the link of TikTok doesn't have: a video opens the page of its author.
+GURL TiktokTarget(const GURL& url) {
+  if (HostIn(url, {"vm.tiktok.com", "vt.tiktok.com"})) {
+    return GURL();
+  }
+  const std::vector<std::string> parts = PathParts(url);
+  if (parts.empty()) {
+    return GURL(std::string(kUrlebird) + "/");
+  }
+  const std::string& first = parts[0];
+  if (first.size() > 1 && first[0] == '@' && IsTiktokUser(first.substr(1))) {
+    return GURL(std::string(kUrlebird) + "/user/" + first.substr(1) + "/");
+  }
+  if (first == "explore" || first == "foryou" || first == "trending") {
+    return GURL(std::string(kUrlebird) + "/trending/");
+  }
+  return GURL();
+}
+
+void LoadInTab(base::WeakPtr<content::WebContents> contents,
+               const GURL& url,
+               bool replace_current_entry) {
+  if (!contents) {
+    return;
+  }
+  content::NavigationController::LoadURLParams params(url);
+  params.transition_type = ui::PAGE_TRANSITION_LINK;
+  params.should_replace_current_entry = replace_current_entry;
+  contents->GetController().LoadURLWithParams(params);
+}
+
+PrefService* PrefsOf(content::BrowserContext* context) {
+  return context ? Profile::FromBrowserContext(context)->GetPrefs() : nullptr;
+}
+
+class SiteRedirectThrottle : public blink::URLLoaderThrottle {
+ public:
+  SiteRedirectThrottle(
+      GURL target,
+      bool main_frame,
+      base::RepeatingCallback<content::WebContents*()> wc_getter)
+      : target_(std::move(target)),
+        main_frame_(main_frame),
+        wc_getter_(std::move(wc_getter)) {}
+  ~SiteRedirectThrottle() override = default;
+
+  // blink::URLLoaderThrottle:
+  void WillStartRequest(network::ResourceRequest* request,
+                        bool* defer) override {
+    if (!target_.is_valid() || request->url == target_) {
+      return;
+    }
+    if (main_frame_) {
+      if (SiteRedirectTabHelper* helper = Helper()) {
+        helper->ExpectRespectful(request->url, target_);
+      }
+    }
+    request->url = target_;
+  }
+
+  // A short link, or a link through another site, that lands on a site that
+  // tracks: the loader can only move inside the same origin, so this one ends
+  // and the tab opens the respectful version.
+  void WillRedirectRequest(
+      net::RedirectInfo* redirect_info,
+      const network::mojom::URLResponseHead& response_head,
+      bool* defer,
+      network::HttpRequestHeadersUpdateParams* headers_update_params) override {
+    if (!main_frame_) {
+      return;
+    }
+    content::WebContents* contents = wc_getter_ ? wc_getter_.Run() : nullptr;
+    SiteRedirectTabHelper* helper =
+        contents ? SiteRedirectTabHelper::FromWebContents(contents) : nullptr;
+    if (!helper ||
+        helper->IsBypassed(SiteService(redirect_info->new_url))) {
+      return;
+    }
+    const GURL target =
+        RespectfulUrl(redirect_info->new_url,
+                      PrefsOf(contents->GetBrowserContext()), true);
+    if (!target.is_valid()) {
+      return;
+    }
+    helper->ExpectRespectful(redirect_info->new_url, target);
+    delegate_->CancelWithError(net::ERR_ABORTED);
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&LoadInTab, contents->GetWeakPtr(), target,
+                                  /*replace_current_entry=*/false));
+  }
+
+ private:
+  SiteRedirectTabHelper* Helper() {
+    content::WebContents* contents = wc_getter_ ? wc_getter_.Run() : nullptr;
+    return contents ? SiteRedirectTabHelper::FromWebContents(contents)
+                    : nullptr;
+  }
+
+  const GURL target_;
+  const bool main_frame_;
+  const base::RepeatingCallback<content::WebContents*()> wc_getter_;
+};

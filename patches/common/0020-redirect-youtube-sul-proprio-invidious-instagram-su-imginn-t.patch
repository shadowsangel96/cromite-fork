+
+class PrefRegistrySimple;
+class PrefService;
+
+namespace blink {
+class URLLoaderThrottle;
+}  // namespace blink
+
+namespace content {
+class BrowserContext;
+class WebContents;
+}  // namespace content
+
+namespace network {
+struct ResourceRequest;
+}  // namespace network
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}  // namespace user_prefs
+
+namespace browser_fork {
+
+// Sites that track open on a version that doesn't: YouTube on the user's own
+// Invidious, Instagram on imginn, TikTok on urlebird. Invidious has two
+// addresses, the one at home and the one through Tailscale; they stay out of
+// the repository, the user writes them in chrome://proxy.
+inline constexpr char kInvidiousHomePref[] = "fork.invidious_home";
+inline constexpr char kInvidiousRemotePref[] = "fork.invidious_remote";
+inline constexpr char kRedirectYoutubePref[] = "fork.redirect_youtube";
+inline constexpr char kRedirectInstagramPref[] = "fork.redirect_instagram";
+inline constexpr char kRedirectTiktokPref[] = "fork.redirect_tiktok";
+
+enum class RedirectService { kNone, kYoutube, kInstagram, kTiktok };
+
+void RegisterSiteRedirectPrefs(user_prefs::PrefRegistrySyncable* registry);
+
+// The addresses of Invidious that count as public for Local Network Access,
+// in Local State. They apply only when the browser starts: the network process
+// reads them then, and the browser must see the same as the network process,
+// or the pages of Invidious wait for a permission.
+inline constexpr char kInvidiousPublicAddressesPref[] =
+    "fork.invidious_public_addresses";
+void RegisterSiteRedirectLocalStatePrefs(PrefRegistrySimple* registry);
+// At the start of the browser, before the observer of the overrides.
+void ApplyInvidiousAddressSpaceOverrides(PrefService* local_state);
+
+// "YouTube", "Instagram", "TikTok".
+const char* ServiceName(RedirectService service);
+// "Invidious", "imginn", "urlebird".
+const char* RespectfulName(RedirectService service);
+// The service whose sites |url| is on, any page of them (youtube.com,
+// consent.youtube.com, ...).
+RedirectService SiteService(const GURL& url);
+// The service whose respectful version |url| is on.
+RedirectService RespectfulService(const GURL& url, const PrefService* prefs);
+bool IsRedirectOn(RedirectService service, const PrefService* prefs);
+// Where |url| goes when its service is on; empty when it stays as it is. A
+// frame inside a page only goes for the videos of YouTube.
+GURL RespectfulUrl(const GURL& url, const PrefService* prefs, bool main_frame);
+// The original page of a respectful one, as close as it can be told.
+GURL OriginalUrl(const GURL& url, const PrefService* prefs);
+
+// Which address of Invidious answers: "home", "remote", "none", "checking", or
+// empty when there's none to check.
+std::string InvidiousReachability(const PrefService* prefs);
+// The addresses or the switches changed: the allowlists for plain http and a
+// new check of the server. |done| runs when the check is over.
+void SiteRedirectSettingsChanged(PrefService* prefs, base::OnceClosure done);
+
+std::unique_ptr<blink::URLLoaderThrottle> MaybeCreateSiteRedirectThrottle(
+    const network::ResourceRequest& request,
+    content::BrowserContext* browser_context,
+    const base::RepeatingCallback<content::WebContents*()>& wc_getter,
+    content::FrameTreeNodeId frame_tree_node_id);
+
+// The original a tab asked for, and what the panel of the site shows.
+class SiteRedirectTabHelper
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<SiteRedirectTabHelper> {
+ public:
+  SiteRedirectTabHelper(const SiteRedirectTabHelper&) = delete;
+  SiteRedirectTabHelper& operator=(const SiteRedirectTabHelper&) = delete;
+  ~SiteRedirectTabHelper() override;
+
+  // The tab shows the original of |service| until it leaves its sites.
+  void Bypass(RedirectService service);
+  bool IsBypassed(RedirectService service) const;
+  // A navigation of this tab goes to |respectful| in place of |original|.
+  void ExpectRespectful(const GURL& original, const GURL& respectful);
+
+  // The page is the respectful version: the service, else kNone.
+  RedirectService ShownRespectful() const;
+  // The page is on the original sites of a service: the service, else kNone.
+  RedirectService ShownOriginal() const;
+  void OpenOriginal();
+  void OpenRespectful();
+  // The button of the error page when Invidious doesn't answer.
+  bool OfferOriginal();
+
+ private:
+  explicit SiteRedirectTabHelper(content::WebContents* web_contents);
+  friend class content::WebContentsUserData<SiteRedirectTabHelper>;
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override;
+
+  PrefService* prefs() const;
+  void Load(const GURL& url, bool replace_current_entry);
+  void OnInvidiousChecked(const GURL& failed_url);
+
+  RedirectService bypass_ = RedirectService::kNone;
+  GURL expected_original_;
+  GURL expected_respectful_;
+  // The original of the pages this tab opened on a respectful version, by
+  // entry of the history.
+  std::map<int, GURL> originals_;
+
+  base::WeakPtrFactory<SiteRedirectTabHelper> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace browser_fork
+
+#endif  // CHROME_BROWSER_FORK_SITE_REDIRECT_H_

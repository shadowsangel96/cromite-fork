 }
 
+// The seed of a page comes from the browser, which renews it when the
+// temporary cookies delete the site.
+bool SeedFromBrowser(LocalDOMWindow* window, uint64_t* seed) {
+  if (!window->GetFrame()) {
+    return false;
+  }
+  mojo::Remote<mojom::blink::FarblingHost> host;
+  window->GetFrame()->GetBrowserInterfaceBroker().GetInterface(
+      host.BindNewPipeAndPassReceiver());
+  return host->GetSeed(seed);
+}
+
 }  // namespace
 
 uint64_t FarblingSeed(ExecutionContext* context) {
@@ -96,11 +108,16 @@ uint64_t FarblingSeed(ExecutionContext* context) {
   if (const std::optional<NoiseToken>& token = context->CanvasNoiseToken()) {
     return token->Value();
   }
-  const std::string site = FarblingSite(context);
-  const auto mac = crypto::hmac::SignSha256(base::span(FarblingKey()),
-                                            base::as_byte_span(site));
-  const uint64_t seed =
-      base::U64FromNativeEndian(base::span(mac).first<8>());
+  // Once per document: a page asks the browser; what has no page, like a
+  // worker, derives it from the key of the profile and its site.
+  uint64_t seed = 0;
+  auto* window = DynamicTo<LocalDOMWindow>(context);
+  if (!window || !SeedFromBrowser(window, &seed)) {
+    const std::string site = FarblingSite(context);
+    const auto mac = crypto::hmac::SignSha256(base::span(FarblingKey()),
+                                              base::as_byte_span(site));
+    seed = base::U64FromNativeEndian(base::span(mac).first<8>());
+  }
   context->SetCanvasNoiseToken(NoiseToken(seed));
   return seed;
 }

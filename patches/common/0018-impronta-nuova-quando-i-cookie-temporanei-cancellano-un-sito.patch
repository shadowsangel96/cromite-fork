-interface FarblingPreviewHost {
+// The noise against fingerprinting of a page, between its renderer and the
+// browser.
+interface FarblingHost {
+  // The seed of the page, the same on its site until the browser renews it: at
+  // a restart, with "Cancella dati", or when the temporary cookies delete the
+  // site. Asked once per document, when the page first reads something noisy.
+  [Sync] GetSeed() => (uint64 seed);
+
+  // The image the page read from a canvas or from WebGL, already with the
+  // noise: the protections panel shows what the site really received. A small
+  // PNG, at most twice a second.
   ReportImage(bool webgl, array<uint8> png);
 };

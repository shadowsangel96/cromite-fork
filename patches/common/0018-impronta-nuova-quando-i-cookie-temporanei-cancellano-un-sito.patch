 namespace browser_fork {
@@ -14,13 +23,13 @@ namespace {
 
 struct FarblingKeyData : public base::SupportsUserData::Data {
   std::string key = base::HexEncode(base::RandBytesAsVector(32));
+  // How many times the temporary cookies deleted each site, in memory only.
+  std::map<std::string, int> generations;
 };
 
 constexpr char kFarblingKeyUserDataKey[] = "fork_farbling_key";
 
-}  // namespace
-
-const std::string& GetFarblingKey(Profile* profile) {
+FarblingKeyData* GetData(Profile* profile) {
   auto* data = static_cast<FarblingKeyData*>(
       profile->GetUserData(kFarblingKeyUserDataKey));
   if (!data) {
@@ -28,7 +37,44 @@ const std::string& GetFarblingKey(Profile* profile) {
     data = owned.get();
     profile->SetUserData(kFarblingKeyUserDataKey, std::move(owned));
   }
-  return data->key;
+  return data;
+}
+
+}  // namespace
+
+const std::string& GetFarblingKey(Profile* profile) {
+  return GetData(profile)->key;
+}
+
+uint64_t FarblingSeedForFrame(content::RenderFrameHost* frame) {
+  Profile* profile = Profile::FromBrowserContext(frame->GetBrowserContext());
+  FarblingKeyData* data = GetData(profile);
+  std::vector<uint8_t> key;
+  base::HexStringToBytes(data->key, &key);
+
+  // The same site as the renderer uses without the browser, for its workers:
+  // the top-level one, a credentialless frame apart. A site deleted by the
+  // temporary cookies adds how many times.
+  const blink::StorageKey& storage_key = frame->GetStorageKey();
+  std::string site = storage_key.top_level_site().Serialize();
+  if (storage_key.nonce()) {
+    site += " " + storage_key.nonce()->ToString();
+  }
+  const auto generation = data->generations.find(
+      TemporarySiteDataService::SiteForUrl(
+          storage_key.top_level_site().GetURL()));
+  if (generation != data->generations.end()) {
+    site += " #" + base::NumberToString(generation->second);
+  }
+  const auto mac =
+      crypto::hmac::SignSha256(base::span(key), base::as_byte_span(site));
+  return base::U64FromNativeEndian(base::span(mac).first<8>());
+}
+
+void RenewFarblingSeed(Profile* profile, const std::string& site) {
+  if (!site.empty()) {
+    ++GetData(profile)->generations[site];
+  }
 }
 
 void ResetFarblingKey(Profile* profile) {

 // "Questa pagina": the extension opens its own panel as if its icon was clicked.
+// Opens the panel of the active tab as soon as its page is set.
+void OpenPageViewWhenSet(base::WeakPtr<BrowserWindowInterface> browser,
+                         int attempts_left) {
+  if (!browser) {
+    return;
+  }
+  SidePanelUI* side_panel = browser->GetFeatures().side_panel_ui();
+  if (side_panel->IsSidePanelEntryShowing(ChatsKey()) ||
+      side_panel->IsSidePanelEntryShowing(PageKey())) {
+    return;
+  }
+  tabs::TabInterface* tab = browser->GetActiveTabInterface();
+  if (tab && SidePanelRegistry::From(tab)->GetEntryForKey(PageKey())) {
+    side_panel->Show(PageKey());
+    return;
+  }
+  if (attempts_left > 0) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&OpenPageViewWhenSet, browser, attempts_left - 1),
+        base::Milliseconds(200));
+  }
+}
+
+// The extension opens its panel on a click only if its service worker answers
+// while the click still counts as a user gesture, and it may not. So the browser
+// sets the same page the extension would and opens it itself; the action still
+// runs for the rest of what the extension does on a click, like its tab group.
 bool ShowPageView(BrowserWindowInterface* browser) {
   const extensions::Extension* extension =
       GetClaudeExtension(browser->GetProfile());
   tabs::TabInterface* tab = browser->GetActiveTabInterface();
-  auto* runner = tab ? extensions::ExtensionActionRunner::GetForWebContents(
-                           tab->GetContents())
-                     : nullptr;
-  if (!extension || !runner) {
+  auto* service = extensions::SidePanelService::Get(browser->GetProfile());
+  if (!extension || !tab || !service) {
     return false;
   }
-  runner->RunAction(extension, /*grant_tab_permissions=*/true);
+  const int tab_id = extensions::ExtensionTabUtil::GetTabId(tab->GetContents());
+  extensions::api::side_panel::PanelOptions options;
+  options.tab_id = tab_id;
+  options.path = "sidepanel.html?tabId=" + base::NumberToString(tab_id);
+  options.enabled = true;
+  service->SetOptions(*extension, std::move(options));
+  if (auto* runner = extensions::ExtensionActionRunner::GetForWebContents(
+          tab->GetContents())) {
+    runner->RunAction(extension, /*grant_tab_permissions=*/true);
+  }
+  OpenPageViewWhenSet(browser->GetWeakPtr(), /*attempts_left=*/50);
   return true;
 }
 

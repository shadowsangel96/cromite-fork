+#if BUILDFLAG(IS_MAC)
+// The capsule of the sketches around a group of buttons: a veil on the glass, a
+// thin edge and a soft shadow.
+void PaintCapsule(gfx::Canvas* canvas, const gfx::Rect& rect, bool dark) {
+  gfx::ScopedCanvas scoped_canvas(canvas);
+  const float scale = canvas->UndoDeviceScaleFactor();
+  gfx::RectF bounds(rect);
+  bounds.Scale(scale);
+  const float radius = bounds.height() / 2;
+  const SkRRect capsule =
+      SkRRect::MakeRectXY(gfx::RectFToSkRect(bounds), radius, radius);
+  {
+    gfx::ScopedCanvas shadow_canvas(canvas);
+    canvas->sk_canvas()->clipRRect(capsule, SkClipOp::kDifference,
+                                   /*do_anti_alias=*/true);
+    cc::PaintFlags shadow;
+    shadow.setAntiAlias(true);
+    shadow.setLooper(gfx::CreateShadowDrawLooper(
+        {gfx::ShadowValue(gfx::Vector2d(0, std::round(scale)), 3 * scale,
+                          SkColorSetA(SK_ColorBLACK, dark ? 0x66 : 0x1F))}));
+    canvas->sk_canvas()->drawRRect(capsule, shadow);
+  }
+  cc::PaintFlags fill;
+  fill.setAntiAlias(true);
+  fill.setColor(SkColorSetA(SK_ColorWHITE, dark ? 0x1A : 0x99));
+  canvas->sk_canvas()->drawRRect(capsule, fill);
+
+  cc::PaintFlags edge;
+  edge.setAntiAlias(true);
+  edge.setStyle(cc::PaintFlags::kStroke_Style);
+  edge.setStrokeWidth(scale / 2);
+  edge.setColor(dark ? SkColorSetA(SK_ColorWHITE, 0x1F)
+                     : SkColorSetA(SK_ColorBLACK, 0x1A));
+  canvas->sk_canvas()->drawRRect(capsule, edge);
+}
+#endif  // BUILDFLAG(IS_MAC)

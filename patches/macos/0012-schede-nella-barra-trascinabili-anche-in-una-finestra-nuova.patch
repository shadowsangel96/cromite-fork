 // After every button of the toolbar, which would otherwise go in the overflow
 // menu to make room for the tabs; only the empty space comes later.
 constexpr int kTabsFlexOrder = 1900;
+// How far below the toolbar a dragged tab goes to its own window.
+constexpr int kDetachDistance = 40;
 
 // The X of the boards, drawn where the icon of the site was.
 class CloseImageSource : public gfx::CanvasImageSource {
@@ -157,6 +163,66 @@ class CompactTabChip : public views::LabelButton,
   }
 
   // views::View:
+  // Dragging a tab moves it among the others, the address standing for the
+  // active one; dropped below the toolbar it goes to a new window.
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    press_point_ = event.location();
+    return views::LabelButton::OnMousePressed(event);
+  }
+
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    if (!dragging_) {
+      if (!event.IsOnlyLeftMouseButton() ||
+          !ExceededDragThreshold(event.location() - press_point_)) {
+        return views::LabelButton::OnMouseDragged(event);
+      }
+      dragging_ = true;
+      SetPaintToLayer();
+      layer()->SetFillsBoundsOpaquely(false);
+    }
+    const gfx::Vector2d delta = event.location() - press_point_;
+    gfx::Transform transform;
+    transform.Translate(delta.x(), std::max(delta.y(), 0) / 3);
+    layer()->SetTransform(transform);
+    return true;
+  }
+
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    if (!dragging_) {
+      views::LabelButton::OnMouseReleased(event);
+      return;
+    }
+    EndDrag();
+    SetState(ButtonState::STATE_NORMAL);
+    if (!model_->ContainsIndex(index_)) {
+      return;
+    }
+    gfx::Point point = event.location();
+    views::View::ConvertPointToScreen(this, &point);
+    views::View* toolbar = parent() ? parent()->parent() : nullptr;
+    if (!toolbar) {
+      return;
+    }
+    if (point.y() > toolbar->GetBoundsInScreen().bottom() + kDetachDistance) {
+      if (model_->count() > 1) {
+        model_->ExecuteContextMenuCommand(
+            index_, TabStripModel::CommandMoveTabsToNewWindow);
+      }
+      return;
+    }
+    const int to = DropIndex(toolbar, point.x());
+    if (to != index_) {
+      model_->MoveWebContentsAt(index_, to, /*select_after_move=*/false);
+    }
+  }
+
+  void OnMouseCaptureLost() override {
+    if (dragging_) {
+      EndDrag();
+    }
+    views::LabelButton::OnMouseCaptureLost();
+  }
+
   gfx::Size GetMinimumSize() const override {
     return gfx::Size(kChipMinWidth, kChipHeight);
   }
@@ -211,6 +277,37 @@ class CompactTabChip : public views::LabelButton,
                   GetImageModel(views::Button::STATE_HOVERED));
   }
 
+  void EndDrag() {
+    dragging_ = false;
+    DestroyLayer();
+  }
+
+  int index() const { return index_; }
+
+  // The index the tab takes: as many tabs as have their middle before `x`.
+  int DropIndex(views::View* toolbar, int x) const {
+    int before = 0;
+    const auto count = [&](const views::View* view, int index) {
+      if (index != index_ && view->GetVisible() &&
+          view->GetBoundsInScreen().CenterPoint().x() < x) {
+        ++before;
+      }
+    };
+    for (views::View* child : toolbar->children()) {
+      if (views::IsViewClass<CompactTabsView>(child)) {
+        for (views::View* chip : child->children()) {
+          count(chip, static_cast<CompactTabChip*>(chip)->index());
+        }
+      }
+    }
+    if (auto* toolbar_view = views::AsViewClass<ToolbarView>(toolbar)) {
+      if (toolbar_view->location_bar_view()) {
+        count(toolbar_view->location_bar_view(), model_->active_index());
+      }
+    }
+    return before;
+  }
+
   bool IsOnCloseIcon(const ui::Event& event) const {
     return event.IsMouseEvent() && image_container_view() &&
            event.AsMouseEvent()->x() <=
@@ -234,6 +331,8 @@ class CompactTabChip : public views::LabelButton,
 
   const raw_ptr<TabStripModel> model_;
   int index_ = TabStripModel::kNoTab;

+// The asterisk of Claude, on the button of a profile signed in to Claude.
+class ClaudeMarkSource : public gfx::CanvasImageSource {
+ public:
+  ClaudeMarkSource(int size, SkColor color)
+      : gfx::CanvasImageSource(gfx::Size(size, size)),
+        size_(size),
+        color_(color) {}
+
+  void Draw(gfx::Canvas* canvas) override {
+    const float unit = size_ / 16.f;
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(color_);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+    flags.setStrokeWidth(1.9f * unit);
+    const auto line = [&](float x1, float y1, float x2, float y2) {
+      canvas->DrawLine(gfx::PointF(x1 * unit, y1 * unit),
+                       gfx::PointF(x2 * unit, y2 * unit), flags);
+    };
+    line(8, 1.6f, 8, 14.4f);
+    line(1.6f, 8, 14.4f, 8);
+    line(3.5f, 3.5f, 12.5f, 12.5f);
+    line(12.5f, 3.5f, 3.5f, 12.5f);
+  }
+
+ private:
+  const int size_;
+  const SkColor color_;
+};
+
+// The clay of the boards and the color on it, on a light and a dark toolbar.
+SkColor ClayFill(bool dark) {
+  return dark ? SkColorSetRGB(0xe0, 0x88, 0x6b) : SkColorSetRGB(0xa9, 0x50, 0x2f);
+}
+SkColor OnClay(bool dark) {
+  return dark ? SkColorSetRGB(0x2b, 0x13, 0x0b) : SK_ColorWHITE;
+}

+// Watches the cookie of the session of claude.ai, in the profile only: nothing
+// goes out.
+class AvatarToolbarButton::ClaudeSession
+    : public network::mojom::CookieChangeListener {
+ public:
+  ClaudeSession(Profile* profile, base::RepeatingCallback<void(bool)> callback)
+      : profile_(profile), callback_(std::move(callback)) {
+    CookieManager()->AddCookieChangeListener(
+        GURL(kClaudeUrl), kClaudeSessionCookie,
+        receiver_.BindNewPipeAndPassRemote());
+    Check();
+  }
+
+  // network::mojom::CookieChangeListener:
+  void OnCookieChange(const net::CookieChangeInfo& change) override {
+    Check();
+  }
+
+ private:
+  network::mojom::CookieManager* CookieManager() {
+    return profile_->GetDefaultStoragePartition()
+        ->GetCookieManagerForBrowserProcess();
+  }
+
+  void Check() {
+    CookieManager()->GetAllCookies(base::BindOnce(&ClaudeSession::OnCookies,
+                                                  weak_factory_.GetWeakPtr()));
+  }
+
+  void OnCookies(const net::CookieList& cookies) {
+    bool signed_in = false;
+    for (const net::CanonicalCookie& cookie : cookies) {
+      if (cookie.Name() == kClaudeSessionCookie &&
+          base::EndsWith(cookie.Domain(), "claude.ai")) {
+        signed_in = true;
+        break;
+      }
+    }
+    callback_.Run(signed_in);
+  }
+
+  const raw_ptr<Profile> profile_;
+  const base::RepeatingCallback<void(bool)> callback_;
+  mojo::Receiver<network::mojom::CookieChangeListener> receiver_{this};
+  base::WeakPtrFactory<ClaudeSession> weak_factory_{this};
+};

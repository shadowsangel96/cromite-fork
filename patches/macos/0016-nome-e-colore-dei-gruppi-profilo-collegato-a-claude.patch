+// A command of the menu of a tab.
+void RunTabCommand(tabs::TabHandle handle, int command_id) {
+  tabs::TabInterface* tab = handle.Get();
+  if (!tab || !tab->GetBrowserWindowInterface()) {
+    return;
+  }
+  TabStripModel* model = tab->GetBrowserWindowInterface()->GetTabStripModel();
+  const int index = model->GetIndexOfTab(tab);
+  if (index == TabStripModel::kNoTab) {
+    return;
+  }
+  switch (command_id) {
+    // A new group, with its editor under its label to name it.
+    case TabStripModel::CommandAddToNewGroup:
+      model->OpenTabGroupEditor(model->AddToNewGroup({index}));
+      return;
+    case TabStripModel::CommandRemoveFromGroup:
+      model->RemoveFromGroup({index});
+      return;
+    default:
+      model->ExecuteContextMenuCommand(
+          index, static_cast<TabStripModel::ContextMenuCommand>(command_id));
+  }
+}

 #include <string.h>
 
 #include <memory>
@@ -13,8 +16,11 @@
 #include "base/base_paths.h"
 #include "base/check_op.h"
 #include "base/compiler_specific.h"
+#include "base/files/file_util.h"
 #include "base/memory/free_deleter.h"
+#include "base/no_destructor.h"
 #include "base/path_service.h"
+#include "base/strings/string_number_conversions.h"
 #include "base/strings/sys_string_conversions.h"
 #include "build/branding_buildflags.h"
 #include "build/build_config.h"
@@ -79,12 +85,55 @@ bool GetDefaultUserDataDirectoryForProduct(const std::string& product_dir,
   return success;
 }
 
+// Fork: fino a novembre 2026 il browser si chiamava NomeBrowser, con i dati in
+// ~/Library/Application Support/NomeBrowser. Se la cartella del nome nuovo non c'è ancora, si
+// prende quella vecchia spostandola. Se il vecchio browser è ancora aperto (SingletonLock di un
+// processo vivo) non si sposta niente e si usa la cartella vecchia, finché non si chiude.
+constexpr char kLegacyProductDirName[] = "NomeBrowser";
+
+bool LegacyBrowserRunning(const base::FilePath& dir) {
+  base::FilePath lock;
+  if (!base::ReadSymbolicLink(dir.Append("SingletonLock"), &lock)) {
+    return false;
+  }
+  // Il collegamento punta a "<nome del computer>-<pid>".
+  const std::string& value = lock.value();
+  const size_t dash = value.rfind('-');
+  int pid = 0;
+  if (dash == std::string::npos ||
+      !base::StringToInt(value.substr(dash + 1), &pid) || pid <= 0) {
+    return false;
+  }
+  return kill(pid, 0) == 0 || errno == EPERM;
+}
+
+base::FilePath AdoptLegacyUserDataDirectory(const base::FilePath& dir) {
+  if (base::PathExists(dir)) {
+    return dir;
+  }
+  const base::FilePath legacy = dir.DirName().Append(kLegacyProductDirName);
+  if (!base::DirectoryExists(legacy)) {
+    return dir;
+  }
+  if (LegacyBrowserRunning(legacy) ||
+      rename(legacy.value().c_str(), dir.value().c_str()) != 0) {
+    return legacy;
+  }
+  return dir;
+}
+
 }  // namespace
 
 namespace chrome {
 
 bool GetDefaultUserDataDirectory(base::FilePath* result) {
-  return GetDefaultUserDataDirectoryForProduct(ProductDirName(), result);
+  if (!GetDefaultUserDataDirectoryForProduct(ProductDirName(), result)) {
+    return false;
+  }
+  static const base::NoDestructor<base::FilePath> adopted(
+      AdoptLegacyUserDataDirectory(*result));
+  *result = *adopted;
+  return true;
 }
 
 bool GetUserDocumentsDirectory(base::FilePath* result) {
diff --git a/components/os_crypt/common/keychain_password_mac.mm b/components/os_crypt/common/keychain_password_mac.mm
index 2f12a692a6267f4258ee66235c385ea2a74388ff..153e958c97320cbe28d8765f6b70723f4de06a45 100644
--- a/components/os_crypt/common/keychain_password_mac.mm
+++ b/components/os_crypt/common/keychain_password_mac.mm
@@ -42,6 +42,14 @@
 const char kDefaultAccountName[] = "Shannon";
 #endif
 
+#if !BUILDFLAG(GOOGLE_CHROME_BRANDING)
+// Fork: la voce di quando il browser si chiamava NomeBrowser. Se la voce di adesso non c'è, la
+// chiave si copia da quella vecchia (macOS chiede il permesso una volta) e cookie e password
+// cifrati restano leggibili. La voce vecchia resta nel Portachiavi.
+const char kLegacyServiceName[] = "NomeBrowser Safe Storage";
+const char kLegacyAccountName[] = "NomeBrowser";
+#endif
+
 // These values are persisted to logs. Entries should not be renumbered and
 // numeric values should never be reused.
 enum class FindGenericPasswordResult {
@@ -95,6 +103,30 @@
   }
 
   if (password.error() == errSecItemNotFound) {
+#if !BUILDFLAG(GOOGLE_CHROME_BRANDING)
+    if (service_name == kDefaultServiceName &&
+        account_name == kDefaultAccountName) {
+      auto legacy =
+          keychain.FindGenericPassword(kLegacyServiceName, kLegacyAccountName);
+      if (legacy.has_value()) {
+        uma_result = FindGenericPasswordResult::kPasswordFound;
+        std::string value(base::as_string_view(*legacy));
+        OSStatus error = keychain.AddGenericPassword(
+            service_name, account_name, base::as_byte_span(value));
+        if (error != noErr) {
+          OSSTATUS_LOG(ERROR, error) << "Keychain copy failed";
+        }
+        return value;
+      }
+      if (legacy.error() != errSecItemNotFound) {
+        // La voce vecchia c'è ma non si legge (per esempio permesso negato): una chiave nuova
+        // renderebbe illeggibili i dati, quindi niente chiave e si riprova al prossimo avvio.
+        OSSTATUS_LOG(ERROR, legacy.error()) << "Legacy keychain lookup failed";
+        uma_result = FindGenericPasswordResult::kErrorOccurred;
+        return base::unexpected(legacy.error());
+      }
+    }
+#endif
     uma_result = FindGenericPasswordResult::kPasswordNotFound;
     return AddRandomPasswordToKeychain(keychain, service_name, account_name);
   }

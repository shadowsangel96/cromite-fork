+  for (size_t i = 0; i < entries.size(); ++i) {
+    views::View* view = i < children().size() ? children()[i] : nullptr;
+    const bool header = entries[i].header.has_value();
+    if (view && (header ? views::IsViewClass<CompactGroupHeader>(view)
+                        : views::IsViewClass<CompactTabChip>(view))) {
+      if (header) {
+        static_cast<CompactGroupHeader*>(view)->SetGroup(*entries[i].header);
+      } else {
+        static_cast<CompactTabChip*>(view)->SetTab(entries[i].index);
+      }
+      continue;
+    }
+    if (view) {
+      RemoveChildViewT(view);
+    }
+    if (header) {
+      AddChildViewAt(std::make_unique<CompactGroupHeader>(model_), i)
+          ->SetGroup(*entries[i].header);
+    } else {
+      AddChildViewAt(std::make_unique<CompactTabChip>(model_), i)
+          ->SetTab(entries[i].index);
+    }
   }
-  for (size_t i = 0; i < wanted; ++i) {

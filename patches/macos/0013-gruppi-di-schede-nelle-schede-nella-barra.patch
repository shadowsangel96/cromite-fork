 void CompactTabsView::Update() {
   const int active = model_->active_index();
   const int first = side_ == Side::kBeforeActive ? 0 : active + 1;
   const int last =
       side_ == Side::kBeforeActive ? std::max(active, 0) : model_->count();
-  const size_t wanted = active == TabStripModel::kNoTab
-                            ? 0
-                            : static_cast<size_t>(std::max(last - first, 0));
-  while (children().size() > wanted) {
-    RemoveChildViewT(children().back());
+
+  // The row: a label before the first tab of each group, and no tabs of the
+  // closed groups. A group that starts with the address has its label at the
+  // end of the tabs before it.
+  struct Entry {
+    int index;
+    std::optional<tab_groups::TabGroupId> header;
+  };
+  std::vector<Entry> entries;
+  if (active != TabStripModel::kNoTab) {
+    const auto starts_group = [&](int i) {
+      const std::optional<tab_groups::TabGroupId> group =
+          model_->GetTabGroupForTab(i);
+      return group && (i == 0 || model_->GetTabGroupForTab(i - 1) != group);
+    };
+    for (int i = first; i < last; ++i) {
+      const std::optional<tab_groups::TabGroupId> group =
+          model_->GetTabGroupForTab(i);
+      if (starts_group(i)) {
+        entries.push_back({i, group});
+      }
+      if (!group || !model_->IsGroupCollapsed(*group)) {
+        entries.push_back({i, std::nullopt});
+      }
+    }
+    if (side_ == Side::kBeforeActive && starts_group(active)) {
+      entries.push_back({active, model_->GetTabGroupForTab(active)});
+    }
   }
-  while (children().size() < wanted) {
-    AddChildView(std::make_unique<CompactTabChip>(model_));
+
+  // The views already there stay where they are, so a menu open or a drag

+// The label of a group of tabs, in its color, before its first tab: a click
+// closes or opens the group; closed, it says how many tabs it holds.
+class CompactGroupHeader : public views::LabelButton {
+  METADATA_HEADER(CompactGroupHeader, views::LabelButton)
+
+ public:
+  explicit CompactGroupHeader(TabStripModel* model)
+      : views::LabelButton(base::BindRepeating(&CompactGroupHeader::OnPressed,
+                                               base::Unretained(this))),
+        model_(model) {
+    SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(0, 10)));
+    SetMinSize(gfx::Size(kChipHeight, kChipHeight));
+    SetMaxSize(gfx::Size(kChipMaxWidth, kChipHeight));
+    SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  }
+
+  void SetGroup(const tab_groups::TabGroupId& group) {
+    group_ = group;
+    const TabGroup* tab_group = GroupOf(model_, group_);
+    if (!tab_group) {
+      return;
+    }
+    const tab_groups::TabGroupVisualData* visuals = tab_group->visual_data();
+    std::u16string text = visuals->title();
+    if (visuals->is_collapsed()) {
+      const std::u16string count =
+          base::NumberToString16(tab_group->tab_count());
+      text = text.empty() ? count : text + u" · " + count;
+    }
+    SetText(text);
+    const std::u16string name =
+        (visuals->title().empty() ? u"Gruppo di schede" : visuals->title()) +
+        (visuals->is_collapsed() ? u", chiuso: clic per aprirlo"
+                                 : u", aperto: clic per chiuderlo");
+    SetTooltipText(name);
+    GetViewAccessibility().SetName(name);
+    UpdateColors();
+  }
+
+  // views::View:
+  gfx::Size GetMinimumSize() const override {
+    return gfx::Size(kChipHeight, kChipHeight);
+  }
+
+  void OnThemeChanged() override {
+    views::LabelButton::OnThemeChanged();
+    UpdateColors();
+  }
+
+ private:
+  void UpdateColors() {
+    const TabGroup* tab_group = GroupOf(model_, group_);
+    if (!GetColorProvider() || !tab_group) {
+      return;
+    }
+    const SkColor color = GetColorProvider()->GetColor(
+        GetTabGroupTabStripColorId(tab_group->visual_data()->color(),
+                                   /*active_frame=*/true));
+    SetBackground(views::CreateRoundedRectBackground(color, kChipHeight / 2));
+    const SkColor text = color_utils::GetColorWithMaxContrast(color);
+    SetTextColor(ButtonState::STATE_NORMAL, text);
+    SetTextColor(ButtonState::STATE_HOVERED, text);
+    SetTextColor(ButtonState::STATE_PRESSED, text);
+  }
+
+  void OnPressed() {
+    const TabGroup* tab_group = GroupOf(model_, group_);
+    if (!tab_group) {
+      return;
+    }
+    tab_groups::TabGroupVisualData visuals = *tab_group->visual_data();
+    const bool collapse = !visuals.is_collapsed();
+    // The tab shown can't stay in a closed group: as in Chromium, the first
+    // tab outside the group takes its place, and with none the group stays.
+    if (collapse && model_->GetTabGroupForTab(model_->active_index()) ==
+                        group_) {
+      const gfx::Range tabs = tab_group->ListTabs();
+      const int next = static_cast<int>(tabs.end()) < model_->count()
+                           ? static_cast<int>(tabs.end())
+                           : static_cast<int>(tabs.start()) - 1;
+      if (next < 0) {
+        return;
+      }
+      model_->ActivateTabAt(next);
+    }
+    model_->ChangeTabGroupVisuals(
+        *group_, tab_groups::TabGroupVisualData(visuals.title(),
+                                                visuals.color(), collapse));
+  }
+
+  const raw_ptr<TabStripModel> model_;
+  std::optional<tab_groups::TabGroupId> group_;
+};
+
+BEGIN_METADATA(CompactGroupHeader)
+END_METADATA

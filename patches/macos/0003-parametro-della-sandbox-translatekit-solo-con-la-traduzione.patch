From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shadowsangel96 <188833096+shadowsangel96@users.noreply.github.com>
Date: Fri, 30 Oct 2026 18:29:36 +0100
Subject: [PATCH] mac: parametro della sandbox TranslateKit solo con la
 traduzione sul dispositivo
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Cromite spegne enable_on_device_translation: l'include del ComponentManager è sotto
quel buildflag, il suo uso nel codice solo-Mac no, e non compilava.

Fork-Patch: macos/0003-parametro-della-sandbox-translatekit-solo-con-la-traduzione.patch

diff --git a/chrome/browser/chrome_content_browser_client.cc b/chrome/browser/chrome_content_browser_client.cc
index 0406177735b127195f98f55bc5277a2fb6563ab0..18d3ac9e2989631149cb4fe5da8261a2d9f3e5c4 100644
--- a/chrome/browser/chrome_content_browser_client.cc
+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -8390,6 +8390,7 @@ bool ChromeContentBrowserClient::SetupEmbedderSandboxParameters(
         sandbox::policy::kParamScreenAiComponentPath,
         screen_ai_binary_path.value());
   }
+#if BUILDFLAG(ENABLE_ON_DEVICE_TRANSLATION)
   if (sandbox_type == sandbox::mojom::Sandbox::kOnDeviceTranslation) {
     auto translatekit_binary_path =
         on_device_translation::ComponentManager::GetInstance()
@@ -8402,6 +8403,7 @@ bool ChromeContentBrowserClient::SetupEmbedderSandboxParameters(
         sandbox::policy::kParamTranslatekitComponentPath,
         translatekit_binary_path.value());
   }
+#endif  // BUILDFLAG(ENABLE_ON_DEVICE_TRANSLATION)
 
   return false;
 }

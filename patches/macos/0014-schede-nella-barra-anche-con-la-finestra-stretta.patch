+#if BUILDFLAG(IS_MAC)
+ToolbarView::CompactRow ToolbarView::ComputeCompactRow() const {
+  constexpr int kAddressMin = 180;
+  constexpr int kAddressMax = 460;
+
+  // The room of the row: the toolbar without its margins and the buttons
+  // that always stay. The ones that can go in the ">>" menu come later.
+  const int default_margin =
+      GetLayoutConstant(LayoutConstant::kToolbarIconDefaultMargin);
+  const auto margin = [default_margin](const views::View* child) {
+    const gfx::Insets* insets = child->GetProperty(views::kMarginsKey);
+    return insets ? (insets->left() + insets->right()) / 2 : default_margin;
+  };
+  int free = width() - layout_manager_->interior_margin().width();
+  int optional = 0;
+  int icons = 0;
+  int full = 0;
+  CompactRow row;
+  for (const views::View* child : children()) {
+    if (!child->GetVisible() || views::IsViewClass<CompactTabsSpacer>(child)) {
+      continue;
+    }
+    free -= margin(child);
+    if (child == location_bar_view_) {
+      continue;
+    }
+    if (const auto* tabs = views::AsViewClass<CompactTabsView>(child)) {
+      icons += tabs->IconRowWidth();
+      full += std::max(tabs->IconRowWidth(), tabs->GetPreferredSize().width());
+      continue;
+    }
+    if (const auto* pill = views::AsViewClass<VpnStatusButton>(child)) {
+      free -= pill->GetMinimumSize().width();
+      row.pill_text = pill->GetFullWidth() - pill->GetMinimumSize().width();
+      optional += row.pill_text;
+    } else if (child->GetProperty(views::kFlexBehaviorKey)) {
+      optional += child->GetPreferredSize().width();
+    } else {
+      free -= child->GetPreferredSize().width();
+    }
+  }
+
+  // In turn: the address at its smallest, the icons of the tabs (or as many
+  // as fit, the others in their "+N" chip), the buttons that can go in the
+  // ">>" menu and the text of the pill, the address up to its widest, then
+  // the titles of the tabs.
+  free -= kAddressMin;
+  row.tabs = std::clamp(free, 0, icons);
+  free -= row.tabs;
+  row.pill_full = free >= row.pill_text;
+  free = std::max(free - optional, 0);
+  const int grow = std::min(free, kAddressMax - kAddressMin);
+  row.address = kAddressMin + grow;
+  row.tabs += std::min(free - grow, full - icons);
+  row.icons = icons;
+  row.full = full;
+  return row;
+}
+
+gfx::Size ToolbarView::CompactRowRule(const views::View* view,
+                                      const views::SizeBounds& bounds) const {
+  const int height = view->GetPreferredSize().height();
+  const CompactRow row = ComputeCompactRow();
+  const bool unbounded = !bounds.width().is_bounded();
+
+  if (view == location_bar_view_) {
+    return gfx::Size(unbounded ? row.address
+                               : std::max(std::min(row.address, 180),
+                                          std::min(bounds.width().value(),
+                                                   row.address)),
+                     height);
+  }
+
+  if (const auto* pill = views::AsViewClass<VpnStatusButton>(view)) {
+    const int full = pill->GetFullWidth();
+    return gfx::Size(
+        row.pill_full && (unbounded || bounds.width().value() >= full)
+            ? full
+            : pill->GetMinimumSize().width(),
+        height);
+  }
+
+  // The tabs come after the address and the pill, with what is really left:
+  // their part of it, by the room they need.
+  const auto* tabs = views::AsViewClass<CompactTabsView>(view);
+  if (!tabs || unbounded) {
+    return gfx::Size(view->GetPreferredSize().width(), height);
+  }
+  const int icons = tabs->IconRowWidth();
+  const int full = std::max(icons, tabs->GetPreferredSize().width());
+  int width = 0;
+  if (row.icons && row.tabs <= row.icons) {
+    width = row.tabs * icons / row.icons;
+  } else if (row.icons) {
+    width = icons + (row.full > row.icons ? (row.tabs - row.icons) *
+                                                (full - icons) /
+                                                (row.full - row.icons)
+                                          : 0);
+  }
+  return gfx::Size(std::min(bounds.width().value(), std::max(width, icons)),
+                   height);
+}

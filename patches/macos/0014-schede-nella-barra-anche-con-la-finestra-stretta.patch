+// The tabs that don't fit in the row: the chip says how many, its menu lists
+// them.
+class CompactOverflowChip : public views::LabelButton,
+                            public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(CompactOverflowChip, views::LabelButton)
+
+ public:
+  CompactOverflowChip(TabStripModel* model,
+                      base::RepeatingCallback<std::vector<int>()> hidden)
+      : views::LabelButton(base::BindRepeating(&CompactOverflowChip::OnPressed,
+                                               base::Unretained(this))),
+        model_(model),
+        hidden_(std::move(hidden)) {
+    SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(0, 8)));
+    SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    SetMinSize(gfx::Size(kOverflowWidth, kChipHeight));
+    SetMaxSize(gfx::Size(kOverflowWidth, kChipHeight));
+  }
+
+  void SetCount(int count) {
+    if (count == count_) {
+      return;
+    }
+    count_ = count;
+    SetText(u"+" + base::NumberToString16(count));
+    const std::u16string name =
+        count == 1 ? u"Un'altra scheda"
+                   : u"Altre " + base::NumberToString16(count) + u" schede";
+    SetTooltipText(name);
+    GetViewAccessibility().SetName(name);
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kOverflowWidth, kChipHeight);
+  }
+
+  void OnThemeChanged() override {
+    views::LabelButton::OnThemeChanged();
+    UpdateColors();
+  }
+
+  void StateChanged(ButtonState old_state) override {
+    views::LabelButton::StateChanged(old_state);
+    UpdateColors();
+  }
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override {
+    if (model_->ContainsIndex(command_id)) {
+      model_->ActivateTabAt(
+          command_id, TabStripUserGestureDetails(
+                          TabStripUserGestureDetails::GestureType::kMouse));
+    }
+  }
+
+ private:
+  void UpdateColors() {
+    if (!GetColorProvider()) {
+      return;
+    }
+    const bool dark =
+        color_utils::IsDark(GetColorProvider()->GetColor(kColorToolbar));
+    const bool hovered = GetState() != ButtonState::STATE_NORMAL;
+    SetBackground(views::CreateRoundedRectBackground(
+        dark ? SkColorSetA(SK_ColorWHITE, hovered ? 0x2e : 0x1a)
+             : SkColorSetA(SK_ColorBLACK, hovered ? 0x1f : 0x12),
+        kChipHeight / 2));
+    const SkColor text = dark ? SkColorSetRGB(0xf5, 0xf5, 0xf7)
+                              : SkColorSetRGB(0x1d, 0x1d, 0x1f);
+    SetTextColor(ButtonState::STATE_NORMAL, text);
+    SetTextColor(ButtonState::STATE_HOVERED, text);
+    SetTextColor(ButtonState::STATE_PRESSED, text);
+  }
+
+  void OnPressed(const ui::Event& event) {
+    menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    for (int index : hidden_.Run()) {
+      if (!model_->ContainsIndex(index)) {
+        continue;
+      }
+      content::WebContents* contents = model_->GetWebContentsAt(index);
+      const gfx::Image favicon = favicon::TabFaviconFromWebContents(contents);
+      menu_model_->AddItemWithIcon(
+          index,
+          contents->GetTitle().empty() ? u"Scheda" : contents->GetTitle(),
+          ui::ImageModel::FromImage(
+              favicon.IsEmpty() ? favicon::GetDefaultFavicon() : favicon));
+    }
+    if (!menu_model_->GetItemCount()) {
+      return;
+    }
+    menu_runner_ = std::make_unique<views::MenuRunner>(
+        menu_model_.get(), views::MenuRunner::NO_FLAGS);
+    menu_runner_->RunMenuAt(GetWidget(), nullptr, GetAnchorBoundsInScreen(),
+                            views::MenuAnchorPosition::kTopLeft,
+                            ui::mojom::MenuSourceType::kMouse);
+  }
+
+  const raw_ptr<TabStripModel> model_;
+  const base::RepeatingCallback<std::vector<int>()> hidden_;
+  int count_ = -1;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+};

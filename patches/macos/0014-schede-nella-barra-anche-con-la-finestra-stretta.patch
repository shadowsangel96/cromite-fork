+  full_label_ = label;
+  color_ = PillColor(route,
+                     color_utils::IsDark(colors->GetColor(kColorToolbar)));
+  // The widths of the button with each text, from its insets and its label:
+  // the button itself grows to a new text with an animation.
+  SetHighlight(u"●", color_);
+  dot_width_ = GetInsets().width() + this->label()->GetPreferredSize().width() + 4;
+  SetHighlight(full_label_, color_);
+  full_width_ = GetInsets().width() + this->label()->GetPreferredSize().width() + 4;
+  ShowLabel();
+}
+
+gfx::Size VpnStatusButton::GetMinimumSize() const {
+  return gfx::Size(dot_width_, ToolbarButton::GetMinimumSize().height());
+}
+
+void VpnStatusButton::OnBoundsChanged(const gfx::Rect& previous_bounds) {
+  ToolbarButton::OnBoundsChanged(previous_bounds);
+  const bool dot_only = width() > 0 && width() < full_width_;
+  if (dot_only != dot_only_) {
+    dot_only_ = dot_only;
+    ShowLabel();
+  }
+}
+
+void VpnStatusButton::ShowLabel() {
+  if (full_label_.empty()) {
+    return;
+  }
+  SetHighlight(dot_only_ ? u"●" : full_label_, color_);
+  // The name stays the whole text, also when only the dot shows.
+  GetViewAccessibility().SetName(full_label_.substr(2));
 }
 

+std::vector<views::View*> CompactTabsView::Items() const {
+  std::vector<views::View*> items;
+  for (views::View* child : children()) {
+    if (child != overflow_) {
+      items.push_back(child);
+    }
+  }
+  return items;
+}
+
+int CompactTabsView::IconRowWidth() const {
+  const std::vector<views::View*> items = Items();
+  if (!GetVisible() || items.empty()) {
+    return 0;
+  }
+  int width = 0;
+  for (views::View* item : items) {
+    width += item->GetMinimumSize().width();
+  }
+  return width + (static_cast<int>(items.size()) - 1) * kChipGap;
+}
+
+gfx::Size CompactTabsView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  const std::vector<views::View*> items = Items();
+  int width = 0;
+  for (views::View* item : items) {
+    width += std::clamp(item->GetPreferredSize().width(),
+                        item->GetMinimumSize().width(), kChipMaxWidth);
+  }
+  width += std::max(static_cast<int>(items.size()) - 1, 0) * kChipGap;
+  return gfx::Size(width, kChipHeight);
+}
+
+void CompactTabsView::Layout(PassKey) {
+  const std::vector<views::View*> items = Items();
+  const int count = static_cast<int>(items.size());
+  std::vector<int> min(count);
+  std::vector<int> preferred(count);
+  for (int i = 0; i < count; ++i) {
+    min[i] = items[i]->GetMinimumSize().width();
+    preferred[i] =
+        std::clamp(items[i]->GetPreferredSize().width(), min[i], kChipMaxWidth);
+  }
+  // The width of the items from `first` to `last`, at their smallest, with
+  // or without the "+N" chip.
+  const auto smallest = [&](int first, int last, bool with_overflow) {
+    int width = with_overflow ? kOverflowWidth : 0;
+    for (int i = first; i < last; ++i) {
+      width += min[i];
+    }
+    const int pieces = last - first + (with_overflow ? 1 : 0);
+    return width + std::max(pieces - 1, 0) * kChipGap;
+  };
+
+  // When even the icons don't fit, the tabs farthest from the address go in
+  // the "+N" chip.
+  const int available = width();
+  int first = 0;
+  int last = count;
+  const bool overflow = count > 0 && smallest(0, count, false) > available;
+  if (overflow) {
+    while (last > first && smallest(first, last, true) > available) {
+      if (side_ == Side::kBeforeActive) {
+        ++first;
+      } else {
+        --last;
+      }
+    }
+  }
+
+  // The rest goes to the titles, nearest to the address first: as many tabs
+  // as can show a few letters get an equal part, the others stay icons.
+  std::vector<int> grow(count, 0);
+  int extra = std::max(available - smallest(first, last, overflow), 0);
+  std::vector<int> nearest;
+  for (int k = 0; k < last - first; ++k) {
+    const int i = side_ == Side::kBeforeActive ? last - 1 - k : first + k;
+    if (preferred[i] > min[i]) {
+      nearest.push_back(i);
+    }
+  }
+  const int titled =
+      std::min(static_cast<int>(nearest.size()), extra / kMinTitleWidth);
+  for (int k = 0; k < titled; ++k) {
+    const int i = nearest[k];
+    grow[i] = std::min(preferred[i] - min[i], extra / (titled - k));
+    extra -= grow[i];
+  }
+
+  // The row stays against the address when it doesn't fill its room.
+  int used = smallest(first, last, overflow);
+  for (int g : grow) {
+    used += g;
+  }
+  hidden_.clear();
+  const int y = (height() - kChipHeight) / 2;
+  int x = side_ == Side::kBeforeActive ? std::max(available - used, 0) : 0;
+  const bool show_overflow = overflow && available >= kOverflowWidth;
+  if (show_overflow && side_ == Side::kBeforeActive) {
+    overflow_->SetBounds(x, y, kOverflowWidth, kChipHeight);
+    x += kOverflowWidth + kChipGap;
+  }
+  for (int i = 0; i < count; ++i) {
+    const bool shown = i >= first && i < last;
+    if (!shown) {
+      if (auto* tab = views::AsViewClass<CompactTabChip>(items[i])) {
+        hidden_.push_back(tab->index());
+      }
+      items[i]->SetVisible(false);
+      continue;
+    }
+    items[i]->SetVisible(true);
+    items[i]->SetBounds(x, y, min[i] + grow[i], kChipHeight);
+    x += min[i] + grow[i] + kChipGap;
+  }
+  if (show_overflow && side_ == Side::kAfterActive) {
+    overflow_->SetBounds(x, y, kOverflowWidth, kChipHeight);
+  }
+  static_cast<CompactOverflowChip*>(overflow_.get())
+      ->SetCount(static_cast<int>(hidden_.size()));
+  overflow_->SetVisible(show_overflow && !hidden_.empty());
+}

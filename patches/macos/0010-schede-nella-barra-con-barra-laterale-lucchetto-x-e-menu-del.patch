+  void UpdateCloseIcon() {
+    if (!GetColorProvider()) {
+      return;
+    }
+    const bool dark =
+        color_utils::IsDark(GetColorProvider()->GetColor(kColorToolbar));
+    SetImageModel(
+        views::Button::STATE_HOVERED,
+        ui::ImageModel::FromImageSkia(

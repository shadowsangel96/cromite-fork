+                dark ? SkColorSetRGB(0xf5, 0xf5, 0xf7)
+                     : SkColorSetRGB(0x1d, 0x1d, 0x1f))));
+    SetImageModel(views::Button::STATE_PRESSED,
+                  GetImageModel(views::Button::STATE_HOVERED));
+  }
+
+  bool IsOnCloseIcon(const ui::Event& event) const {

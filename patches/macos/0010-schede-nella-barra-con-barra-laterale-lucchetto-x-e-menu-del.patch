+class SidebarButton : public ToolbarButton {
+  METADATA_HEADER(SidebarButton, ToolbarButton)
+
+ public:
+  explicit SidebarButton(BrowserWindowInterface* browser)
+      : ToolbarButton(base::BindRepeating(
+            [](BrowserWindowInterface* browser) {
+              if (SidePanelUI* side_panel =
+                      browser->GetFeatures().side_panel_ui()) {
+                side_panel->Toggle(
+                    SidePanelEntryKey(SidePanelEntryId::kBookmarks),
+                    SidePanelOpenTrigger::kToolbarButton);
+              }
+            },
+            browser)) {
+    GetViewAccessibility().SetName(u"Barra laterale");
+    SetTooltipText(u"Barra laterale");
+    SetProperty(browser_fork::kSidebarButtonKey, true);
+    SetProperty(views::kMarginsKey, gfx::Insets::VH(0, 6));
+  }
+
+  // ToolbarButton:
+  void UpdateIcon() override {
+    if (!GetColorProvider()) {
+      return;
+    }
+    SetImageModel(views::Button::STATE_NORMAL,
+                  ui::ImageModel::FromImageSkia(
+                      gfx::CanvasImageSource::MakeImageSkia<SidebarImageSource>(
+                          GetColorProvider()->GetColor(
+                              kColorToolbarButtonIcon))));
+  }
+};

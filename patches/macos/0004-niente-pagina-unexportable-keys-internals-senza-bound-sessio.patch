From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shadowsangel96 <188833096+shadowsangel96@users.noreply.github.com>
Date: Fri, 30 Oct 2026 18:43:28 +0100
Subject: [PATCH] mac: niente pagina unexportable-keys-internals senza bound
 session credentials
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Cromite mette enable_bound_session_credentials = false: UnexportableKeyServiceFactory
e GetDefaultConfig non si compilano, ma la pagina solo-Mac li usa e il link di
Chromium Framework falliva. Senza quella funzione la pagina non serve: non si
registra, e la creazione del gestore non si raggiunge più.

Fork-Patch: macos/0004-niente-pagina-unexportable-keys-internals-senza-bound-sessio.patch

diff --git a/chrome/browser/ui/webui/chrome_web_ui_configs.cc b/chrome/browser/ui/webui/chrome_web_ui_configs.cc
index c68556e8dc8678981597b210212ff7ea0f08d5e9..51f82d1ea037de3d35e9195113db4dcbfef9602e 100644
--- a/chrome/browser/ui/webui/chrome_web_ui_configs.cc
+++ b/chrome/browser/ui/webui/chrome_web_ui_configs.cc
@@ -240,6 +240,7 @@
 
 #if BUILDFLAG(IS_MAC)
 #include "chrome/browser/ui/webui/unexportable_keys_internals/unexportable_keys_internals_ui.h"
+#include "components/signin/public/base/signin_buildflags.h"
 #endif  // BUILDFLAG(IS_MAC)
 
 #if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX) || \
@@ -503,9 +504,9 @@ void RegisterChromeWebUIConfigs() {
   map.AddWebUIConfig(std::make_unique<WatermarkUIConfig>());
 #endif
 
-#if BUILDFLAG(IS_MAC)
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(ENABLE_BOUND_SESSION_CREDENTIALS)
   map.AddWebUIConfig(std::make_unique<UnexportableKeysInternalsUIConfig>());
-#endif  // BUILDFLAG(IS_MAC)
+#endif  // BUILDFLAG(IS_MAC) && BUILDFLAG(ENABLE_BOUND_SESSION_CREDENTIALS)
 
 #if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX) || \
     BUILDFLAG(IS_CHROMEOS)
diff --git a/chrome/browser/ui/webui/unexportable_keys_internals/BUILD.gn b/chrome/browser/ui/webui/unexportable_keys_internals/BUILD.gn
index 7b0e52c9e582265b17555385a650710be0990487..cfc4d45ff02d5abe8c69a496436079be7e787e1a 100644
--- a/chrome/browser/ui/webui/unexportable_keys_internals/BUILD.gn
+++ b/chrome/browser/ui/webui/unexportable_keys_internals/BUILD.gn
@@ -58,6 +58,7 @@ source_set("impl") {
   public_deps = [ "//chrome/browser:browser_public_dependencies" ]
 
   deps = [
+    "//components/signin/public/base:signin_buildflags",
     ":unexportable_keys_internals",
     "//base",
     "//chrome/browser/profiles:profile",
diff --git a/chrome/browser/ui/webui/unexportable_keys_internals/unexportable_keys_internals_ui.cc b/chrome/browser/ui/webui/unexportable_keys_internals/unexportable_keys_internals_ui.cc
index ab10831503711b5339f1783acab3906e92e2cd67..7e2fef885ee5f7d6f2eddca5402f609cd5978ac3 100644
--- a/chrome/browser/ui/webui/unexportable_keys_internals/unexportable_keys_internals_ui.cc
+++ b/chrome/browser/ui/webui/unexportable_keys_internals/unexportable_keys_internals_ui.cc
@@ -9,6 +9,7 @@
 
 #include "base/check_deref.h"
 #include "base/feature_list.h"
+#include "base/notreached.h"
 #include "chrome/browser/profiles/profile.h"
 #include "chrome/browser/signin/bound_session_credentials/unexportable_key_provider_config.h"
 #include "chrome/browser/signin/bound_session_credentials/unexportable_key_service_factory.h"
@@ -16,6 +17,7 @@
 #include "chrome/common/webui_url_constants.h"
 #include "chrome/grit/unexportable_keys_internals_resources.h"
 #include "chrome/grit/unexportable_keys_internals_resources_map.h"
+#include "components/signin/public/base/signin_buildflags.h"
 #include "components/unexportable_keys/features.h"
 #include "content/public/browser/web_ui.h"
 #include "content/public/browser/web_ui_data_source.h"
@@ -48,10 +50,15 @@ void UnexportableKeysInternalsUI::BindInterface(
 void UnexportableKeysInternalsUI::CreateUnexportableKeysInternalsHandler(
     mojo::PendingReceiver<unexportable_keys_internals::mojom::PageHandler>
         receiver) {
+#if BUILDFLAG(ENABLE_BOUND_SESSION_CREDENTIALS)
   page_handler_ = std::make_unique<UnexportableKeysInternalsHandler>(
       std::move(receiver),
       UnexportableKeyServiceFactory::CreateForGarbageCollection(
           unexportable_keys::GetDefaultConfig()));
+#else
+  // Without bound session credentials the page is not registered.
+  NOTREACHED();
+#endif  // BUILDFLAG(ENABLE_BOUND_SESSION_CREDENTIALS)
 }
 
 WEB_UI_CONTROLLER_TYPE_IMPL(UnexportableKeysInternalsUI)

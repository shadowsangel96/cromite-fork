@@ -64,6 +66,12 @@
   raw_ptr<BrowserView> browser_view_;
 };
 
+// With the tabs in the toolbar there is no tab strip: the toolbar goes in the
+// titlebar in its place, next to the window buttons, as in the windowed mode.
+bool ToolbarInTitlebar(BrowserView* browser_view) {
+  return browser_view->GetProperty(browser_fork::kCompactTabsKey);
+}
+
 }  // namespace
 
 ImmersiveModeControllerMac::RevealedLock::RevealedLock(
@@ -102,7 +110,22 @@
   if (enabled) {
     // Vertical tab strip should stay visible and will not be reparented to the
     // tab overlay.
-    if (separate_tab_strip_ && !browser_view_->ShouldDrawVerticalTabStrip()) {
+    if (separate_tab_strip_ && ToolbarInTitlebar(browser_view_)) {
+      views::View* toolbar = browser_view_->toolbar();
+      toolbar_index_ = browser_view_->top_container()->GetIndexOf(toolbar);
+      tab_widget_height_ = toolbar->GetPreferredSize().height();
+      browser_view_->tab_overlay_widget()->SetSize(gfx::Size(
+          browser_view_->top_container()->size().width(), tab_widget_height_));
+      browser_view_->tab_overlay_widget()->Show();
+      browser_view_->tab_overlay_view()->AddChildViewRaw(toolbar);
+      LayOutToolbarInTitlebar();
+
+      views::NativeWidgetMacNSWindowHost* tab_overlay_host =
+          views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+              browser_view_->tab_overlay_widget()->GetNativeWindow());
+      SetTabNativeWidgetID(tab_overlay_host->bridged_native_widget_id());
+    } else if (separate_tab_strip_ &&
+               !browser_view_->ShouldDrawVerticalTabStrip()) {
       tab_widget_height_ = browser_view_->tab_strip_view()->height();
       tab_widget_height_ += static_cast<BrowserFrameViewMac*>(
                                 browser_view_->browser_widget()->GetFrameView())
@@ -193,6 +216,13 @@
       browser_view_->tab_overlay_widget()->Hide();
       browser_view_->tab_strip_view()->SetBorder(nullptr);
     }
+    // The toolbar back in its place, before the top container leaves the
+    // overlay.
+    if (toolbar_index_) {
+      browser_view_->top_container()->AddChildViewAt(browser_view_->toolbar(),
+                                                     *toolbar_index_);
+      toolbar_index_.reset();
+    }
     // Reset tab widget state so that re-entering fullscreen with a different
     // tab layout (e.g. vertical tabs) does not carry over stale values from a
     // previous horizontal-tab fullscreen session.
@@ -233,6 +263,15 @@
   }
 }
 
+void ImmersiveModeControllerMac::LayOutToolbarInTitlebar() {
+  // The space of the window buttons stays free, as for the tab strip.
+  gfx::Rect bounds(browser_view_->tab_overlay_view()->size());
+  bounds.Inset(GetTabStripRegionViewInsets());
+  bounds.set_y(0);
+  bounds.set_height(tab_widget_height_);
+  browser_view_->toolbar()->SetBoundsRect(bounds);
+}
+
 // LINT.IfChange(MacTabStripInsets)
 gfx::Insets ImmersiveModeControllerMac::GetTabStripRegionViewInsets() {
   // TODO(crbug.com/40892148): Get this dynamically. Unfortunately the
@@ -351,7 +390,9 @@
 void ImmersiveModeControllerMac::OnViewBoundsChanged(
     views::View* observed_view) {
   gfx::Rect bounds = observed_view->bounds();
-  if (bounds.IsEmpty()) {
+  // Without the toolbar the top container can be empty in height: the
+  // titlebar still follows its width.
+  if (bounds.IsEmpty() && !(toolbar_index_ && bounds.width() > 0)) {
     return;
   }
   overlay_height_ = bounds.height();
@@ -360,7 +401,14 @@
   // OnViewBoundsChanged does not get called.
   // tab_overlay_widget size should only be set if we aren't drawing the
   // vertical tabstrip.
-  if (separate_tab_strip_ && !browser_view_->ShouldDrawVerticalTabStrip()) {
+  if (toolbar_index_) {
+    gfx::Size new_size(bounds.width(), tab_widget_height_);
+    browser_view_->tab_overlay_widget()->SetSize(new_size);
+    browser_view_->tab_overlay_view()->SetSize(new_size);
+    LayOutToolbarInTitlebar();
+    overlay_height_ += tab_widget_height_;
+  } else if (separate_tab_strip_ &&
+             !browser_view_->ShouldDrawVerticalTabStrip()) {
     gfx::Size new_size(bounds.width(), tab_widget_height_);
     browser_view_->tab_overlay_widget()->SetSize(new_size);
     browser_view_->tab_overlay_view()->SetSize(new_size);
@@ -467,7 +515,8 @@
   // displayed in the titlebar.
   views::View* anchor_view = bubble_dialog->GetAnchorView();
   if (anchor_view && (browser_view_->top_container()->Contains(anchor_view) ||
-                      browser_view_->tab_strip_view()->Contains(anchor_view))) {
+                      browser_view_->tab_strip_view()->Contains(anchor_view) ||
+                      browser_view_->toolbar()->Contains(anchor_view))) {
     return true;
   }
 

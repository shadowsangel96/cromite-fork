@@ -129,6 +131,9 @@ class ImmersiveModeControllerMac : public ImmersiveModeController,
 
   gfx::Insets GetTabStripRegionViewInsets();
 
+  // Places the toolbar in the titlebar, next to the window buttons.
+  void LayOutToolbarInTitlebar();
+
   // Invoked when the associated browser is closed.
   void BrowserDidClose(BrowserWindowInterface* browser);
 
@@ -153,6 +158,9 @@ class ImmersiveModeControllerMac : public ImmersiveModeController,
   // Height of the tab widget, used when resizing. Only non-zero if
   // `separate_tab_strip_` is true.
   int tab_widget_height_ = 0;
+  // Where the toolbar was in the top container, while it is in the titlebar
+  // in place of the tab strip (tabs in the toolbar).
+  std::optional<size_t> toolbar_index_;
   // Total height of the overlay (including the separate tab strip if relevant).
   int overlay_height_ = 0;
   // Whether the find bar is currently visible.
diff --git a/chrome/browser/ui/views/frame/immersive_mode_controller_mac.mm b/chrome/browser/ui/views/frame/immersive_mode_controller_mac.mm
index fdbb4cf741eb3de803fdf4b053813d8f1ad2d16e..8caa110da1b9b98cbd823e0841912eddb882a780 100644

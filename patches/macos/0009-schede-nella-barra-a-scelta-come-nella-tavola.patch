@@ -0,0 +1,216 @@
+#include "chrome/browser/ui/views/toolbar/compact_tabs_view.h"
+
+#include <algorithm>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/favicon/favicon_utils.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_user_gesture_details.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/color/color_provider.h"
+#include "ui/events/event.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/background.h"
+#include "ui/views/controls/button/label_button.h"
+#include "ui/views/layout/flex_layout.h"
+#include "ui/views/view_class_properties.h"
+
+namespace browser_fork {
+
+DEFINE_UI_CLASS_PROPERTY_KEY(bool, kCompactTabsKey, false)
+
+}  // namespace browser_fork
+
+namespace {
+
+constexpr int kChipHeight = 30;
+constexpr int kChipMaxWidth = 150;
+// Enough for the icon alone when many tabs have to fit.
+constexpr int kChipMinWidth = 36;
+constexpr int kChipGap = 8;
+// After every button of the toolbar, which would otherwise go in the overflow
+// menu to make room for the tabs; only the empty space comes later.
+constexpr int kTabsFlexOrder = 1900;
+
+class CompactTabChip : public views::LabelButton {
+  METADATA_HEADER(CompactTabChip, views::LabelButton)
+
+ public:
+  explicit CompactTabChip(TabStripModel* model)
+      : views::LabelButton(base::BindRepeating(&CompactTabChip::OnPressed,
+                                               base::Unretained(this))),
+        model_(model) {
+    SetTriggerableEventFlags(ui::EF_LEFT_MOUSE_BUTTON |
+                             ui::EF_MIDDLE_MOUSE_BUTTON);
+    SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(0, 10)));
+    SetImageLabelSpacing(7);
+    SetMaxSize(gfx::Size(kChipMaxWidth, kChipHeight));
+    SetMinSize(gfx::Size(0, kChipHeight));
+    SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(
+            views::MinimumFlexSizeRule::kScaleToMinimumSnapToZero,
+            views::MaximumFlexSizeRule::kPreferred));
+  }
+
+  void SetTab(int index) {
+    index_ = index;
+    content::WebContents* contents = model_->GetWebContentsAt(index);
+    const std::u16string title = contents->GetTitle();
+    SetText(title);
+    SetTooltipText(title);
+    GetViewAccessibility().SetName(title);
+    const gfx::Image favicon = favicon::TabFaviconFromWebContents(contents);
+    SetImageModel(views::Button::STATE_NORMAL,
+                  ui::ImageModel::FromImage(
+                      favicon.IsEmpty() ? favicon::GetDefaultFavicon() : favicon));
+  }
+
+  // views::View:
+  gfx::Size GetMinimumSize() const override {
+    return gfx::Size(kChipMinWidth, kChipHeight);
+  }
+
+  void OnThemeChanged() override {
+    views::LabelButton::OnThemeChanged();
+    const bool dark =
+        color_utils::IsDark(GetColorProvider()->GetColor(kColorToolbar));
+    const SkColor text = dark ? SkColorSetRGB(0xf5, 0xf5, 0xf7)
+                              : SkColorSetRGB(0x1d, 0x1d, 0x1f);
+    SetTextColor(ButtonState::STATE_NORMAL, text);
+    SetTextColor(ButtonState::STATE_HOVERED, text);
+    SetTextColor(ButtonState::STATE_PRESSED, text);
+    UpdateBackground();
+  }
+
+  void StateChanged(ButtonState old_state) override {
+    views::LabelButton::StateChanged(old_state);
+    UpdateBackground();
+  }
+
+ private:
+  void UpdateBackground() {
+    if (!GetColorProvider()) {
+      return;
+    }
+    const bool dark =
+        color_utils::IsDark(GetColorProvider()->GetColor(kColorToolbar));
+    const bool hovered = GetState() != ButtonState::STATE_NORMAL;
+    SetBackground(views::CreateRoundedRectBackground(
+        dark ? SkColorSetA(SK_ColorWHITE, hovered ? 0x2e : 0x1a)
+             : SkColorSetA(SK_ColorBLACK, hovered ? 0x1f : 0x12),
+        kChipHeight / 2));
+  }
+
+  void OnPressed(const ui::Event& event) {
+    if (!model_->ContainsIndex(index_)) {
+      return;
+    }
+    if (event.IsMouseEvent() &&
+        event.AsMouseEvent()->IsOnlyMiddleMouseButton()) {
+      model_->CloseWebContentsAt(index_, TabCloseTypes::CLOSE_USER_GESTURE);
+      return;
+    }
+    model_->ActivateTabAt(index_,
+                          TabStripUserGestureDetails(
+                              TabStripUserGestureDetails::GestureType::kMouse));
+  }
+
+  const raw_ptr<TabStripModel> model_;
+  int index_ = TabStripModel::kNoTab;
+};
+
+BEGIN_METADATA(CompactTabChip)
+END_METADATA
+
+gfx::Size SmallestUntilBounded(int chips,
+                               const views::View* view,
+                               const views::SizeBounds& bounds) {
+  const int width =
+      bounds.width().is_bounded()
+          ? std::min(bounds.width().value(), view->GetPreferredSize().width())
+          : chips * kChipMinWidth + std::max(chips - 1, 0) * kChipGap;
+  return gfx::Size(width, kChipHeight);
+}
+
+}  // namespace
+
+CompactTabsSpacer::CompactTabsSpacer() {
+  SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                               views::MaximumFlexSizeRule::kUnbounded)
+          .WithOrder(2000));
+  SetProperty(views::kMarginsKey, gfx::Insets());
+}
+
+void CompactTabsSpacer::OnPaint(gfx::Canvas* canvas) {}
+
+BEGIN_METADATA(CompactTabsSpacer)
+END_METADATA
+
+CompactTabsView::CompactTabsView(TabStripModel* model, Side side)
+    : model_(model), side_(side) {
+  auto* const layout = SetLayoutManager(std::make_unique<views::FlexLayout>());
+  layout->SetOrientation(views::LayoutOrientation::kHorizontal)
+      .SetCrossAxisAlignment(views::LayoutAlignment::kCenter)
+      .SetCollapseMargins(true)
+      .SetDefault(views::kMarginsKey, gfx::Insets::VH(0, kChipGap / 2));
+  SetProperty(views::kMarginsKey, gfx::Insets::VH(0, kChipGap));
+  model_->AddObserver(this);
+  Update();
+}
+
+CompactTabsView::~CompactTabsView() = default;
+
+void CompactTabsView::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  Update();
+}
+
+void CompactTabsView::OnTabChangedAt(tabs::TabInterface* tab,
+                                     TabChangeType change_type) {
+  Update();
+}
+
+void CompactTabsView::Update() {
+  const int active = model_->active_index();
+  const int first = side_ == Side::kBeforeActive ? 0 : active + 1;
+  const int last =
+      side_ == Side::kBeforeActive ? std::max(active, 0) : model_->count();
+  const size_t wanted = active == TabStripModel::kNoTab
+                            ? 0
+                            : static_cast<size_t>(std::max(last - first, 0));
+  while (children().size() > wanted) {
+    RemoveChildViewT(children().back());
+  }
+  while (children().size() < wanted) {
+    AddChildView(std::make_unique<CompactTabChip>(model_));
+  }
+  for (size_t i = 0; i < wanted; ++i) {
+    static_cast<CompactTabChip*>(children()[i])
+        ->SetTab(first + static_cast<int>(i));
+  }
+  // The two sides share the space by tab: the toolbar takes from each what is
+  // over its smallest size, in proportion to the weight.
+  SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(base::BindRepeating(&SmallestUntilBounded,
+                                                    static_cast<int>(wanted)))
+          .WithOrder(kTabsFlexOrder)
+          .WithWeight(std::max(static_cast<int>(wanted), 1)));
+  SetVisible(wanted > 0);
+  InvalidateLayout();
+}
+
+BEGIN_METADATA(CompactTabsView)
+END_METADATA

# Windows: Cromite la supporta già; sopra i suoi argomenti cambiamo solo quello che serve
# alla build a tappe sui runner GitHub (4 core, 16 GB, 6 ore per tappa).
# ninja invece di siso: riprende una build interrotta guardando gli orari dei file.
use_siso = false
# niente simboli di debug: link molto più leggeri e cartella di build più piccola
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
# Compilando su Windows (Cromite lo fa da Linux) Chromium costruisce anche code_cache_generator.exe,
# che con la patch Content-settings-infrastructure di Cromite non si collega più: content_settings.cc
# chiama WebsiteSettingsRegistry, che sta in core/browser. Così le pagine interne restano come nelle
# release Windows di Cromite, senza il bytecode JS precompilato.
enable_webui_generate_code_cache = false

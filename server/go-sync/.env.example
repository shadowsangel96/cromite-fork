# Copia questo file in .env sul server, accanto a docker-compose.yml.
# Il file .env non va mai nel repo.

# La chiave pubblica (esadecimale) della propria catena di sync; più catene
# separate da virgole. "nessuna" = non entra nessuno: va bene finché la
# catena non esiste. Una catena rifiutata compare nel log del container
# "sync" come "client ID not allowed: <chiave>".
ALLOWED_CLIENT_IDS=nessuna

# Porta del server sul NAS (nel browser: http://<indirizzo del NAS>:<porta>/v2).
PORTA=8295

+	// Shannon: a private server serves only its own sync chain. When
+	// ALLOWED_CLIENT_IDS is set, every other client is refused, and its ID
+	// goes into the log so the owner can add a new chain on purpose.
+	if allowed := os.Getenv("ALLOWED_CLIENT_IDS"); allowed != "" {
+		allowedIDs := strings.Split(strings.ToLower(allowed), ",")
+		if !slices.Contains(allowedIDs, strings.ToLower(token.PublicKeyHex)) {
+			return "", fmt.Errorf("client ID not allowed: %s", strings.ToLower(token.PublicKeyHex))
+		}
+	}
+

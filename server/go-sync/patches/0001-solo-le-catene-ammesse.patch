+func (suite *AuthTestSuite) TestAllowedClientIDs() {
+	tkn, _, publicKeyHex, err := authtest.GenerateToken(time.Now().UnixMilli())
+	suite.Require().NoError(err)
+	other, _, _, err := authtest.GenerateToken(time.Now().UnixMilli())
+	suite.Require().NoError(err)
+
+	// Only the listed chain gets in, whatever the hex casing.
+	suite.T().Setenv("ALLOWED_CLIENT_IDS", "nessuna,"+strings.ToUpper(publicKeyHex))
+	id, err := auth.Authenticate(tkn)
+	suite.Require().NoError(err)
+	suite.Require().Equal(publicKeyHex, id)
+
+	id, err = auth.Authenticate(other)
+	suite.Require().Error(err, "a chain that is not listed must be refused")
+	suite.Require().Empty(id)
+
+	// A list with no real chain refuses everyone.
+	suite.T().Setenv("ALLOWED_CLIENT_IDS", "nessuna")
+	id, err = auth.Authenticate(tkn)
+	suite.Require().Error(err)
+	suite.Require().Empty(id)
+}

      <message name="IDS_FORK_UBLOCK_ADD_SITE" desc="Interface of the fork.">Add a site</message>
      <message name="IDS_FORK_UBLOCK_SITE_LABEL" desc="Interface of the fork.">Site to exclude</message>
      <message name="IDS_FORK_UBLOCK_SITE_PLACEHOLDER" desc="Interface of the fork.">example.org</message>

      <message name="IDS_FORK_FP_CAT_EVAL" desc="Interface of the fork.">eval</message>
      <message name="IDS_FORK_FP_CAT_REFERRER" desc="Interface of the fork.">Referrer</message>
      <message name="IDS_FORK_SITE_INFO_FP_ONE" desc="Interface of the fork.">Site information: 1 fingerprinting attempt blocked</message>
      <message name="IDS_FORK_SITE_INFO_FP_MANY" desc="Interface of the fork.">Site information: <ph name="COUNT">$1</ph> fingerprinting attempts blocked</message>
      <message name="IDS_FORK_PROFILO_LABEL" desc="Interface of the fork.">Profile</message>
      <message name="IDS_FORK_PROFILO_NOT_SIGNED_IN" desc="Interface of the fork.">You haven't signed in yet</message>
      <message name="IDS_FORK_PROFILO_INTRO" desc="Interface of the fork.">A single sign-in with your Claude account, for Claude in Chrome and your chats.</message>
      <message name="IDS_FORK_PROFILO_SIGN_IN" desc="Interface of the fork.">Sign in with Claude</message>
      <message name="IDS_FORK_PROFILO_ACCOUNT" desc="Interface of the fork.">Claude account</message>
      <message name="IDS_FORK_PROFILO_SIGNED_IN" desc="Interface of the fork.">Signed in on claude.ai</message>
      <message name="IDS_FORK_PROFILO_SIGN_OUT" desc="Interface of the fork.">Sign out</message>
      <message name="IDS_FORK_PROFILO_OTHERS" desc="Interface of the fork.">Other profiles and guest</message>
      <message name="IDS_FORK_AVATAR_CLAUDE_LINKED" desc="Interface of the fork.">Profile: Claude account linked</message>
      <message name="IDS_FORK_AVATAR_SIGN_IN" desc="Interface of the fork.">Profile: sign in with Claude</message>
      <message name="IDS_FORK_SETTINGS_COMPACT_TABS" desc="Interface of the fork.">Tabs in the toolbar</message>
      <message name="IDS_FORK_SETTINGS_COMPACT_TABS_SUB" desc="Interface of the fork.">Compact, like Safari. Applies to the windows you open afterwards.</message>
      <message name="IDS_FORK_UBLOCK_INTEGRATED" desc="Interface of the fork."><ph name="NAME">$1</ph>, built into the browser</message>
      <message name="IDS_FORK_UBLOCK_INTRO" desc="Interface of the fork.">Blocks ads, trackers and dangerous sites on every page. To turn it off on a single site, use the button to the right of the address.</message>
      <message name="IDS_FORK_UBLOCK_FILTER_COUNT" desc="Interface of the fork."><ph name="NETWORK">$1</ph> network filters and <ph name="COSMETIC">$2</ph> cosmetic filters in use.</message>
      <message name="IDS_FORK_UBLOCK_NO_ANSWER" desc="Interface of the fork.">uBlock Origin doesn't answer. Try again in a moment, or restart the browser.</message>
      <message name="IDS_FORK_UBLOCK_STARTING" desc="Interface of the fork.">uBlock Origin is starting…</message>
      <message name="IDS_FORK_UBLOCK_LISTS" desc="Interface of the fork.">Filter lists</message>
      <message name="IDS_FORK_UBLOCK_ACTIVE_OF" desc="Interface of the fork."><ph name="ON">$1</ph> active out of <ph name="TOTAL">$2</ph></message>
      <message name="IDS_FORK_UBLOCK_AUTO_UPDATE" desc="Interface of the fork.">Update the lists by themselves</message>
      <message name="IDS_FORK_UBLOCK_AUTO_UPDATE_SUB" desc="Interface of the fork.">Each list is downloaded again from its site when it expires.</message>
      <message name="IDS_FORK_UBLOCK_UPDATE_NOW" desc="Interface of the fork.">Update now</message>
      <message name="IDS_FORK_UBLOCK_UPDATING" desc="Interface of the fork.">Updating…</message>
      <message name="IDS_FORK_UBLOCK_LAST_UPDATE" desc="Interface of the fork.">Last updated <ph name="WHEN">$1</ph></message>
      <message name="IDS_FORK_UBLOCK_LIST_USED" desc="Interface of the fork."><ph name="USED">$1</ph> filters used out of <ph name="TOTAL">$2</ph></message>
      <message name="IDS_FORK_UBLOCK_LIST_UPDATED" desc="Interface of the fork.">updated <ph name="WHEN">$1</ph></message>
      <message name="IDS_FORK_UBLOCK_LIST_BUNDLED" desc="Interface of the fork.">copy included in uBlock Origin, to be updated</message>
      <message name="IDS_FORK_UBLOCK_REMOVE_LIST" desc="Interface of the fork.">Remove the list</message>
      <message name="IDS_FORK_UBLOCK_ADD_LIST" desc="Interface of the fork.">Add a list</message>
      <message name="IDS_FORK_UBLOCK_LIST_ADDRESS" desc="Interface of the fork.">Address of the list</message>
      <message name="IDS_FORK_UBLOCK_LIST_PLACEHOLDER" desc="Interface of the fork.">https://example.org/list.txt</message>
      <message name="IDS_FORK_UBLOCK_LISTS_APPLYING" desc="Interface of the fork.">Applying the lists…</message>
      <message name="IDS_FORK_UBLOCK_LISTS_APPLIED" desc="Interface of the fork.">Lists applied.</message>
      <message name="IDS_FORK_UBLOCK_LIST_BAD_URL" desc="Interface of the fork.">Write the full address of the list, with https://.</message>
      <message name="IDS_FORK_UBLOCK_GROUP_DEFAULT" desc="Interface of the fork.">Built in</message>
      <message name="IDS_FORK_UBLOCK_GROUP_ADS" desc="Interface of the fork.">Ads</message>
      <message name="IDS_FORK_UBLOCK_GROUP_PRIVACY" desc="Interface of the fork.">Privacy</message>
      <message name="IDS_FORK_UBLOCK_GROUP_MALWARE" desc="Interface of the fork.">Malware and dangerous sites</message>
      <message name="IDS_FORK_UBLOCK_GROUP_MULTIPURPOSE" desc="Interface of the fork.">Multipurpose</message>
      <message name="IDS_FORK_UBLOCK_GROUP_COOKIES" desc="Interface of the fork.">Cookie notices</message>
      <message name="IDS_FORK_UBLOCK_GROUP_SOCIAL" desc="Interface of the fork.">Social buttons</message>
      <message name="IDS_FORK_UBLOCK_GROUP_ANNOYANCES" desc="Interface of the fork.">Annoyances</message>
      <message name="IDS_FORK_UBLOCK_GROUP_REGIONS" desc="Interface of the fork.">Regions and languages</message>
      <message name="IDS_FORK_UBLOCK_GROUP_UNKNOWN" desc="Interface of the fork.">Other</message>
      <message name="IDS_FORK_UBLOCK_GROUP_CUSTOM" desc="Interface of the fork.">Added by you</message>
      <message name="IDS_FORK_UBLOCK_AGO_NOW" desc="Interface of the fork.">just now</message>
      <message name="IDS_FORK_UBLOCK_AGO_MINUTE" desc="Interface of the fork.">1 minute ago</message>
      <message name="IDS_FORK_UBLOCK_AGO_MINUTES" desc="Interface of the fork."><ph name="COUNT">$1</ph> minutes ago</message>
      <message name="IDS_FORK_UBLOCK_AGO_HOUR" desc="Interface of the fork.">1 hour ago</message>
      <message name="IDS_FORK_UBLOCK_AGO_HOURS" desc="Interface of the fork."><ph name="COUNT">$1</ph> hours ago</message>
      <message name="IDS_FORK_UBLOCK_AGO_YESTERDAY" desc="Interface of the fork.">yesterday</message>
      <message name="IDS_FORK_UBLOCK_AGO_DAYS" desc="Interface of the fork."><ph name="COUNT">$1</ph> days ago</message>
      <message name="IDS_FORK_UBLOCK_FILTERS" desc="Interface of the fork.">Personal filters</message>
      <message name="IDS_FORK_UBLOCK_USE_FILTERS" desc="Interface of the fork.">Use the personal filters</message>
      <message name="IDS_FORK_UBLOCK_FILTERS_HELP" desc="Interface of the fork.">One filter per line, in the <ph name="BEGIN_LINK">&lt;a href="https://github.com/gorhill/uBlock/wiki/Static-filter-syntax" target="_blank"&gt;</ph>syntax of uBlock Origin<ph name="END_LINK">&lt;/a&gt;</ph>. "Hide an element" adds them here too.</message>
      <message name="IDS_FORK_UBLOCK_FILTER_ONE" desc="Interface of the fork.">1 filter</message>
      <message name="IDS_FORK_UBLOCK_FILTER_MANY" desc="Interface of the fork."><ph name="COUNT">$1</ph> filters</message>
      <message name="IDS_FORK_UBLOCK_NOT_IN_USE" desc="Interface of the fork."><ph name="WHAT">$1</ph>, not in use</message>
      <message name="IDS_FORK_UBLOCK_SAVING" desc="Interface of the fork.">Saving…</message>
      <message name="IDS_FORK_UBLOCK_FILTERS_SAVED" desc="Personal filters were saved." meaning="ublockFiltersSaved">Saved.</message>
      <message name="IDS_FORK_UBLOCK_RULES" desc="Interface of the fork.">Rules</message>
      <message name="IDS_FORK_UBLOCK_RULES_HELP" desc="Interface of the fork.">Dynamic filtering rules, one per line: source site, destination site, request type and action (<ph name="BEGIN_LINK">&lt;a href="https://github.com/gorhill/uBlock/wiki/Dynamic-filtering:-rule-syntax" target="_blank"&gt;</ph>how to write them<ph name="END_LINK">&lt;/a&gt;</ph>). They apply right away and stay after a restart.</message>
      <message name="IDS_FORK_UBLOCK_RULE_ONE" desc="Interface of the fork.">1 rule</message>
      <message name="IDS_FORK_UBLOCK_RULE_MANY" desc="Interface of the fork."><ph name="COUNT">$1</ph> rules</message>
      <message name="IDS_FORK_UBLOCK_RULES_SAVED" desc="Rules were saved." meaning="ublockRulesSaved">Saved.</message>
      <message name="IDS_FORK_UBLOCK_RULES_REJECTED" desc="Interface of the fork.">Saved. Not valid, so removed: <ph name="LINES">$1</ph></message>
      <message name="IDS_FORK_UBLOCK_SITES" desc="Interface of the fork.">Excluded sites</message>
      <message name="IDS_FORK_UBLOCK_SITES_HELP" desc="Interface of the fork.">Nothing is blocked here. The power button in the "Content blocking" panel adds sites to this list and removes them.</message>
      <message name="IDS_FORK_UBLOCK_NO_SITES" desc="Interface of the fork.">No excluded sites</message>
      <message name="IDS_FORK_UBLOCK_SITES_NONE" desc="Interface of the fork." meaning="ublockSitesNone">None</message>
      <message name="IDS_FORK_UBLOCK_SITE_ONE" desc="Interface of the fork.">1 site</message>
      <message name="IDS_FORK_UBLOCK_SITE_MANY" desc="Interface of the fork."><ph name="COUNT">$1</ph> sites</message>

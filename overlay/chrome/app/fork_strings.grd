  <release seq="1" allow_pseudo="false">
    <messages fallback_to_english="true">
      <message name="IDS_FORK_CLOSE" desc="Interface of the fork.">Close</message>
      <message name="IDS_FORK_YES" desc="Interface of the fork.">Yes</message>
      <message name="IDS_FORK_NO" desc="Interface of the fork.">No</message>
      <message name="IDS_FORK_CANCEL" desc="Interface of the fork.">Cancel</message>
      <message name="IDS_FORK_SAVE" desc="Interface of the fork.">Save</message>
      <message name="IDS_FORK_ADD" desc="Interface of the fork.">Add</message>
      <message name="IDS_FORK_CONTENT_BLOCKING" desc="Interface of the fork.">Content blocking</message>
      <message name="IDS_FORK_YOUR_CHATS" desc="Interface of the fork.">Your chats</message>
      <message name="IDS_FORK_COOKIES_AND_SITE_DATA" desc="Interface of the fork.">Cookies and site data</message>
      <message name="IDS_FORK_BACK_TO_VPN" desc="Interface of the fork.">Back to the VPN</message>
      <message name="IDS_FORK_PROXY_PAGE_TITLE" desc="Interface of the fork.">Network and privacy</message>
      <message name="IDS_FORK_PROXY_VPN_TITLE" desc="Interface of the fork.">Personal VPN</message>
      <message name="IDS_FORK_PROXY_VPN_INTRO" desc="Interface of the fork.">Only the browser goes out through the VPN of your server. If the server doesn't answer, pages show an error: the browser never goes out directly without you knowing. Home networks and Tailscale stay outside the VPN, so the server itself can always be reached.</message>
      <message name="IDS_FORK_PROXY_VPN_ADDRESS" desc="Interface of the fork.">Proxy address</message>
      <message name="IDS_FORK_PROXY_ADDRESS_PLACEHOLDER" desc="Interface of the fork.">address:port</message>
      <message name="IDS_FORK_PROXY_URL_PLACEHOLDER" desc="Interface of the fork.">http://address:port</message>
      <message name="IDS_FORK_PROXY_VPN_CITY" desc="Interface of the fork.">Exit city</message>
      <message name="IDS_FORK_PROXY_VPN_CITY_PLACEHOLDER" desc="Interface of the fork.">Rome</message>
      <message name="IDS_FORK_PROXY_VPN_ON" desc="Interface of the fork.">Turn on</message>
      <message name="IDS_FORK_PROXY_VPN_OFF" desc="Interface of the fork.">Turn off</message>
      <message name="IDS_FORK_PROXY_DIRECT_TITLE" desc="Interface of the fork.">Sites that go out directly</message>
      <message name="IDS_FORK_PROXY_DIRECT_INTRO" desc="Interface of the fork.">One per line: banks and services that block VPN addresses. These sites see the IP address of your home.</message>
      <message name="IDS_FORK_PROXY_SAVE_LIST" desc="Interface of the fork.">Save the list</message>
      <message name="IDS_FORK_PROXY_SEARCH_TITLE" desc="Interface of the fork.">Personal search engine</message>
      <message name="IDS_FORK_PROXY_SEARCH_INTRO" desc="Interface of the fork.">Searches from the address bar go to your SearXNG. If it doesn't answer within a few seconds, that search moves to DuckDuckGo Light by itself.</message>
      <message name="IDS_FORK_PROXY_SEARCH_ADDRESS" desc="Interface of the fork.">SearXNG address</message>
      <message name="IDS_FORK_PROXY_SEARCH_USE" desc="Interface of the fork.">Use</message>
      <message name="IDS_FORK_PROXY_SEARCH_REMOVE" desc="Interface of the fork.">Remove</message>
      <message name="IDS_FORK_PROXY_TRACKERS_TITLE" desc="Interface of the fork.">Sites that track</message>
      <message name="IDS_FORK_PROXY_TRACKERS_INTRO" desc="Interface of the fork.">When you open these sites, the browser goes by itself to their version that doesn't track you, from shared links too. From the site panel (the shield in the address bar) you go back to the original when you need it.</message>
      <message name="IDS_FORK_PROXY_REDIRECT_YOUTUBE" desc="After the bold word YouTube.">on your Invidious, videos inside other sites too</message>
      <message name="IDS_FORK_PROXY_INVIDIOUS_HOME" desc="Interface of the fork.">Home address</message>
      <message name="IDS_FORK_PROXY_INVIDIOUS_REMOTE" desc="Interface of the fork.">Away from home (Tailscale)</message>
      <message name="IDS_FORK_PROXY_REDIRECT_INSTAGRAM" desc="After the bold word Instagram.">on imginn</message>
      <message name="IDS_FORK_PROXY_REDIRECT_TIKTOK" desc="After the bold word TikTok.">on urlebird. A video opens the page of its author: urlebird puts the words of the description in the address of the video, and the TikTok link doesn't have them.</message>
      <message name="IDS_FORK_PROXY_COOKIE_TEMP_NAME" desc="Interface of the fork.">Temporary:</message>
      <message name="IDS_FORK_PROXY_COOKIE_TEMP" desc="Interface of the fork.">the data of a site lasts for the visit and is deleted as soon as you leave it.</message>
      <message name="IDS_FORK_PROXY_COOKIE_NORMAL_NAME" desc="Interface of the fork.">Normal:</message>
      <message name="IDS_FORK_PROXY_COOKIE_NORMAL" desc="Interface of the fork.">as in Chrome, with the cookies of each site kept apart.</message>
      <message name="IDS_FORK_PROXY_COOKIE_BLOCK_NAME" desc="Interface of the fork.">Block all:</message>
      <message name="IDS_FORK_PROXY_COOKIE_BLOCK" desc="Interface of the fork.">no site saves data, sign-ins don't work. Only the sites to remember can.</message>
      <message name="IDS_FORK_PROXY_REMEMBERED_TITLE" desc="Interface of the fork.">Sites to remember</message>
      <message name="IDS_FORK_PROXY_REMEMBERED_INTRO" desc="Interface of the fork.">One per line. Here you stay signed in: their data is never deleted.</message>
      <message name="IDS_FORK_PROXY_CLAUDE_BLOCKED_TITLE" desc="Interface of the fork.">Claude doesn't enter these sites</message>
      <message name="IDS_FORK_PROXY_CLAUDE_BLOCKED_INTRO" desc="Interface of the fork.">One per line, for example banks and health care. Claude in Chrome can't read or use them.</message>
      <message name="IDS_FORK_PROXY_VPN_RESERVE" desc="Interface of the fork.">Direct reserve connection: your IP is visible.</message>
      <message name="IDS_FORK_PROXY_VPN_ACTIVE" desc="Interface of the fork.">On: the browser goes out through <ph name="ADDRESS">$1</ph>.</message>
      <message name="IDS_FORK_PROXY_VPN_INACTIVE" desc="Interface of the fork.">Off: the browser goes out through the normal connection.</message>
      <message name="IDS_FORK_PROXY_VPN_NEED_ADDRESS" desc="Interface of the fork.">Write the proxy address first.</message>
      <message name="IDS_FORK_PROXY_CHECKING" desc="Interface of the fork.">Checking the addresses…</message>
      <message name="IDS_FORK_PROXY_INVIDIOUS_NO_ADDRESS" desc="Interface of the fork.">Without an address, YouTube stays as it is.</message>
      <message name="IDS_FORK_PROXY_INVIDIOUS_OFF" desc="Interface of the fork.">Off: YouTube stays as it is.</message>
      <message name="IDS_FORK_PROXY_INVIDIOUS_RESTART" desc="Interface of the fork.">Videos inside other sites move to Invidious from the next start of the browser.</message>
      <message name="IDS_FORK_PROXY_INVIDIOUS_HOME_ANSWERS" desc="Interface of the fork.">The home one answers: YouTube opens there.</message>
      <message name="IDS_FORK_PROXY_INVIDIOUS_REMOTE_ANSWERS" desc="Interface of the fork.">The Tailscale one answers: YouTube opens there.</message>
      <message name="IDS_FORK_PROXY_INVIDIOUS_NONE" desc="Interface of the fork.">Neither one answers, or it isn't Invidious: YouTube shows an error until you open it yourself from the page.</message>
      <message name="IDS_FORK_PROXY_LIST_SAVED" desc="Interface of the fork.">List saved: <ph name="COUNT">$1</ph> sites.</message>
      <message name="IDS_FORK_PROXY_CLAUDE_LIST_SAVED" desc="Interface of the fork.">List saved: <ph name="COUNT">$1</ph> sites. It applies to new tabs: close the ones already open on these sites.</message>
      <message name="IDS_FORK_PROXY_SEARCH_ACTIVE" desc="Interface of the fork.">On: searches go to <ph name="ADDRESS">$1</ph>.</message>
      <message name="IDS_FORK_PROXY_SEARCH_INACTIVE" desc="Interface of the fork.">Off: searches go to the default engine.</message>
      <message name="IDS_FORK_PERSONAL_SEARCH_NAME" desc="Name of the user&#x27;s own search engine in the list of engines.">Personal SearXNG</message>
      <message name="IDS_FORK_SITE_PANEL_LABEL" desc="Interface of the fork.">Site information</message>
      <message name="IDS_FORK_SITE_PANEL_HOW_ANSWERS" desc="Interface of the fork.">How the browser answers</message>
      <message name="IDS_FORK_SITE_PANEL_NO_READING" desc="Interface of the fork.">Nothing read yet</message>
      <message name="IDS_FORK_SITE_PANEL_CANVAS_CAPTION" desc="Interface of the fork.">Canvas · as the site received it</message>
      <message name="IDS_FORK_SITE_PANEL_WEBGL_BLOCKED" desc="Interface of the fork.">WebGL blocked</message>
      <message name="IDS_FORK_SITE_PANEL_WEBGL_NO_IMAGE" desc="Interface of the fork.">WebGL · no image</message>
      <message name="IDS_FORK_SITE_PANEL_WEBGL_CAPTION" desc="Interface of the fork.">WebGL · as the site received it</message>
      <message name="IDS_FORK_SITE_PANEL_REMEMBER" desc="Interface of the fork.">Remember this site</message>
      <message name="IDS_FORK_SITE_PANEL_BLOCKED" desc="Interface of the fork.">Trackers and ads blocked</message>
      <message name="IDS_FORK_SITE_PANEL_PERMISSIONS" desc="Interface of the fork." meaning="sitePanelPermissions">Permissions</message>
      <message name="IDS_FORK_SITE_PANEL_ROUTE_VPN" desc="Interface of the fork.">Going out through the personal VPN</message>
      <message name="IDS_FORK_SITE_PANEL_ROUTE_VPN_CITY" desc="Interface of the fork.">Going out through the personal VPN (<ph name="CITY">$1</ph>)</message>
      <message name="IDS_FORK_SITE_PANEL_ROUTE_DOWN" desc="Interface of the fork.">The VPN server doesn't answer: no page goes out directly</message>
      <message name="IDS_FORK_SITE_PANEL_ROUTE_DIRECT" desc="Interface of the fork.">Direct connection: sites see the IP of your home</message>
      <message name="IDS_FORK_SITE_PANEL_ROUTE_OFF" desc="Interface of the fork.">VPN off: you go out through the normal connection</message>
      <message name="IDS_FORK_SITE_PANEL_NOT_USED" desc="A fingerprinting category the page didn&#x27;t read.">Not used</message>
      <message name="IDS_FORK_SITE_PANEL_FP_ONE" desc="Interface of the fork.">1 attempt blocked</message>
      <message name="IDS_FORK_SITE_PANEL_FP_MANY" desc="Interface of the fork."><ph name="COUNT">$1</ph> attempts blocked</message>
      <message name="IDS_FORK_SITE_PANEL_FP_NONE" desc="Interface of the fork.">No attempts</message>
      <message name="IDS_FORK_SITE_PANEL_FP_HINT_USED" desc="Interface of the fork.">The site tried to read these APIs. Here is what the browser answered.</message>
      <message name="IDS_FORK_SITE_PANEL_FP_HINT_NONE" desc="Interface of the fork.">So far the site hasn't read any of these APIs.</message>
      <message name="IDS_FORK_SITE_PANEL_SHOW_USED" desc="Interface of the fork.">Show only the ones used</message>
      <message name="IDS_FORK_SITE_PANEL_SHOW_ALL" desc="Interface of the fork.">Show all <ph name="COUNT">$1</ph> categories</message>
      <message name="IDS_FORK_SITE_PANEL_OPENED_ON" desc="Interface of the fork.">Opened on <ph name="RESPECTFUL">$1</ph> instead of <ph name="SERVICE">$2</ph></message>
      <message name="IDS_FORK_SITE_PANEL_ORIGINAL_OF" desc="Interface of the fork.">Original page of <ph name="SERVICE">$1</ph></message>
      <message name="IDS_FORK_SITE_PANEL_OPEN_ORIGINAL" desc="Interface of the fork.">Open the original</message>
      <message name="IDS_FORK_SITE_PANEL_OPEN_ON" desc="Interface of the fork.">Open on <ph name="RESPECTFUL">$1</ph></message>
      <message name="IDS_FORK_SITE_PANEL_REDIRECT_SWITCH" desc="Interface of the fork.">Redirect <ph name="SERVICE">$1</ph></message>
      <message name="IDS_FORK_SITE_PANEL_TO_SET_UP" desc="Interface of the fork.">To set up</message>
      <message name="IDS_FORK_SITE_PANEL_SECURE" desc="Interface of the fork.">Connection is secure</message>
      <message name="IDS_FORK_SITE_PANEL_NOT_SECURE" desc="Interface of the fork.">Connection is not secure</message>
      <message name="IDS_FORK_SITE_PANEL_BLOCK_WEBGL_AGAIN" desc="Interface of the fork.">Block WebGL on this site again</message>
      <message name="IDS_FORK_SITE_PANEL_ALLOW_WEBGL" desc="Interface of the fork.">Allow WebGL on this site (randomized)</message>
      <message name="IDS_FORK_SITE_PANEL_COOKIES_IN_USE" desc="Interface of the fork."><ph name="COUNT">$1</ph> in use</message>
      <message name="IDS_FORK_SITE_PANEL_NO_COOKIES" desc="Interface of the fork." meaning="sitePanelNoCookies">None</message>
      <message name="IDS_FORK_SITE_PANEL_NO_PERMISSIONS" desc="Interface of the fork." meaning="sitePanelNoPermissions">None</message>
      <message name="IDS_FORK_FP_RANDOMIZED" desc="Interface of the fork.">Randomized</message>
      <message name="IDS_FORK_FP_BLOCKED" desc="Interface of the fork.">Blocked</message>
      <message name="IDS_FORK_FP_UNIFORM" desc="Interface of the fork.">Uniform</message>
      <message name="IDS_FORK_FP_LIMITED" desc="Interface of the fork.">Limited</message>
      <message name="IDS_FORK_FP_ALLOWED" desc="Interface of the fork.">Allowed</message>
      <message name="IDS_FORK_FP_NOT_COUNTED" desc="Interface of the fork.">Not counted</message>
      <message name="IDS_FORK_FP_CAT_CANVAS" desc="Interface of the fork.">Canvas</message>
      <message name="IDS_FORK_FP_CAT_WEBGL" desc="Interface of the fork.">WebGL</message>
      <message name="IDS_FORK_FP_CAT_AUDIO" desc="Interface of the fork.">Audio</message>
      <message name="IDS_FORK_FP_CAT_FONTS" desc="Interface of the fork.">Fonts</message>
      <message name="IDS_FORK_FP_CAT_SCREEN" desc="Interface of the fork.">Screen</message>
      <message name="IDS_FORK_FP_CAT_NAVIGATOR" desc="Interface of the fork.">Navigator and Client Hints</message>
      <message name="IDS_FORK_FP_CAT_WEBGPU" desc="Interface of the fork.">WebGPU</message>
      <message name="IDS_FORK_FP_CAT_CLIENT_RECTS" desc="Interface of the fork.">ClientRects</message>

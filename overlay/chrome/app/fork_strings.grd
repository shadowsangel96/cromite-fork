      <message name="IDS_FORK_FP_CAT_STORAGE" desc="Interface of the fork.">Storage</message>
      <message name="IDS_FORK_FP_CAT_PERMISSIONS" desc="Interface of the fork." meaning="fpCatPermissions">Permissions</message>
